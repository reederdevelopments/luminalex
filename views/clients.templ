                                    <option value="Divorced" class="bg-[#0b1d2e] text-[#f9f8f6]" ${c.marital_status==='Divorced'?'selected':''}>Divorced</option>
                                    <option value="Widowed" class="bg-[#0b1d2e] text-[#f9f8f6]" ${c.marital_status==='Widowed'?'selected':''}>Widowed</option>
