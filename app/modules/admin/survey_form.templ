
package admin

import (
	"maoni/app/core/auth"
	"maoni/app/core/survey"
	"maoni/app/core/web"
	"time"
)

func formatDateTimeForInput(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	return t.In(web.GMTPlus2).Format("2006-01-02T15:04")
}

templ surveyFormPage(user auth.User, s survey.Survey, pageTitle, formAction string, categories []survey.Category) {
	@adminLayout(user, pageTitle, surveyForm(s, pageTitle, formAction, categories))
}

templ surveyForm(s survey.Survey, pageTitle, formAction string, categories []survey.Category) {
	<form action={ templ.URL(formAction) } method="POST" class="bg-white p-6 rounded-lg shadow">
		<input type="hidden" name="Type" value={ survey.TypeSpecial }/>
		<div class="space-y-8 divide-y divide-gray-200">
			<div>
				<div>
					<h2 class="text-2xl font-semibold leading-7 text-gray-900">{ pageTitle }</h2>
					<p class="mt-1 text-sm leading-6 text-gray-600">This information will be displayed publicly so be careful what you share.</p>
				</div>
				<div class="mt-6 grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
					<div class="sm:col-span-3">
						<label for="name" class="block text-sm font-medium leading-6 text-gray-900">Survey Name</label>
						<div class="mt-2">
							<input type="text" name="Name" id="name" value={ s.Name } required class="block w-full rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm"/>
						</div>
					</div>
					<div class="sm:col-span-3">
						<label for="category" class="block text-sm font-medium leading-6 text-gray-900">Category</label>
						<div class="mt-2">
							<select id="category" name="CategoryID" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm">
								<option value="">-- No Category --</option>
								for _, cat := range categories {
									<option value={ cat.ID } selected?={ s.CategoryID == cat.ID }>{ cat.Name }</option>
								}
							</select>
						</div>
					</div>
					<div class="col-span-full">
						<label for="description" class="block text-sm font-medium leading-6 text-gray-900">Description</label>
						<div class="mt-2">
							<textarea id="description" name="Description" rows="3" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm">{ s.Description }</textarea>
						</div>
						<p class="mt-3 text-sm leading-6 text-gray-600">Write a few sentences about the survey.</p>
					</div>
					<div class="col-span-full">
						<label for="banner" class="block text-sm font-medium leading-6 text-gray-900">Banner Image URL</label>
						<div class="mt-2">
							<input type="url" name="Banner" id="banner" value={ s.Banner } class="block w-full rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm"/>
						</div>
						<p class="mt-3 text-sm leading-6 text-gray-600">Optional: Provide a URL for an image to display at the top of the survey.</p>
					</div>
					<div class="sm:col-span-3">
						<label for="survey_open" class="block text-sm font-medium leading-6 text-gray-900">Survey Open Date</label>
						<div class="mt-2">
							<input type="datetime-local" name="SurveyOpen" id="survey_open" value={ formatDateTimeForInput(s.SurveyOpen) } class="block w-full rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm"/>
						</div>
					</div>
					<div class="sm:col-span-3">
						<label for="survey_closed" class="block text-sm font-medium leading-6 text-gray-900">Survey Close Date</label>
						<div class="mt-2">
							<input type="datetime-local" name="SurveyClosed" id="survey_closed" value={ formatDateTimeForInput(s.SurveyClosed) } class="block w-full rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm"/>
						</div>
					</div>
				</div>
				<div class="mt-6 space-y-6">
					<div class="relative flex gap-x-3">
						<div class="flex h-6 items-center">
							<input id="is-enabled" name="IsEnabled" type="checkbox" value="true" class="h-4 w-4 rounded border-gray-300 text-green-x-dark focus:ring-green-x-dark" checked?={ s.IsEnabled }/>
						</div>
						<div class="text-sm leading-6">
							<label for="is-enabled" class="font-medium text-gray-900">Enable Survey</label>
							<p class="text-gray-500">Make this survey visible and available for users to complete.</p>
						</div>
					</div>
				</div>
			</div>
			<div class="pt-8">
				<div>
					<h3 class="text-lg font-semibold leading-6 text-gray-900">Group Headings</h3>
					<p class="mt-1 text-sm text-gray-600">Define headings for your question groups. Group 1 corresponds to the first heading, Group 2 to the second, and so on. The heading can contain HTML markup.</p>
				</div>
				<div id="group-headings-container" class="mt-6 space-y-4">
					if len(s.GroupHeadings) > 0 {
						for i, heading := range s.GroupHeadings {
							@groupHeadingInput(heading, i)
						}
					} else {
						// Add one by default for a new survey
						@groupHeadingInput("", 0)
					}
				</div>
				<div class="mt-6">
					<button
						id="add-group-heading-btn"
						type="button"
						class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
						hx-get="/admin/surveys/partials/group-heading"
						hx-swap="beforeend"
						hx-target="#group-headings-container"
					>
						Add Group Heading
					</button>
				</div>
			</div>
			<div class="pt-8">
				<div>
					<h3 class="text-lg font-semibold leading-6 text-gray-900">Questions</h3>
					<p class="mt-1 text-sm text-gray-600">Add questions to your survey.</p>
				</div>
				<div id="questions-container" class="mt-6 space-y-6">
					for i, q := range s.Questions {
						@questionForm(q, i)
					}
				</div>
				<div class="mt-6">
					<button
						id="add-question-btn"
						type="button"
						class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
						hx-get="/admin/surveys/partials/question"
						hx-swap="beforeend"
						hx-target="#questions-container"
					>
						Add Question
					</button>
				</div>
			</div>
		</div>
		<div class="mt-6 flex items-center justify-end gap-x-6">
			<button type="submit" formaction="/admin/surveys/preview" formtarget="_blank" formnovalidate class="text-sm font-semibold leading-6 text-gray-900">Preview</button>
			<a href="/admin/surveys" class="text-sm font-semibold leading-6 text-gray-900">Cancel</a>
			<button type="submit" class="rounded-md bg-green-x-light px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-x-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-x-light">Save</button>
		</div>
	</form>
	<script src="/assets/scripts/survey_form.js" type="module"></script>
}
