
package admin

import (
	"fmt"
	"maoni/app/core/auth"
	"maoni/app/core/survey"
	"maoni/app/core/ui/icon"
)

templ specialSurveyDetailsPage(user auth.User, s survey.Survey, users []survey.SpecialSurveyUser) {
	@adminLayout(user, "Manage Special Survey", specialSurveyDetails(s, users))
}

templ specialSurveyDetails(s survey.Survey, users []survey.SpecialSurveyUser) {
	<div class="bg-white p-6 rounded-lg shadow">
		<div class="md:flex md:items-center md:justify-between">
			<div class="min-w-0 flex-1">
				<h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">Manage Users for "{ s.Name }"</h2>
			</div>
		</div>
		<div class="mt-4 flex">
			<a href="/admin/special" class="inline-flex items-center gap-x-2 rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
				@icon.ChevronLeft()
				Back to Special Surveys
			</a>
		</div>
		// Add User Forms
		<div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
			// Single User Form
			<div class="p-6 rounded-lg border border-gray-200">
				<h3 class="text-lg font-medium leading-6 text-gray-900">Add Single User</h3>
				<form action={ templ.URL(fmt.Sprintf("/admin/special/%s/add", s.ID)) } method="POST" class="mt-6 space-y-4">
					<div>
						<label for="user_email" class="block text-sm font-medium text-gray-700">User Email</label>
						<input type="email" name="user_email" id="user_email" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm"/>
					</div>
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						for i := 1; i <= 5; i++ {
							<div>
								<label for={ fmt.Sprintf("variable_%d", i) } class="block text-sm font-medium text-gray-700">{ fmt.Sprintf("Variable %d", i) }</label>
								<input type="text" name={ fmt.Sprintf("variable_%d", i) } id={ fmt.Sprintf("variable_%d", i) } class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm"/>
							</div>
						}
					</div>
					<div class="flex justify-end">
						<button type="submit" class="rounded-md bg-green-x-light px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-x-dark">Add User</button>
					</div>
				</form>
			</div>
			// CSV Upload Form
			<div class="p-6 rounded-lg border border-gray-200">
				<h3 class="text-lg font-medium leading-6 text-gray-900">Bulk Upload Users via CSV</h3>
				<form action={ templ.URL(fmt.Sprintf("/admin/special/%s/upload", s.ID)) } method="POST" enctype="multipart/form-data" class="mt-6 space-y-4">
					<div>
						<label for="csv_file" class="block text-sm font-medium text-gray-700">CSV File</label>
						<input type="file" name="csv_file" id="csv_file" required accept=".csv" class="mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-green-x-light file:text-white hover:file:bg-green-x-dark"/>
						<p class="mt-2 text-xs text-gray-500">CSV format: email, variable_1, variable_2, variable_3, variable_4, variable_5 (with header row).</p>
					</div>
					<div class="flex justify-end">
						<button type="submit" class="rounded-md bg-green-x-light px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-x-dark">Upload CSV</button>
					</div>
				</form>
			</div>
		</div>
		// Assigned Users Table
		<div class="mt-8">
			<h3 class="text-lg font-medium leading-6 text-gray-900">Assigned Users ({ fmt.Sprintf("%d", len(users)) })</h3>
			<div class="mt-2">
				<input type="text" id="user-filter" placeholder="Filter by email..." class="block w-full sm:w-1/3 rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm"/>
			</div>
		</div>
		<div class="mt-4 flow-root">
			<div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
				<div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
					if len(users) == 0 {
						<div class="flex h-48 items-center justify-center rounded-lg border-4 border-dashed border-gray-200 p-4">
							<p class="text-center text-gray-500">No users have been assigned to this survey yet.</p>
						</div>
					} else {
						<table id="users-table" class="min-w-full divide-y divide-gray-300">
							<thead>
								<tr>
									<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">Email</th>
									<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Var 1</th>
									<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Var 2</th>
									<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Var 3</th>
									<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Var 4</th>
									<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Var 5</th>
									<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-gray-200">
								for _, u := range users {
									<tr>
										<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-gray-500 sm:pl-0">{ u.UserEmail }</td>
										<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{ u.Variable1 }</td>
										<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{ u.Variable2 }</td>
										<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{ u.Variable3 }</td>
										<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{ u.Variable4 }</td>
										<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{ u.Variable5 }</td>
										<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
											if u.ResponseID != "" {
												<span class="inline-flex items-center rounded-full bg-green-x-light px-2 py-1 text-xs font-medium text-white">Submitted</span>
											} else {
												<span class="inline-flex items-center rounded-full bg-gray-200 px-2 py-1 text-xs font-medium text-gray-700">Pending</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			</div>
		</div>
	</div>
	<script>
		document.getElementById('user-filter').addEventListener('keyup', function() {
			var filterValue = this.value.toLowerCase();
			var rows = document.querySelectorAll('#users-table tbody tr');
			rows.forEach(function(row) {
				var emailCell = row.querySelector('td:first-child');
				if (emailCell) {
					if (emailCell.textContent.toLowerCase().includes(filterValue)) {
						row.style.display = '';
					} else {
						row.style.display = 'none';
					}
				}
			});
		});
	</script>
}
