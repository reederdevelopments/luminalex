
package admin

import (
	"fmt"
	"maoni/app/core/auth"
	"maoni/app/core/survey"
	"maoni/app/core/ui/icon"
	"maoni/app/core/web"
	"net/http"
	"time"
)

type surveyView struct {
	survey.Survey
	CategoryName string
}

type surveysPageData struct {
	Surveys      []surveyView
	ShowInactive bool
}

type resultsPageData struct {
	Surveys    []survey.Survey
	NameFilter string
}

func formatSurveyDate(t time.Time) string {
	if t.IsZero() {
		return "Not set"
	}
	return t.In(web.GMTPlus2).Format("2006-01-02 15:04")
}

func getSurveyStatus(s survey.Survey) (string, string) {
	now := web.Now()
	if !s.IsEnabled {
		return "Disabled", "bg-red-x-light"
	}
	if !s.SurveyOpen.IsZero() && now.Before(s.SurveyOpen) {
		return "Scheduled", "bg-gray-500"
	}
	if !s.SurveyClosed.IsZero() && now.After(s.SurveyClosed) {
		return "Expired", "bg-red-x-dark"
	}
	return "Active", "bg-green-x-light"
}

templ adminPage(r *http.Request, user auth.User, pageTitle string, data any) {
	@adminLayout(user, pageTitle, content(r, pageTitle, data))
}

templ content(r *http.Request, pageTitle string, data any) {
	@Tabs(r, adminTabs(r)) {
		switch v := data.(type) {
			case surveysPageData:
				@surveysContent(v)
			case resultsPageData:
				@resultsContent(v)
			case nil:
				@configContent()
		}
	}
}

templ surveysContent(data surveysPageData) {
	<div>
		<div class="sm:flex sm:items-center">
			<div class="sm:flex-auto">
				<h1 class="text-base font-semibold leading-6 text-gray-900">Surveys</h1>
				<p class="mt-2 text-sm text-gray-700">A list of all surveys, which are targeted at specific users.</p>
			</div>
			<div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
				<a href="/admin/surveys/add" class="inline-flex items-center gap-x-2 rounded-md bg-green-x-light px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-green-x-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-x-light">
					@icon.Plus()
					Add New Survey
				</a>
			</div>
		</div>

		<div class="mt-4 flex justify-end">
			<div class="flex items-center gap-2">
				<label for="show-inactive" class="text-sm font-medium text-gray-700">Show Inactive Surveys</label>
				if data.ShowInactive {
					<a id="show-inactive" href="/admin/surveys" class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-green-x-dark transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-green-x-dark focus:ring-offset-2">
						<span class="inline-block h-5 w-5 translate-x-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"></span>
					</a>
				} else {
					<a id="show-inactive" href="/admin/surveys?show_inactive=true" class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-gray-200 transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-green-x-dark focus:ring-offset-2">
						<span class="inline-block h-5 w-5 translate-x-0 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"></span>
					</a>
				}
			</div>
		</div>

		<div class="mt-8 flow-root">
			<div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
				<div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
					if len(data.Surveys) == 0 {
						<div class="flex h-96 items-center justify-center rounded-lg border-4 border-dashed border-gray-200 p-4">
							<p class="text-center text-gray-500">No surveys found. Create one to get started!</p>
						</div>
					} else {
						<table class="min-w-full divide-y divide-gray-300">
							<thead>
								<tr>
									<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">Name</th>
									<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Category</th>
									<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Open</th>
									<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Closed</th>
									<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
									<th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0">
										<span class="sr-only">Actions</span>
									</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-gray-200">
								for _, s := range data.Surveys {
									// FIX: Use 'if' with initialization to handle multi-value returns
									if status, statusColor := getSurveyStatus(s.Survey); true {
										<tr>
											<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-0">
												{ s.Name }
												<div class="text-gray-500 font-normal">{ s.Description }</div>
											</td>
											<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{ s.CategoryName }</td>
											<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{ formatSurveyDate(s.SurveyOpen) }</td>
											<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{ formatSurveyDate(s.SurveyClosed) }</td>
											<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
												<form action={ templ.URL(fmt.Sprintf("/admin/surveys/%s/toggle", s.ID)) } method="post" title="Click to toggle Enabled/Disabled state">
													// FIX: Use + for string concatenation
													<button type="submit" class={ "px-2 py-1 rounded-full text-xs font-medium text-white " + statusColor }>
														{ status }
													</button>
												</form>
											</td>
											<td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-0 space-x-4">
												<a href={ templ.URL(fmt.Sprintf("/admin/surveys/%s/users", s.ID)) } class="text-green-x-dark hover:text-green-x-dark">Manage Recipients</a>
												<a href={ templ.URL(fmt.Sprintf("/admin/surveys/%s/edit", s.ID)) } class="text-green-x-dark hover:text-green-x-dark">Edit<span class="sr-only">, { s.Name }</span></a>
											</td>
										</tr>
									}
								}
							</tbody>
						</table>
					}
				</div>
			</div>
		</div>
	</div>
}

templ resultsContent(data resultsPageData) {
	<div>
		<div class="sm:flex sm:items-center">
			<div class="sm:flex-auto">
				<h1 class="text-base font-semibold leading-6 text-gray-900">Results</h1>
				<p class="mt-2 text-sm text-gray-700">View and analyze the responses from your surveys.</p>
			</div>
		</div>
		<form method="GET" action="/admin/results" class="mt-6 p-4 rounded-lg border border-gray-200">
			<div class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-4">
				<div class="sm:col-span-3">
					<label for="name" class="block text-sm font-medium text-gray-700">Filter by Name</label>
					<input type="text" name="name" id="name" value={ data.NameFilter } class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm"/>
				</div>
				<div class="sm:col-span-1 flex items-end">
					<button type="submit" class="rounded-md bg-green-x-light px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-x-dark">Filter</button>
				</div>
			</div>
		</form>
		<div class="mt-8 flow-root">
			<div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
				<div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
					if len(data.Surveys) == 0 {
						<div class="flex h-96 items-center justify-center rounded-lg border-4 border-dashed border-gray-200 p-4">
							<p class="text-center text-gray-500">No surveys found matching your criteria.</p>
						</div>
					} else {
						<div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
							<table class="min-w-full divide-y divide-gray-300">
								<thead class="bg-gray-50">
									<tr>
										<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Name</th>
										<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Sent</th>
										<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Responses</th>
										<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">% Completed</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-gray-200 bg-white">
									for _, s := range data.Surveys {
										<tr>
											<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">{ s.Name }</td>
											<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{ fmt.Sprintf("%d", s.AssignedUserCount) }</td>
											<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{ fmt.Sprintf("%d", s.ResponseCount) }</td>
											<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
												if s.AssignedUserCount > 0 {
													{ fmt.Sprintf("%.0f%%", (float64(s.ResponseCount)/float64(s.AssignedUserCount))*100) }
												} else {
													N/A
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
}

templ configContent() {
	<div>
		<div class="sm:flex sm:items-center">
			<div class="sm:flex-auto">
				<h1 class="text-base font-semibold leading-6 text-gray-900">Configuration</h1>
				<p class="mt-2 text-sm text-gray-700">Manage application-wide settings.</p>
			</div>
		</div>
		<div class="mt-8">
			<button
				type="button"
				class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
				hx-get="/admin/config/categories-modal"
				hx-target="body"
				hx-swap="beforeend"
			>
				Manage Categories
			</button>
		</div>
	</div>
}
