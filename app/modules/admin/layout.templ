
package admin

import "maoni/app/core/auth"
import "maoni/app/core/ui/layout"

templ adminLayout(user auth.User, pageTitle string, children templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{"Community Feedback Admin - " + pageTitle}</title>
			<link rel="stylesheet" href="/assets/styles/main.css"/>
			<link rel="icon" type="image/svg+xml" href="/assets/img/unifi_logo.svg"/>
			<script src="https://unpkg.com/htmx.org@1.9.12" integrity="sha384-ujb1lZYygJmzgSwoxRggbCHcjc0rB2XoQrxeTUQyRjrOnlCoYta87iKBWq3EsdM2" crossorigin="anonymous"></script>
		</head>
		<body class="h-full">
			<div class="min-h-full">
				<header class="header-background shadow-sm">
					<div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
						<div class="flex items-center justify-between">
							<div class="flex items-center gap-4">
								<a href="/admin" class="flex items-center gap-2 text-white">
									<img src="/assets/img/logo.png" class="h-8 w-auto"/>
									<span class="text-lg font-semibold leading-6">Community Feedback Admin</span>
								</a>
							</div>
							<div class="flex items-center gap-4">
								<span class="hidden sm:inline text-sm text-gray-200">Hello, { user.FirstName }</span>
								<a href="/" class="text-sm font-medium text-white hover:text-gray-200">Home</a>
								if user.IsAdmin {
									<a href="/admin" class="text-sm font-medium text-white hover:text-gray-200">Admin</a>
								}
								<a href="/logout" class="text-sm font-medium text-gray-200 hover:text-white">Logout</a>
							</div>
						</div>
					</div>
				</header>
				<main class="py-10">
					<div class="mx-auto max-w-8xl sm:px-6 lg:px-8">
						@children
					</div>
				</main>
			</div>
			@layout.PageRefreshEvents()
			<div id="toast-container" class="fixed bottom-5 right-5 z-50 space-y-2"></div>
			<script>
				document.body.addEventListener('htmx:afterRequest', function(evt) {
					const message = evt.detail.xhr.getResponseHeader("X-Message");
					if (message) {
						const toastContainer = document.getElementById('toast-container');
						const toast = document.createElement('div');
						toast.className = 'bg-green-x-light text-white px-4 py-2 rounded-md shadow-lg';
						toast.innerText = message;
						toastContainer.appendChild(toast);
						setTimeout(() => {
							toast.style.transition = 'opacity 0.5s ease-out';
							toast.style.opacity = '0';
							setTimeout(() => toast.remove(), 500);
						}, 3000);
					}
				});
			</script>
		</body>
	</html>
}
