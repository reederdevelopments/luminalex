
package admin

import "maoni/app/core/auth"

templ adminLayout(user auth.User, pageTitle string, children templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="h-full bg-gray-100">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{"Maoni Admin - " + pageTitle}</title>
			<link rel="stylesheet" href="/assets/styles/main.css"/>
			<link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg"/>
			<script src="https://unpkg.com/htmx.org@1.9.12" integrity="sha384-ujb1lZYygJmzgSwoxRggbCHcjc0rB2XoQrxeTUQyRjrOnlCoYta87iKBWq3EsdM2" crossorigin="anonymous"></script>
		</head>
		<body class="h-full">
			<div class="min-h-full">
				<header class="bg-white shadow-sm">
					<div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
						<div class="flex items-center justify-between">
							<h1 class="text-lg font-semibold leading-6 text-gray-900">Admin Dashboard</h1>
							<a href="/" class="text-sm font-medium text-green-x-dark hover:text-green-x-dark">Back to Survey</a>
						</div>
					</div>
				</header>
				<main>
					<div class="mx-auto max-w-7xl py-6 sm:px-6 lg:px-8">
						@children
					</div>
				</main>
			</div>
			<script src="/assets/scripts/survey_form.js"></script>
		</body>
	</html>
}
