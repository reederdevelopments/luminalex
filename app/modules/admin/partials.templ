
package admin

import (
	"fmt"
	"maoni/app/core/survey"
	"maoni/app/core/ui/icon"
)

var questionTypes = []struct {
	Value string
	Label string
}{
	{string(survey.Text), "Short Answer"},
	{string(survey.Textarea), "Paragraph"},
	{string(survey.MultipleChoice), "Multiple Choice"},
	{string(survey.Checkbox), "Checkboxes"},
	{string(survey.Dropdown), "Dropdown"},
	{string(survey.MultiGridRadio), "Multi-grid (radio)"},
}

// Helper to determine if a question type needs an options list
func isSelectable(t string) bool {
	return t == string(survey.MultipleChoice) || t == string(survey.Checkbox) || t == string(survey.Dropdown) || t == string(survey.MultiGridRadio)
}

// Helper to determine if a question type needs rows list
func hasRows(t string) bool {
	return t == string(survey.MultiGridRadio)
}

func getGroupNumber(q survey.Question) int {
	if q.GroupNumber > 0 {
		return q.GroupNumber
	}
	return 1
}

templ groupHeadingInput(heading string, index int) {
	<div class="group-heading-block">
		<label for={ fmt.Sprintf("group_heading_editor_%d", index) } class="block text-sm font-semibold leading-6 text-gray-900">
			{ fmt.Sprintf("Group %d Heading", index + 1) }
		</label>
		<div class="mt-2">
			<div class="editor-toolbar flex items-center space-x-2 p-2 bg-gray-50 rounded-t-md border border-b-0 border-gray-300">
				<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="bold" title="Bold">@icon.BoldIcon()</button>
				<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="italic" title="Italic">@icon.ItalicIcon()</button>
				<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="underline" title="Underline">@icon.UnderlineIcon()</button>
				<div class="h-4 border-l border-gray-300 mx-1"></div>
				<select class="editor-font-size-selector bg-transparent border-none rounded-md text-sm p-1 hover:bg-gray-200 focus:ring-0" title="Font Size">
					<option value="" disabled selected>Size</option>
					<option value="1">Tiny</option>
					<option value="2">Small</option>
					<option value="3">Normal</option>
					<option value="4">Large</option>
					<option value="5">XL</option>
					<option value="6">XXL</option>
				</select>
				<div class="h-4 border-l border-gray-300 mx-1"></div>
				<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="createLink" title="Link">@icon.LinkIcon()</button>
				<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="insertUnorderedList" title="Unordered List">@icon.ListUnorderedIcon()</button>
				<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="insertOrderedList" title="Ordered List">@icon.ListOrderedIcon()</button>
				<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="formatBlock" data-value="blockquote" title="Quote">@icon.QuoteIcon()</button>
				<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="wrapWithCode" title="Code">@icon.CodeBracketIcon()</button>
			</div>
			<div class="flex items-start gap-2">
				<input type="hidden" name="GroupHeadings" id={ fmt.Sprintf("hidden_group_heading_%d", index) } value={ heading }/>
				<div
					id={ fmt.Sprintf("group_heading_editor_%d", index) }
					class="wysiwyg-editor block w-full rounded-b-md border-t-0 border border-gray-300 shadow-sm focus:outline-none focus:border-green-x-dark focus:ring-1 focus:ring-green-x-dark sm:text-sm p-2 prose max-w-none"
					style="min-height: 5rem;"
					contenteditable="true"
					data-hidden-input-id={ fmt.Sprintf("hidden_group_heading_%d", index) }
					placeholder="e.g. Section 1: Personal Information"
				>
					@templ.Raw(heading)
				</div>
				<button type="button" class="remove-group-heading-btn text-red-x-dark hover:text-red-x-light mt-2">
					@icon.Trash()
				</button>
			</div>
		</div>
	</div>
}

templ questionForm(q survey.Question, index int) {
	<div class="question-block rounded-lg border border-gray-200 p-6 bg-gray-50 mb-6 shadow-sm" data-question-index={ fmt.Sprintf("%d", index) }>
		<input type="hidden" name={ fmt.Sprintf("questions[%d].ID", index) } value={ q.ID }/>
		<div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
			<div class="sm:col-span-full">
				<label for={ fmt.Sprintf("question_text_%d", index) } class="block text-sm font-medium leading-6 text-gray-900">Question Text</label>
				<div class="mt-2">
					<div class="editor-toolbar flex items-center space-x-2 p-2 bg-gray-50 rounded-t-md border border-b-0 border-gray-300">
						<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="bold" title="Bold">@icon.BoldIcon()</button>
						<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="italic" title="Italic">@icon.ItalicIcon()</button>
						<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="underline" title="Underline">@icon.UnderlineIcon()</button>
						<div class="h-4 border-l border-gray-300 mx-1"></div>
						<select class="editor-font-size-selector bg-transparent border-none rounded-md text-sm p-1 hover:bg-gray-200 focus:ring-0" title="Font Size">
							<option value="" disabled selected>Size</option>
							<option value="1">Tiny</option>
							<option value="2">Small</option>
							<option value="3">Normal</option>
							<option value="4">Large</option>
							<option value="5">XL</option>
							<option value="6">XXL</option>
						</select>
						<div class="h-4 border-l border-gray-300 mx-1"></div>
						<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="createLink" title="Link">@icon.LinkIcon()</button>
						<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="insertUnorderedList" title="Unordered List">@icon.ListUnorderedIcon()</button>
						<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="insertOrderedList" title="Ordered List">@icon.ListOrderedIcon()</button>
						<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="formatBlock" data-value="blockquote" title="Quote">@icon.QuoteIcon()</button>
						<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="wrapWithCode" title="Code">@icon.CodeBracketIcon()</button>
					</div>
					<input type="hidden" name={ fmt.Sprintf("questions[%d].Text", index) } id={ fmt.Sprintf("hidden_question_text_%d", index) } value={ q.Text }/>
					<div
						id={ fmt.Sprintf("question_text_%d", index) }
						class="wysiwyg-editor block w-full rounded-b-md border-t-0 border border-gray-300 shadow-sm focus:outline-none focus:border-green-x-dark focus:ring-1 focus:ring-green-x-dark sm:text-sm p-2 prose max-w-none"
						style="min-height: 5rem;"
						contenteditable="true"
						data-hidden-input-id={ fmt.Sprintf("hidden_question_text_%d", index) }
					>
						@templ.Raw(q.Text)
					</div>
				</div>
			</div>
			<div class="sm:col-span-2">
				<label for={ fmt.Sprintf("question_type_%d", index) } class="block text-sm font-medium leading-6 text-gray-900">Question Type</label>
				<div class="mt-2">
					<select
						name={ fmt.Sprintf("questions[%d].Type", index) }
						id={ fmt.Sprintf("question_type_%d", index) }
						class="question-type-selector block w-full rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm"
					>
						for _, qt := range questionTypes {
							<option value={ qt.Value } selected?={ q.Type == qt.Value }>{ qt.Label }</option>
						}
					</select>
				</div>
			</div>
			<div class="sm:col-span-2">
				<label for={ fmt.Sprintf("question_group_%d", index) } class="block text-sm font-medium leading-6 text-gray-900">Group</label>
				<div class="mt-2">
					<input type="number" name={ fmt.Sprintf("questions[%d].GroupNumber", index) } id={ fmt.Sprintf("question_group_%d", index) } value={ fmt.Sprintf("%d", getGroupNumber(q)) } min="1" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm"/>
				</div>
			</div>
			<div class="sm:col-span-2">
				<label for={ fmt.Sprintf("prefill_variable_%d", index) } class="block text-sm font-medium leading-6 text-gray-900">Prefill Variable</label>
				<div class="mt-2">
					<select name={ fmt.Sprintf("questions[%d].PrefillVariable", index) } id={ fmt.Sprintf("prefill_variable_%d", index) } class="block w-full rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm">
						<option value="" selected?={ q.PrefillVariable == "" }>None</option>
						<option value="variable_1" selected?={ q.PrefillVariable == "variable_1" }>Variable 1</option>
						<option value="variable_2" selected?={ q.PrefillVariable == "variable_2" }>Variable 2</option>
						<option value="variable_3" selected?={ q.PrefillVariable == "variable_3" }>Variable 3</option>
						<option value="variable_4" selected?={ q.PrefillVariable == "variable_4" }>Variable 4</option>
						<option value="variable_5" selected?={ q.PrefillVariable == "variable_5" }>Variable 5</option>
					</select>
				</div>
				<p class="mt-2 text-sm text-gray-500">For Special Surveys only. Select a variable to prefill this question's answer.</p>
			</div>
		</div>
		<div class={ "mt-6 options-container", templ.KV("hidden", !isSelectable(q.Type)) }>
			<label class="block text-sm font-medium text-gray-900 mb-2">Options (Columns)</label>
			<div class="space-y-2 options-list" data-question-index={ fmt.Sprintf("%d", index) }>
				for i, opt := range q.Options {
					<div class="flex items-center gap-2 option-input">
						<input type="text" name={ fmt.Sprintf("questions[%d].Options", index) } value={ opt } class="block w-full rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm" placeholder={ fmt.Sprintf("Option %d", i+1) }/>
						<button type="button" class="remove-option-btn text-red-x-dark hover:text-red-x-light">
							@icon.X()
						</button>
					</div>
				}
			</div>
			<button type="button" class="add-option-btn mt-3 inline-flex items-center gap-x-1.5 rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
				Add Option
			</button>
		</div>
		<div class={ "mt-6 rows-container", templ.KV("hidden", !hasRows(q.Type)) }>
			<label class="block text-sm font-medium text-gray-900 mb-2">Rows (Sub-questions)</label>
			<div class="space-y-4 rows-list" data-question-index={ fmt.Sprintf("%d", index) }>
				for i, row := range q.Rows {
					<div class="row-input">
						<div class="flex items-start gap-2">
							<div class="w-full">
								<div class="editor-toolbar flex items-center space-x-2 p-1 bg-gray-100 rounded-t-md border border-b-0 border-gray-300">
									<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="bold" title="Bold">@icon.BoldIcon()</button>
									<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="italic" title="Italic">@icon.ItalicIcon()</button>
									<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="underline" title="Underline">@icon.UnderlineIcon()</button>
									<div class="h-4 border-l border-gray-300 mx-1"></div>
									<select class="editor-font-size-selector bg-transparent border-none rounded-md text-sm p-1 hover:bg-gray-200 focus:ring-0" title="Font Size">
										<option value="" disabled selected>Size</option>
										<option value="1">Tiny</option>
										<option value="2">Small</option>
										<option value="3">Normal</option>
										<option value="4">Large</option>
										<option value="5">XL</option>
										<option value="6">XXL</option>
									</select>
									<div class="h-4 border-l border-gray-300 mx-1"></div>
									<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="createLink" title="Link">@icon.LinkIcon()</button>
									<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="insertUnorderedList" title="Unordered List">@icon.ListUnorderedIcon()</button>
									<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="insertOrderedList" title="Ordered List">@icon.ListOrderedIcon()</button>
									<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="formatBlock" data-value="blockquote" title="Quote">@icon.QuoteIcon()</button>
									<button type="button" class="editor-btn p-1 rounded hover:bg-gray-200" data-command="wrapWithCode" title="Code">@icon.CodeBracketIcon()</button>
								</div>
								<input type="hidden" name={ fmt.Sprintf("questions[%d].Rows", index) } value={ row } id={ fmt.Sprintf("hidden_row_%d_%d", index, i) }/>
								<div
									class="wysiwyg-editor block w-full rounded-b-md border-t-0 border border-gray-300 shadow-sm focus:outline-none focus:border-green-x-dark focus:ring-1 focus:ring-green-x-dark sm:text-sm p-2 prose max-w-none"
									contenteditable="true"
									style="min-height: 2.5rem;"
									data-hidden-input-id={ fmt.Sprintf("hidden_row_%d_%d", index, i) }
									placeholder={ fmt.Sprintf("Row %d", i+1) }
								>
									@templ.Raw(row)
								</div>
							</div>
							<button type="button" class="remove-row-btn text-red-x-dark hover:text-red-x-light mt-2">
								@icon.X()
							</button>
						</div>
					</div>
				}
			</div>
			<button type="button" class="add-row-btn mt-3 inline-flex items-center gap-x-1.5 rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
				Add Row
			</button>
		</div>
		<div class="mt-6 pt-4 border-t border-gray-200 flex justify-between items-center">
			<div class="flex items-center gap-x-3">
				<input id={ fmt.Sprintf("is_required_%d", index) } name={ fmt.Sprintf("questions[%d].IsRequired", index) } type="checkbox" class="h-4 w-4 rounded border-gray-300 text-green-x-dark focus:ring-green-x-dark" checked?={ q.IsRequired } value="true"/>
				<label for={ fmt.Sprintf("is_required_%d", index) } class="text-sm font-medium text-gray-700">Required Question</label>
			</div>
			<div class="flex items-center gap-x-4">
				<div class="flex items-center">
					<button type="button" class="move-question-up-btn rounded-full p-1 text-gray-400 hover:text-gray-600 hover:bg-gray-100" title="Move up">
						@icon.ChevronUp()
					</button>
					<button type="button" class="move-question-down-btn rounded-full p-1 text-gray-400 hover:text-gray-600 hover:bg-gray-100" title="Move down">
						@icon.ChevronDown()
					</button>
				</div>
				<button type="button" class="remove-question-btn inline-flex items-center gap-x-1.5 text-sm font-semibold text-red-600 hover:text-red-500">
					@icon.Trash() Remove Question
				</button>
			</div>
		</div>
	</div>
}
