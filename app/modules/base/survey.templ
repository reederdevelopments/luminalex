
package base

import (
	"fmt"
	"maoni/app/core/auth"
	"maoni/app/core/survey"
	"maoni/app/core/ui/icon"
	"maoni/app/core/ui/layout"
	"maoni/app/core/web"
	"time"
)

// Helper functions (Standard Go functions)
// -----------------------------------------------------------------------------

func surveyLink(s survey.Survey) templ.SafeURL {
	return templ.URL(fmt.Sprintf("/surveys/%s?assignment_id=%s", s.ID, s.AssignmentID))
}

func formatSurveyCloseDate(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	return "Due: " + t.In(web.GMTPlus2).Format("2 Jan 2006 at 15:04")
}

func hasQuestionsInGroup(questions []survey.Question, groupIndex int) bool {
	for _, q := range questions {
		if q.GroupNumber == groupIndex+1 {
			return true
		}
	}
	return false
}

func getStringValue(prefill string, saved any) string {
	if s, ok := saved.(string); ok && s != "" {
		return s
	}
	return prefill
}

func isValueSelected(option string, saved any) bool {
	if saved == nil {
		return false
	}
	// For radio buttons or dropdown, saved is a string
	if s, ok := saved.(string); ok {
		return s == option
	}
	// For checkboxes, saved is a slice. Firestore decodes JSON arrays to []interface{} which is []any in Go.
	if slice, ok := saved.([]any); ok {
		for _, v := range slice {
			if s, ok := v.(string); ok && s == option {
				return true
			}
		}
	}
	return false
}

func getGridValue(qID string, rowIndex int, savedAnswers map[string]any) any {
	if savedAnswers == nil {
		return nil
	}
	key := fmt.Sprintf("%s_%d", qID, rowIndex)
	return savedAnswers[key]
}

// Components (Templ components)
// -----------------------------------------------------------------------------

templ BaseLayout(user auth.User, title string) {
	@layout.Html(title) {
		<div class="min-h-full">
			<header class="header-background shadow-sm">
				<div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-4">
							<a href="/" class="flex items-center gap-2 text-white">
								<img src="/assets/img/logo.png" class="h-8 w-auto"/>
								<span class="text-lg font-semibold leading-6">Community Feedback</span>
							</a>
						</div>
						<div class="flex items-center gap-4">
							<span class="hidden sm:inline text-sm text-gray-200">Hello, { user.FirstName }</span>
							if user.IsAdmin {
								<a href="/admin" class="text-sm font-medium text-white hover:text-gray-200">Admin</a>
							}
							<a href="/logout" class="text-sm font-medium text-gray-200 hover:text-white">Logout</a>
						</div>
					</div>
				</div>
			</header>
			<main>
				<div class="mx-auto max-w-7xl py-6 sm:px-6 lg:px-8">
					{ children... }
				</div>
			</main>
		</div>
	}
}

templ surveyListPage(user auth.User, surveys []survey.Survey) {
	@BaseLayout(user, "Available Surveys") {
		<div>
			<div class="sm:flex sm:items-center">
				<div class="sm:flex-auto">
					<h1 class="text-2xl font-semibold leading-6 text-gray-900">Available Surveys</h1>
					<p class="mt-2 text-base text-gray-700">A list of all surveys available for you to complete.</p>
				</div>
			</div>
			<div class="mt-8 flow-root">
				<div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
					<div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
						if len(surveys) == 0 {
							<div class="flex h-96 items-center justify-center rounded-lg border-4 border-dashed border-gray-200 p-4">
								<p class="text-center text-black text-lg">No surveys available for you at the moment.</p>
							</div>
						} else {
							<ul role="list" class="divide-y divide-gray-200 bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl">
								for _, s := range surveys {
									<li class="relative flex items-center space-x-4 px-4 py-4 sm:px-6">
										<div class="min-w-0 flex-auto">
											<div class="flex items-center gap-x-3">
												<h2 class="min-w-0 text-sm font-semibold leading-6 text-gray-900">
													<a href={ surveyLink(s) } class="flex gap-x-2">
														<span class="truncate">{ s.Name }</span>
														if s.PrefillData["variable_1"] != "" {
															<span class="text-gray-500 font-normal truncate">&nbsp;{ s.PrefillData["variable_1"] }</span>
														}
														<span class="absolute inset-0"></span>
													</a>
												</h2>
											</div>
											<div class="mt-1 flex items-center gap-x-2 text-xs leading-5 text-gray-500">
												<p class="whitespace-normal text-pretty">{ s.Description }</p>
											</div>
										</div>
										if !s.SurveyClosed.IsZero() {
											<div class="flex-none">
												<p class="whitespace-nowrap text-sm text-gray-500">{ formatSurveyCloseDate(s.SurveyClosed) }</p>
											</div>
										}
										@icon.ChevronRight()
									</li>
								}
							</ul>
						}
					</div>
				</div>
			</div>
		</div>
	}
}

templ TakeSurveyPage(user auth.User, s survey.Survey, prefills map[string]string, savedAnswers map[string]any) {
	@BaseLayout(user, s.Name) {
		<form action={ templ.URL(fmt.Sprintf("/surveys/%s", s.ID)) } method="POST">
			<input type="hidden" name="assignment_id" value={ s.AssignmentID }/>
			<div class="space-y-10 bg-white p-6 rounded-lg shadow">
				if s.Banner != "" {
					<div class="w-full h-48 sm:h-96 rounded-t-lg overflow-clip">
						<img src={ s.Banner } alt="Survey Banner" class="w-full h-full object-fit" loading="lazy"/>
					</div>
				}
				<div>
					<h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">{ s.Name }</h1>
					if s.Instructions != "" {
						<div class="mt-4 prose max-w-none">
							@templ.Raw(s.Instructions)
						</div>
					} else if s.Description != "" {
						<p class="mt-4 text-lg text-gray-600">{ s.Description }</p>
					}
				</div>
				<div class="space-y-10">
					if len(s.GroupHeadings) > 0 {
						for groupIndex, groupHeading := range s.GroupHeadings {
							if hasQuestionsInGroup(s.Questions, groupIndex) {
								if groupHeading != "" {
									<div class="border-t border-gray-200 pt-10">
										<h2 class="text-lg font-semibold leading-6 text-gray-900">@templ.Raw(groupHeading)</h2>
									</div>
								}
								for _, q := range s.Questions {
									if q.GroupNumber == groupIndex+1 {
										@questionDisplay(q, prefills[q.PrefillVariable], savedAnswers)
									}
								}
							}
						}
					} else {
						for _, q := range s.Questions {
							@questionDisplay(q, prefills[q.PrefillVariable], savedAnswers)
						}
					}
				</div>
				<div class="border-t border-gray-200 pt-6">
					<div class="flex justify-end">
						<button type="submit" class="rounded-md bg-green-x-light px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-x-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-x-light">
							Submit Survey
						</button>
					</div>
				</div>
				if s.AssignmentID == "" { 
                <div class="mt-12 p-6 border-2 border-dashed border-blue-300 rounded-lg bg-blue-50">
                    <div class="flex items-center gap-2 mb-4 text-blue-700">
                        @icon.ExpandIcon() // Or any informative icon
                        <h3 class="text-lg font-bold">Thank You Message Preview</h3>
                    </div>
                    <div class="text-center bg-white p-10 rounded-lg shadow-inner border border-gray-200">
                        if s.ThankYouMessage != "" {
                            <div class="prose max-w-none mx-auto">
                                @templ.Raw(s.ThankYouMessage)
                            </div>
                        } else {
                            <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">Thank you for your valuable feedback...</h1>
                            <p class="mt-4 text-lg text-gray-600">Have an easy day</p>
                        }
                    </div>
                    <p class="mt-4 text-xs text-blue-500 italic text-center">Note: This section is only visible during preview and will not appear to the final user here.</p>
                </div>
            }
			</div>
			<div id="progress-container" class="fixed bottom-5 left-1/2 -translate-x-1/2 w-11/12 max-w-lg bg-gray-200 rounded-full h-4 shadow-lg">
				<div id="progress-bar" class="bg-green-x-dark h-4 rounded-full transition-all duration-300" style="width: 0%"></div>
				<span id="progress-text" class="absolute inset-0 text-center text-xs font-medium text-white leading-4">0%</span>
			</div>
		</form>
		<script src="/assets/scripts/take_survey.js" type="module"></script>
	}
}

templ questionDisplay(q survey.Question, prefillValue string, savedAnswers map[string]any) {
	<div class="mt-6 space-y-4 question-block" data-question-type={ q.Type }>
		<label class="flex items-baseline gap-1 text-base font-medium text-gray-900 prose max-w-none">
			@templ.Raw(q.Text)
			if q.IsRequired {
				<span class="text-red-600">*</span>
			}
		</label>

		switch survey.QuestionType(q.Type) {
		case survey.MultiGridRadio:
			<div class="overflow-x-auto">
				<table class="w-full table-fixed text-sm text-left border-collapse">
					<thead class="bg-gray-50">
						<tr>
							<th scope="col" class="w-1/2 py-2 px-3 border border-gray-300"></th>
							for _, option := range q.Options {
								<th scope="col" class="py-2 px-3 text-center font-medium text-gray-700 border border-gray-300 break-words">{ option }</th>
							}
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-200">
						for i, row := range q.Rows {
							<tr class="border-t border-gray-200">
								<td class="py-3 px-3 font-medium text-gray-800 border border-gray-300 break-words">@templ.Raw(row)</td>
								for _, option := range q.Options {
									<td class="py-3 px-3 text-center border border-gray-300">
										<input
											type="radio"
											name={ fmt.Sprintf("%s_%d", q.ID, i) }
											value={ option }
											class="h-4 w-4 border-gray-300 text-green-x-dark focus:ring-green-x-dark"
											required?={ q.IsRequired }
											checked?={ isValueSelected(option, getGridValue(q.ID, i, savedAnswers)) }
										/>
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		case survey.Text:
			<input type="text" name={ q.ID } value={ getStringValue(prefillValue, savedAnswers[q.ID]) } class="block w-full rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm" required?={ q.IsRequired } readonly?={ prefillValue != "" }/>
		case survey.Textarea:
			<textarea name={ q.ID } rows="4" maxlength="1000" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm" required?={ q.IsRequired } readonly?={ prefillValue != "" }>{ getStringValue(prefillValue, savedAnswers[q.ID]) }</textarea>
		case survey.MultipleChoice:
			<fieldset class="space-y-2">
				for _, option := range q.Options {
					<div class="relative flex items-start">
						<div class="flex h-6 items-center">
							<input id={ q.ID + "-" + option } name={ q.ID } type="radio" value={ option } class="h-4 w-4 border-gray-300 text-green-x-dark focus:ring-green-x-dark" required?={ q.IsRequired } checked?={ isValueSelected(option, savedAnswers[q.ID]) }/>
						</div>
						<div class="ml-3 text-sm leading-6">
							<label for={ q.ID + "-" + option } class="font-medium text-gray-700">{ option }</label>
						</div>
					</div>
				}
			</fieldset>
		case survey.Checkbox:
			<fieldset class="space-y-2">
				for _, option := range q.Options {
					<div class="relative flex items-start">
						<div class="flex h-6 items-center">
							<input id={ q.ID + "-" + option } name={ q.ID } type="checkbox" value={ option } class="h-4 w-4 rounded border-gray-300 text-green-x-dark focus:ring-green-x-dark" checked?={ isValueSelected(option, savedAnswers[q.ID]) }/>
						</div>
						<div class="ml-3 text-sm leading-6">
							<label for={ q.ID + "-" + option } class="font-medium text-gray-700">{ option }</label>
						</div>
					</div>
				}
			</fieldset>
		case survey.Dropdown:
			<select name={ q.ID } class="block w-full rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm" required?={ q.IsRequired }>
				<option value="">Select an option</option>
				for _, option := range q.Options {
					<option value={ option } selected?={ isValueSelected(option, savedAnswers[q.ID]) }>{ option }</option>
				}
			</select>
		}
	</div>
}

templ surveyAlreadyCompletedPage(user auth.User) {
	@BaseLayout(user, "Survey Already Completed") {
		<div class="text-center bg-white p-10 rounded-lg shadow">
			<h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">Thank you!</h1>
			<p class="mt-4 text-lg text-gray-600">You have already completed this survey.</p>
			<div class="mt-6">
				<a href="/" class="rounded-md bg-green-x-light px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-x-dark">Back to Surveys</a>
			</div>
		</div>
	}
}

templ surveyThankYouPage(user auth.User, s survey.Survey) { // Update signature to accept survey
	@BaseLayout(user, "Thank You") {
		<div class="text-center bg-white p-10 rounded-lg shadow">
			if s.ThankYouMessage != "" {
				<div class="prose max-w-none mx-auto">
					@templ.Raw(s.ThankYouMessage)
				</div>
			} else {
				<h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">Thank you for your valuable feedback, it helps make Unifi better.</h1>
				<p class="mt-4 text-lg text-gray-600">Have an easy day</p>
			}
			<div class="mt-6">
				<a href="/" class="rounded-md bg-green-x-light px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-x-dark">Back to Surveys</a>
			</div>
		</div>
	}
}
