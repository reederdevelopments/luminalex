					</svg>
					<p class="text-red-x-dark font-semibold text-lg">Loading…</p>
					<p class="text-gray-500 text-sm mt-1">This can take a few seconds.</p>
				</div>
			</div>

			<iframe src="https://datastudio.google.com/embed/reporting/d179f56a-8312-48b7-a396-21758314bbe9/page/p_596g9ngm3d" id="main-view" title="Ujuzi Content Frame" class="w-full h-full border-none block"></iframe>
			<div id="native-tool-view" class="w-full h-full hidden items-center justify-center text-5xl font-black text-hl tracking-widest uppercase bg-gray-50">
				<span id="tool-title">TOOL 1</span>
			</div>
		</div>

		<nav id="platform-menu" class="fixed top-0 left-0 w-full md:w-[18vw] h-full bg-green-x-dark border-r border-green-x-dark shadow-2xl z-[999] flex flex-col pt-4">
			
			<div class="absolute right-6 top-8 text-green-x-light hover:text-white cursor-pointer transition-colors z-50 flex items-center justify-center" onclick="setSidebarState('closed')">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</div>

			<div class="flex-1 overflow-y-auto flex flex-col hide-scrollbar">
				
				<div class="flex justify-between items-center px-6 pb-4 pt-4 border-b border-green-x-light/30 relative">
					<div class="flex flex-col">
						<div class="text-2xl font-black tracking-widest text-white drop-shadow-sm">UJUZI</div>
						<div class="text-[10px] font-bold uppercase tracking-wider text-green-x-light mt-1">{ user.Name }</div>
					</div>
					
					<div class="flex items-center pr-8">
						<div class="relative flex items-center">
							<button id="flag-btn" class="flex items-center justify-center w-8 h-8 rounded-full border-2 border-green-x-light shadow-sm overflow-hidden focus:outline-none hover:border-white transition-colors cursor-pointer">
								<img id="current-flag" src={ getFlagUrl(user.DefaultCountry) } alt="Current Country Flag" class="w-full h-full object-cover"/>
							</button>

							<div id="country-dropdown" class="absolute right-0 top-10 mt-2 w-48 bg-white rounded-xl shadow-xl hidden z-50 overflow-hidden border border-gray-100">
								<div class="px-4 py-2 text-[10px] font-bold text-gray-400 uppercase tracking-widest bg-gray-50 border-b border-gray-100">Select Region</div>
								if len(user.Countries) > 0 {
									for _, code := range user.Countries {
										<div class="country-option flex items-center gap-3 px-4 py-3 hover:bg-green-x-light/10 cursor-pointer text-gray-700 text-xs font-bold tracking-wide transition-colors" data-country={ code } data-flag={ getFlagUrl(code) }>
											<img src={ getFlagUrl(code) } alt={ code } class="w-5 h-5 rounded-full object-cover border border-gray-200 shadow-sm"/>
											<span>{ getCountryName(code) }</span>
										</div>
									}
								} else {
									<div class="px-4 py-3 text-xs text-gray-400 italic">No regions assigned</div>
								}
							</div>
						</div>
					</div>
				</div>

				<div class="px-6 py-2 text-[10px] uppercase tracking-widest font-bold text-green-x-light bg-black/10 border-b border-green-x-light/30">
					{ getHighestGroup(user.Groups, allGroups) }
				</div>

				<div class="px-5 pt-5 pb-1 relative">
					<input type="text" id="menu-search-input" class="w-full bg-black/20 border border-green-x-light/20 text-white px-4 py-2 rounded-lg outline-none text-xs font-medium tracking-wide transition-all focus:bg-black/40 focus:border-green-x-light focus:ring-4 focus:ring-hl/10 placeholder-green-x-light/50 shadow-inner" placeholder="Search system..." autocomplete="off"/>
					<div id="menu-search-results" class="absolute top-full left-5 right-5 mt-1 bg-white border border-gray-200 rounded-lg max-h-48 overflow-y-auto z-[1000] hidden shadow-xl text-gray-800"></div>
				</div>

				<div class="flex flex-col pb-6">
					for area, areaDashes := range getUserDashboardsByArea(user, allGroups, allDashboards) {
						<div class="mt-4 px-6">
							<div class="flex items-center justify-between text-[10px] font-bold text-green-x-light uppercase tracking-widest cursor-pointer group" onclick="window.toggleMenu(event, this)">
								<span>{ area }</span>
								<span class="group-hover:text-white transition-colors text-[8px]">▼</span>
							</div>
							<div class="menu-dropdown-content hidden flex-col gap-3 mt-3">
								for _, d := range areaDashes {
									<div class="flex flex-col">
										<div class="flex items-center justify-between group/dash py-1.5 pl-1">
											<div class="flex items-center gap-2 overflow-hidden flex-1">
												<button class="text-gray-500 hover:text-yellow-400 focus:outline-none transition-colors shrink-0"
													onclick="window.toggleFavorite(event, this)"
													data-id={ "Dashboard:" + d.ID }
													data-name={ d.Name }
													data-url={ d.ReportURL }
													data-p-country={ d.Parameters.CountryCode }
													data-p-branch={ d.Parameters.Branch }
													data-p-consultant={ d.Parameters.Consultant }
													data-p-cycle={ d.Parameters.Cycle }
													data-p-prev={ d.Parameters.PrevCycle }
													data-p-date={ d.Parameters.Date }
													data-p-period={ d.Parameters.Period }
													title="Toggle Favorite">
													if isFavorite(user.Favorites, "Dashboard:" + d.ID) {
														<svg class="w-3 h-3 text-yellow-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
													} else {
														<svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
													}
												</button>
												<span class="text-xs text-white/90 cursor-pointer hover:text-hl transition-colors truncate pr-2" 
													data-url={ d.ReportURL } 
													data-p-country={ d.Parameters.CountryCode }
													data-p-branch={ d.Parameters.Branch }
													data-p-consultant={ d.Parameters.Consultant }
													data-p-cycle={ d.Parameters.Cycle }
													data-p-prev={ d.Parameters.PrevCycle }
													data-p-date={ d.Parameters.Date }
													data-p-period={ d.Parameters.Period }
													onclick="window.handleDashboardClick(event, this)">{ d.Name }</span>
											</div>
											if len(d.Pages) > 0 {
												<span class="text-green-x-light/50 hover:text-white cursor-pointer text-[10px] transition-colors px-2 py-1 shrink-0"
													onclick="window.togglePages(event, this)">▼</span>
											}
										</div>
										if len(d.Pages) > 0 {
											<div class="hidden flex-col gap-2 pl-3 pb-2 border-l border-green-x-light/20 ml-2 mt-1">
												for _, p := range d.Pages {
													<div class="flex items-center gap-2 py-1">
														<button class="text-gray-500 hover:text-yellow-400 focus:outline-none transition-colors shrink-0 pl-1"
															onclick="window.toggleFavorite(event, this)"
															data-id={ "Page:" + d.ID + ":" + p.Code }
															data-code={ p.Code }
															data-name={ d.Name + " - " + p.Name }
															data-url={ d.ReportURL }
															data-p-country={ d.Parameters.CountryCode }
															data-p-branch={ d.Parameters.Branch }
															data-p-consultant={ d.Parameters.Consultant }
															data-p-cycle={ d.Parameters.Cycle }
															data-p-prev={ d.Parameters.PrevCycle }
															data-p-date={ d.Parameters.Date }
															data-p-period={ d.Parameters.Period }>
															if isFavorite(user.Favorites, "Page:" + d.ID + ":" + p.Code) {
																<svg class="w-3 h-3 text-yellow-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
															} else {
																<svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
															}
														</button>
														<span class="w-full block text-xs font-medium text-gray-400 hover:text-hl cursor-pointer transition-colors truncate" 
															data-url={ d.ReportURL } 
															data-code={ p.Code }
															data-p-country={ d.Parameters.CountryCode }
															data-p-branch={ d.Parameters.Branch }
															data-p-consultant={ d.Parameters.Consultant }
															data-p-cycle={ d.Parameters.Cycle }
															data-p-prev={ d.Parameters.PrevCycle }
															data-p-date={ d.Parameters.Date }
															data-p-period={ d.Parameters.Period }
															onclick="window.handleDashboardClick(event, this, this.getAttribute('data-code'))">{ p.Name }</span>
													</div>
												}
											</div>
										}
									</div>
								}
							</div>
						</div>
					}

					if len(user.Tools) > 0 {
						<div class="mt-6 px-6 pt-4 border-t border-green-x-light/10">
							<div class="flex items-center justify-between text-[10px] font-bold text-green-x-light uppercase tracking-widest cursor-pointer group" onclick="window.toggleMenu(event, this)">
								<span>TOOLS</span>
								<span class="group-hover:text-white transition-colors text-[8px]">▼</span>
							</div>
							<div class="menu-dropdown-content hidden flex-col gap-3 mt-3">
								for _, t := range user.Tools {
									<div class="flex items-center gap-2 py-1 pl-1">
										<button class="text-gray-500 hover:text-yellow-400 focus:outline-none transition-colors shrink-0"
											onclick="window.toggleFavorite(event, this)"
											data-id={ "Tool:" + t }
											data-tool={ t }
											data-name={ t } data-url={ getToolUrl(t) }>
											if isFavorite(user.Favorites, "Tool:" + t) {
												<svg class="w-3 h-3 text-yellow-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
											} else {
												<svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
											}
										</button>
										<span class="w-full block text-xs text-white/90 cursor-pointer hover:text-hl transition-colors truncate pr-2" 
											data-tool={ t } 
											data-url={ getToolUrl(t) } 
											onclick="window.handleToolClick(event, this)">{ t }</span>
									</div>
								}
							</div>
						</div>
					}
				</div>
			</div>

			<div class="mt-auto w-full bg-green-x-dark border-t border-green-x-light/30">
				
				if hasAdminGroup(user.Groups, allGroups) {
					<div class="px-5 py-3 border-b border-green-x-light/10">
						<div class="text-[10px] font-bold text-green-x-light uppercase tracking-widest mb-2 pl-1">Admin</div>
						<a class="flex items-center gap-3 px-4 py-2.5 text-xs font-bold text-white tracking-wide rounded-lg hover:bg-green-x-light/20 transition-all cursor-pointer" onclick="changeIframeUrl('/admin/management')">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-green-x-light">
								<path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
							</svg>
							USER MANAGEMENT
						</a>
						<a class="flex items-center gap-3 px-4 py-2.5 text-xs font-bold text-white tracking-wide rounded-lg hover:bg-green-x-light/20 transition-all cursor-pointer mt-1" onclick="changeIframeUrl('/admin/dashboards')">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-green-x-light">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
							</svg>
							DASHBOARD MANAGEMENT
						</a>
                        <a class="flex items-center gap-3 px-4 py-2.5 text-xs font-bold text-white tracking-wide rounded-lg hover:bg-green-x-light/20 transition-all cursor-pointer mt-1" onclick="changeIframeUrl('/admin/engineering')">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-green-x-light">
								<path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.83M11.42 15.17l-4.908 4.908a2.652 2.652 0 01-3.75-3.75l4.908-4.908m3.75 3.75l-3.75-3.75M17.25 21L21 17.25M6.512 10.08l1.414 1.414a.5.5 0 00.707 0l2.121-2.12a.5.5 0 000-.708l-1.414-1.414a1.5 1.5 0 010-2.121l1.414-1.414a.5.5 0 000-.707l-2.121-2.121a.5.5 0 00-.707 0l-1.414 1.414a1.5 1.5 0 01-2.121 0l-1.414-1.414a.5.5 0 00-.708 0l-2.12 2.121a.5.5 0 000 .707l1.414 1.414a1.5 1.5 0 010 2.121l-1.414 1.414a.5.5 0 000 .708l2.121 2.12a.5.5 0 00.707 0l1.414-1.414z" />
							</svg>
							ENGINEERING
						</a>
					</div>
				}

                <div class="px-5 py-4">
					<a href="/logout" class="flex w-full items-center justify-center gap-2 rounded-lg bg-red-x-light px-4 py-2.5 text-xs font-bold tracking-wide text-white shadow hover:bg-red-x-dark transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
							<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
						</svg>
						SIGN OUT
					</a>
				</div>
				<div class="text-center text-[9px] text-green-x-light/60 font-mono tracking-widest pb-3">
					v 1.0.0 // SYS
				</div>
			</div>
		</nav>

		<div id="user-env" class="hidden" 
			data-name={ strings.TrimSpace(user.FirstName + " " + user.LastName) } 
			data-country={ user.DefaultCountry } 
			data-country-name={ getCountryName(user.DefaultCountry) }>
		</div>

		<script src="/assets/scripts/main_ui.js"></script>
	}
}