package base

import "ujuzi_reloaded/app/backend/auth"
import "ujuzi_reloaded/app/backend/ui/layout"
import "strings"
import "strconv"
import "sort"
import "encoding/base64"

func getFlagUrl(code string) string {
	code = strings.ToLower(code)
	if code == "" { return "https://flagcdn.com/w40/za.png" }
	return "https://flagcdn.com/w40/" + code + ".png"
}

func getCountryName(code string) string {
	code = strings.ToLower(code)
	names := map[string]string{
		"za": "South Africa", "ke": "Kenya", "ug": "Uganda", "tz": "Tanzania", "zm": "Zambia",
	}
	if name, ok := names[code]; ok { return name }
	return strings.ToUpper(code)
}

func getHighestGroup(userGroups []string, allGroups []auth.Group) string {
	if len(userGroups) == 0 {
		return "UNASSIGNED"
	}
	
	var assigned []auth.Group
	for _, ug := range userGroups {
		for _, g := range allGroups {
			if g.ID == ug {
				assigned = append(assigned, g)
			}
		}
	}
	
	if len(assigned) == 0 {
		return "UNASSIGNED"
	}
	
	sort.Slice(assigned, func(i, j int) bool {
		li, _ := strconv.Atoi(strings.TrimSpace(assigned[i].Level))
		lj, _ := strconv.Atoi(strings.TrimSpace(assigned[j].Level))
		return li < lj 
	})
	
	return strings.ToUpper(assigned[0].Name)
}

func hasAdminGroup(userGroups []string, allGroups []auth.Group) bool {
	for _, ug := range userGroups {
		for _, g := range allGroups {
			if g.ID == ug && strings.Contains(strings.ToLower(g.Name), "admin") {
				return true
			}
		}
	}
	return false
}

func getUserDashboardsByArea(user auth.User, allGroups []auth.Group, allDashboards []auth.Dashboard) map[string][]auth.Dashboard {
	dashMap := make(map[string]bool)
	for _, ug := range user.Groups {
		for _, g := range allGroups {
			if g.ID == ug {
				for _, did := range g.Dashboards {
					dashMap[did] = true
				}
			}
		}
	}

	areaMap := make(map[string][]auth.Dashboard)
	for _, d := range allDashboards {
		if dashMap[d.ID] {
			areaMap[d.Area] = append(areaMap[d.Area], d)
		}
	}
	return areaMap
}

func getToolUrl(toolName string) string {
	switch toolName {
	case "Campaigns":
		return "/tools/campaigns"
	case "Unifi Words":
		return "/tools/unifi-words"
	case "Credit Policy":
		return "/tools/credit-policy"
	case "Targets":
		return "/targets"
	case "Dataform":
		return "/tools/dataform"
	default:
		return "/tools/" + strings.ToLower(strings.ReplaceAll(toolName, " ", "-"))
	}
}

type SearchItem struct {
	Name   string          `json:"name"`
	Url    string          `json:"url"`
	Code   string          `json:"code"`
	Type   string          `json:"type"`
	IsTool bool            `json:"isTool"`
	Params auth.DashParams `json:"params,omitempty"`
}

func buildSearchData(user auth.User, allGroups []auth.Group, allDashboards []auth.Dashboard) []SearchItem {
	items := []SearchItem{}

	if hasAdminGroup(user.Groups, allGroups) {
		items = append(items, SearchItem{Name: "User Management", Url: "/admin/management", Type: "Admin", IsTool: false})
		items = append(items, SearchItem{Name: "Dashboard Management", Url: "/admin/dashboards", Type: "Admin", IsTool: false})
	}

	for _, areaDashes := range getUserDashboardsByArea(user, allGroups, allDashboards) {
		for _, d := range areaDashes {
			items = append(items, SearchItem{Name: d.Name, Url: d.ReportURL, Type: "Dashboard", IsTool: false, Params: d.Parameters})
			for _, p := range d.Pages {
				items = append(items, SearchItem{Name: d.Name + " - " + p.Name, Url: d.ReportURL, Code: p.Code, Type: "Page", IsTool: false, Params: d.Parameters})
			}
		}
	}

	for _, t := range user.Tools {
		items = append(items, SearchItem{Name: t, Url: getToolUrl(t), Type: "Tool", IsTool: true})
	}

	return items
}

type TopApp struct {
	Name string
	Url  string
}

func getTopApps(user auth.User) []TopApp {
	type kv struct {
		Key   string
		Value int
	}
	var sorted []kv
	
	for k, v := range user.DashboardClicks {
		sorted = append(sorted, kv{Key: k, Value: v})
	}
	
	sort.Slice(sorted, func(i, j int) bool {
		return sorted[i].Value > sorted[j].Value
	})
	
	tops := []TopApp{
		{Name: "Shake The Tree", Url: "https://datastudio.google.com/embed/reporting/d179f56a-8312-48b7-a396-21758314bbe9/page/p_596g9ngm3d"},
	}
	
	for _, item := range sorted {
		if len(tops) >= 5 {
			break
		}
		
		// Try RawURLEncoding first, fallback to standard URLEncoding, then raw string
		decodedBytes, err := base64.RawURLEncoding.DecodeString(item.Key)
		var rawKey string
		if err != nil {
			dec2, err2 := base64.URLEncoding.DecodeString(item.Key)
			if err2 != nil {
				rawKey = item.Key
			} else {
				rawKey = string(dec2)
			}
		} else {
			rawKey = string(decodedBytes)
		}
		
		parts := strings.Split(rawKey, "|#|")
		if len(parts) == 2 {
			if parts[0] == "Shake The Tree" {
				continue
			}
			tops = append(tops, TopApp{Name: parts[0], Url: parts[1]})
		}
	}
	
	return tops
}

type FavItem struct {
	Identifier string
	Name       string
	Url        string
	Type       string
	Code       string
	Params     auth.DashParams
}

func getValidFavorites(user auth.User, allGroups []auth.Group, allDashboards []auth.Dashboard) []FavItem {
	accessible := make(map[string]FavItem)
	
	for _, areaDashes := range getUserDashboardsByArea(user, allGroups, allDashboards) {
		for _, d := range areaDashes {
			accessible["Dashboard:"+d.ID] = FavItem{Name: d.Name, Url: d.ReportURL, Type: "Dashboard", Params: d.Parameters}
			for _, p := range d.Pages {
				accessible["Page:"+d.ID+":"+p.Code] = FavItem{Name: d.Name + " - " + p.Name, Url: d.ReportURL, Code: p.Code, Type: "Page", Params: d.Parameters}
			}
		}
	}
	for _, t := range user.Tools {
		accessible["Tool:"+t] = FavItem{Name: t, Url: getToolUrl(t), Type: "Tool"}
	}

	var valid []FavItem
	for _, favId := range user.Favorites {
		if item, ok := accessible[favId]; ok {
			item.Identifier = favId
			valid = append(valid, item)
		}
	}
	return valid
}

func isFavorite(favorites []string, identifier string) bool {
	for _, f := range favorites {
		if f == identifier { return true }
	}
	return false
}

templ homePage(user auth.User, allGroups []auth.Group, allDashboards []auth.Dashboard) {
	@layout.HtmlFullPage("Ujuzi Platform - NextGen") {
		<link rel="stylesheet" href="/assets/styles/main_ui.css"/>
		<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

		@templ.JSONScript("search-db", buildSearchData(user, allGroups, allDashboards))
		@templ.JSONScript("user-favorites-data", user.Favorites)

		<div id="ujuzi-menu-btn" class="fixed top-0 left-0 z-[1000] transition-all duration-300" onclick="setSidebarState('active')">
			<div class="bg-red-600 text-white px-6 py-2 rounded-br-md text-[10px] font-bold uppercase tracking-widest cursor-pointer shadow-md transition-colors hover:bg-red-700 leading-tight">
				Ujuzi - Menu
			</div>
		</div>

		<div class="fixed top-0 left-1/2 -translate-x-1/2 z-[1000] group flex flex-col items-center">
			<div class="bg-red-600 text-white px-8 py-2 rounded-b-md text-[10px] font-bold uppercase tracking-widest cursor-pointer shadow-md transition-colors group-hover:bg-red-700 leading-tight">
				Top 5
			</div>
			<div class="pt-2 hidden group-hover:flex flex-col items-center absolute top-full">
				<div class="bg-white/95 backdrop-blur-md border border-gray-200 rounded-2xl shadow-2xl p-4 flex flex-row gap-4 items-start min-w-[200px]">
					for _, app := range getTopApps(user) {
						<button class="w-20 h-20 shrink-0 rounded-full bg-green-x-light/10 border-2 border-green-x-dark text-green-x-dark text-[10px] font-bold uppercase tracking-wider p-2 flex flex-col items-center justify-center text-center transition-all duration-300 hover:bg-green-x-dark hover:text-white hover:-translate-y-1 shadow-md break-words whitespace-normal leading-tight"
							data-name={ app.Name }
							data-url={ app.Url }
							onclick="window.handleAppBtnClick(event, this)">
							<span>{ app.Name }</span>
						</button>
					}
				</div>
			</div>
		</div>

		<div class="fixed top-0 right-0 z-[1000] group flex flex-col items-end">
			<div class="bg-red-600 text-white px-6 py-2 rounded-bl-md text-[10px] font-bold uppercase tracking-widest cursor-pointer shadow-md transition-colors group-hover:bg-red-700 leading-tight">
				My Favorites
			</div>
			<div class="pt-2 hidden group-hover:flex flex-col items-end absolute top-full right-0 w-72 pr-2">
				<div class="bg-white border border-gray-200 rounded-lg shadow-2xl flex flex-col w-full overflow-hidden" id="my-favorites-list">
					
					<div id="my-favorites-empty" class="text-gray-400 text-xs font-bold px-5 py-6 text-center" style={ templ.KV("display: none", len(getValidFavorites(user, allGroups, allDashboards)) > 0) }>
						No favorites yet. Click the star next to a dashboard or tool to add one!
					</div>

					for _, fav := range getValidFavorites(user, allGroups, allDashboards) {
						<div class="fav-item flex items-center justify-between px-4 py-3 border-b border-gray-100 hover:bg-gray-50 cursor-grab group/favitem transition-colors bg-white" data-id={ fav.Identifier }>
							<div class="flex items-center gap-3 overflow-hidden flex-1 cursor-pointer"
								data-name={ fav.Name }
								data-url={ fav.Url }
								data-type={ fav.Type }
								data-code={ fav.Code }
								data-p-country={ fav.Params.CountryCode }
								data-p-branch={ fav.Params.Branch }
								data-p-consultant={ fav.Params.Consultant }
								data-p-cycle={ fav.Params.Cycle }
								data-p-prev={ fav.Params.PrevCycle }
								data-p-date={ fav.Params.Date }
								data-p-period={ fav.Params.Period }
								onclick="window.handleFavBtnClick(event, this)">
								<span class="text-xs font-bold text-gray-700 truncate">{ fav.Name }</span>
							</div>
							<button class="text-gray-300 hover:text-red-500 transition-colors w-5 h-5 flex items-center justify-center shrink-0"
								onclick={ templ.ComponentScript{Call: "window.removeFavorite(event, this, '" + fav.Identifier + "')"} }>
								<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
								</svg>
							</button>
						</div>
					}
				</div>
			</div>
		</div>

		<div id="main-view-container" class="absolute inset-2 md:inset-4 border border-gray-200/60 rounded-xl shadow-2xl bg-white overflow-hidden flex z-10">
			<style>
				@keyframes tree-grow {
					0%   { clip-path: inset(100% 0 0 0); transform: scale(0.45); opacity: 0.4; }
					60%  { clip-path: inset(12% 0 0 0); transform: scale(1.04); opacity: 1; }
					100% { clip-path: inset(0 0 0 0); transform: scale(1); opacity: 1; }
				}
				#iframe-loading .tree-loader {
					transform-origin: 50% 100%;
					animation: tree-grow 2.4s cubic-bezier(.22, .9, .3, 1) infinite alternate;
					will-change: clip-path, transform;
				}
			</style>
			<div
				id="iframe-loading"
				class="fixed inset-0 hidden grid place-items-center bg-white/95 border-2 border-red-x-light pointer-events-none transition-opacity duration-300 opacity-0"
				style="z-index: 500;"
				aria-live="polite"
			>
				<div class="text-center">
					<svg
						class="tree-loader w-28 h-28 mb-4 text-red-x-dark mx-auto"
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 361.43 362.69"
						fill="currentColor"
						aria-hidden="true"
					>
					<path d="M95.71,199.74l10.34,9.1c1.03.9,2.37,1.36,3.74,1.27l9.1-.58s0,0,0,0c-.4-6.2-5.75-10.91-11.95-10.51l-11.23.72s0,0,0,0M90.71,186.4l9.1-.56s0,0,0,0c-.39-6.2-5.73-10.92-11.93-10.54l-11.23.7s0,0,0,0l10.33,9.12c1.03.9,2.37,1.37,3.73,1.28M87.35,219.73l-10.4,4.3s0,0,0,0l12.72,5.28c1.26.53,2.68.53,3.95,0l8.43-3.48s0,0,0,0c-2.38-5.74-8.96-8.48-14.7-6.1M58.39,194.68s0,0,0,0l10.33,9.12c1.02.9,2.37,1.37,3.73,1.28l9.1-.56s0,0,0,0c-.39-6.2-5.73-10.92-11.93-10.54l-11.23.7ZM52.64,168.49l-11.22.9s0,0,0,0l10.49,8.93c1.04.89,2.39,1.32,3.76,1.21l9.09-.73s0,0,0,0c-.5-6.2-5.92-10.81-12.12-10.32M71.67,158.09c3.16-5.35,1.38-12.25-3.98-15.41l-9.69-5.72s0,0,0,0l3.44,13.34c.34,1.32,1.2,2.46,2.37,3.15l7.85,4.63s0,0,0,0M83.89,132.34c4.44-4.35,4.52-11.47.17-15.92l-7.87-8.04s0,0,0,0l-.15,13.78c-.02,1.37.51,2.68,1.47,3.66l6.38,6.52s0,0,0,0M99.92,168.9c3.26-5.3,1.6-12.23-3.69-15.48l-9.58-5.89s0,0,0,0l3.2,13.4c.32,1.33,1.15,2.48,2.32,3.2l7.77,4.78s0,0,0,0M109.95,129.97l-7.57-8.32s0,0,0,0l-.65,13.76c-.06,1.37.42,2.7,1.34,3.71l6.14,6.74h0c4.6-4.18,4.93-11.3.74-15.9M116.56,113.06c4.57-4.22,4.85-11.34.63-15.9l-7.63-8.27s0,0,0,0l-.55,13.76c-.05,1.37.44,2.7,1.36,3.7l6.19,6.7s0,0,0,0M122.15,145.88l-.65,13.76c-.06,1.37.42,2.7,1.34,3.71l6.14,6.74s0,0,0,0c4.6-4.18,4.93-11.3.75-15.9l-7.58-8.32s0,0,0,0M136.26,91.05c3.04-5.42,1.11-12.28-4.31-15.32l-9.82-5.5s0,0,0,0l3.73,13.26c.37,1.32,1.25,2.43,2.44,3.1l7.95,4.46s0,0,0,0M136.34,122.16l-6.85-8.93s0,0,0,0l-1.8,13.66c-.18,1.36.19,2.73,1.02,3.81l5.55,7.24s0,0,0,0c4.93-3.78,5.86-10.85,2.08-15.78M156.22,62l-5.45-9.85s0,0,0,0l-3.81,13.24c-.38,1.31-.22,2.72.44,3.92l4.41,7.98s0,0,0,0c5.44-3.01,7.41-9.86,4.4-15.3M157.83,102.1l-5.25-9.95s0,0,0,0l-4.07,13.16c-.4,1.31-.27,2.72.36,3.93l4.25,8.07s0,0,0,0c5.5-2.9,7.6-9.71,4.7-15.21M165.92,135.32l-5.25-9.95s0,0,0,0l-4.07,13.16c-.4,1.31-.27,2.72.36,3.93l4.25,8.07s0,0,0,0c5.5-2.9,7.6-9.71,4.7-15.21M177.82,78.35l-3.63-10.65s0,0,0,0l-6.08,12.36c-.6,1.23-.69,2.64-.25,3.94l2.94,8.63s0,0,0,0c5.88-2.01,9.03-8.4,7.02-14.28M26