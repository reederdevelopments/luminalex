package kb

import (
	"controlroom/app/backend/ui/layout"
	"time"
)

script openNewPageModalScript(projectID string, parentID string) {
	window.openNewPageModal(projectID, parentID);
}

script toggleMenuScript(menuId string) {
	window.toggleMenu(menuId);
}

script togglePageTreeScript(id string) {
	window.togglePageTree(id);
}

script promptRenameScript(id string, title string) {
	window.promptRename(id, title);
}

templ renderPageTree(pages []Page, parentID string, activeID string, projectID string) {
	<div class={ "sortable-list flex flex-col w-full", templ.KV("pl-3 border-l border-gray-200 ml-2 gap-0.5 mt-0.5", hasChildren(pages, parentID)) } data-parent-id={ parentID } data-project-id={ projectID }>
		for _, p := range pages {
			if p.ParentID == parentID {
				<div class="page-item group/item flex flex-col w-full" data-id={ p.ID }>
					<div class={ "flex items-center justify-between px-2 py-1 rounded-md text-xs transition-colors w-full", templ.KV("bg-blue-50 text-blue-700 font-medium", activeID == p.ID), templ.KV("text-gray-600 hover:bg-gray-100", activeID != p.ID) }>
						<div class="flex items-center gap-1.5 cursor-grab w-full pr-2">
							if hasChildren(pages, p.ID) {
								<button onclick={ togglePageTreeScript(p.ID) } class="p-0.5 text-gray-400 hover:text-gray-800 transition-colors rounded hover:bg-gray-200">
									<svg id={ "chevron-" + p.ID } xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3 transition-transform rotate-90"><path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06l4.25-4.25a.75.75 0 000-1.06l-4.25-4.25z" /></svg>
								</button>
							} else {
								<span class="w-4"></span>
							}
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3 h-3 text-gray-400 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5" /></svg>
							<a href={ templ.SafeURL("/kb/page/" + p.ID) } class="whitespace-nowrap leading-tight py-1 truncate flex-1">📄 { p.Title }</a>
						</div>
						<div class="flex items-center gap-1 opacity-0 group-hover/item:opacity-100 transition-opacity">
							<button type="button" onclick={ openNewPageModalScript(p.ProjectID, p.ID) } class="text-gray-400 hover:text-blue-600 transition-colors p-1">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
							</button>
							<div class="relative ellipsis-container">
								<button type="button" onclick={ toggleMenuScript("menu-" + p.ID) } class="text-gray-400 hover:text-gray-800 transition-colors p-1 rounded hover:bg-gray-200">
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 12.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 18.75a.75.75 0 110-1.5.75.75 0 010 1.5z" /></svg>
								</button>
								<div id={ "menu-" + p.ID } class="ellipsis-menu hidden absolute left-0 md:left-auto md:right-0 top-full mt-1 w-36 bg-white border border-gray-200 rounded-md shadow-xl z-[100] py-1 overflow-hidden">
									<button type="button" onclick={ promptRenameScript(p.ID, p.Title) } class="w-full text-left px-4 py-2 text-xs font-semibold text-gray-700 hover:bg-gray-100 flex items-center gap-2">
										<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" /></svg>
										Rename
									</button>
									<form action={ templ.SafeURL("/kb/page/" + p.ID + "/delete") } method="POST" class="m-0">
										<button type="submit" class="w-full text-left px-4 py-2 text-xs font-semibold text-red-600 hover:bg-red-50 flex items-center gap-2" onclick="return confirm('Are you sure you want to delete this page?')">
											<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
											Delete
										</button>
									</form>
								</div>
							</div>
						</div>
					</div>
					<div id={ "tree-" + p.ID }>
						@renderPageTree(pages, p.ID, activeID, projectID)
					</div>
				</div>
			}
		}
	</div>
}

templ kbLayout(projects []Project, pagesByProject map[string][]Page, activePage *Page, history []PageHistory, isEditMode bool) {
	@layout.HtmlFullPage("Knowledge Base") {
		<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
		<script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.3/tinymce.min.js"></script>
		<link rel="stylesheet" href="/assets/styles/main_ui.css"/>

		<style>
			.ql-align-center { text-align: center !important; }
			.ql-align-right { text-align: right !important; }
			.ql-align-justify { text-align: justify !important; }
		</style>

		<script type="text/javascript">
			window.openNewPageModal = function(projectID, parentID) {
				document.getElementById('new-page-project').value = projectID;
				document.getElementById('new-page-parent').value = parentID;
				document.getElementById('new-page-modal').showModal();
			};

			window.toggleMenu = function(menuId) {
				if (window.event) {
					window.event.preventDefault();
					window.event.stopPropagation();
				}
				document.querySelectorAll('.ellipsis-menu').forEach(menu => {
					if (menu.id !== menuId) menu.classList.add('hidden');
				});
				const menu = document.getElementById(menuId);
				if (menu) menu.classList.toggle('hidden');
			};

			window.togglePageTree = function(id) {
				const tree = document.getElementById('tree-' + id);
				const chevron = document.getElementById('chevron-' + id);
				if (tree) {
					tree.classList.toggle('hidden');
					if (chevron) {
						chevron.classList.toggle('rotate-90');
					}
				}
			};

			window.promptRename = function(id, oldTitle) {
				document.getElementById('rename-page-id').value = id;
				document.getElementById('rename-page-title').value = oldTitle;
				document.getElementById('rename-form').action = `/kb/page/${id}/rename`;
				document.getElementById('rename-modal').showModal();
			};

			window.toggleKBSidebar = function() {
				const sidebar = document.getElementById('kb-sidebar');
				const btn = document.getElementById('kb-sidebar-toggle-btn');
				const icon = document.getElementById('kb-sidebar-icon');
				
				if (sidebar.classList.contains('w-0')) {
					sidebar.classList.remove('w-0', 'border-0', 'opacity-0');
					sidebar.classList.add('w-64', 'border-r', 'opacity-100');
					btn.classList.remove('left-0');
					btn.classList.add('left-64');
					icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />';
				} else {
					sidebar.classList.remove('w-64', 'border-r', 'opacity-100');
					sidebar.classList.add('w-0', 'border-0', 'opacity-0');
					btn.classList.remove('left-64');
					btn.classList.add('left-0');
					icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />';
				}
			};

			window.insertKBLink = function() {
				const select = document.getElementById('kb-link-select');
				const url = select.value;
				const title = select.options[select.selectedIndex].text;
				
				if (url && tinymce.activeEditor) {
					tinymce.activeEditor.insertContent(`<a href="${url}">${title}</a>`);
				}
				document.getElementById('kb-link-modal').close();
				select.value = '';
			};

			document.addEventListener('DOMContentLoaded', function() {
				document.addEventListener('click', function(e) {
					if (!e.target.closest('.ellipsis-container')) {
						document.querySelectorAll('.ellipsis-menu').forEach(menu => menu.classList.add('hidden'));
					}
				});

				if (typeof Sortable !== 'undefined') {
					const projectsList = document.getElementById('projects-list');
					if (projectsList) {
						new Sortable(projectsList, {
							animation: 150,
							handle: '.project-drag-handle',
							onEnd: function(evt) {
								const itemEl = evt.item;
								const projectId = itemEl.dataset.projectId;
								const newOrder = evt.newIndex;
								
								const params = new URLSearchParams();
								params.append('order', newOrder);
								
								fetch(`/kb/project/${projectId}/move`, {
									method: 'POST',
									body: params.toString(),
									headers: {
										'Content-Type': 'application/x-www-form-urlencoded',
										'X-Requested-With': 'XMLHttpRequest'
									}
								});
							}
						});
					}

					document.querySelectorAll('.sortable-list').forEach(el => {
						new Sortable(el, {
							group: 'shared-kb-tree',
							animation: 150,
							fallbackOnBody: true,
							swapThreshold: 0.65,
							emptyInsertThreshold: 20,
							onEnd: function (evt) {
								const itemEl = evt.item;
								const newParentList = evt.to;
								const pageId = itemEl.dataset.id;
								
								const newParentId = newParentList.dataset.parentId || "";
								const newProjectId = newParentList.dataset.projectId || newParentList.closest('.project-container').dataset.projectId;
								const newOrder = evt.newIndex;
								
								const params = new URLSearchParams();
								params.append('parent_id', newParentId);
								params.append('project_id', newProjectId);
								params.append('order', newOrder);
								
								fetch(`/kb/page/${pageId}/move`, { 
									method: 'POST', 
									body: params.toString(),
									headers: { 
										'Content-Type': 'application/x-www-form-urlencoded',
										'X-Requested-With': 'XMLHttpRequest' 
									}
								}).then(() => {
									window.location.reload();
								});
							}
						});
					});
				}

				const isEditMode = document.getElementById('is-edit-mode') !== null;
				if (isEditMode && document.getElementById('kb-editor-container')) {
					tinymce.init({
						selector: '#kb-editor-container',
						plugins: 'preview searchreplace autolink directionality visualblocks visualchars fullscreen image link media template table charmap pagebreak nonbreaking anchor insertdatetime advlist lists wordcount emoticons accordion',
						toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | forecolor backcolor highlight | alignleft aligncenter alignright alignjustify | outdent indent | numlist bullist checklist | table image media link anchor kblink | hr pagebreak | emoticons template accordion | fullscreen preview removeformat',
						menubar: 'file edit view insert format tools table help',
						height: 'calc(100vh - 250px)',
						promotion: false,
						branding: false,
						image_advtab: true,
						image_class_list: [
							{title: 'None', value: ''},
							{title: 'Rounded', value: 'rounded-lg'},
							{title: 'Shadow', value: 'shadow-md'}
						],
						advlist_bullet_styles: 'square,default',
						advlist_number_styles: 'default,lower-alpha,lower-roman',
						content_style: 'body { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 16px; line-height: 1.6; color: #374151; padding: 1rem; }',
						templates: [
							{ title: 'Info Panel', description: 'Creates an info callout box', content: '<div class="bg-blue-50 border-l-4 border-blue-500 p-4 my-4 rounded-r-lg"><p class="text-sm text-blue-700 m-0"><strong>ℹ️ Info:</strong> Add your info text here...</p></div>' },
							{ title: 'Warning Panel', description: 'Creates a warning callout box', content: '<div class="bg-yellow-50 border-l-4 border-yellow-500 p-4 my-4 rounded-r-lg"><p class="text-sm text-yellow-700 m-0"><strong>⚠️ Warning:</strong> Add your warning text here...</p></div>' },
							{ title: 'Success Panel', description: 'Creates a success callout box', content: '<div class="bg-green-50 border-l-4 border-green-500 p-4 my-4 rounded-r-lg"><p class="text-sm text-green-700 m-0"><strong>✅ Success:</strong> Add your success text here...</p></div>' },
							{ title: 'Table of Contents (TOC)', description: 'Inserts the TOC macro', content: '<p>{' + '{TOC}}</p>' },
							{ title: 'Status Badge (Done)', description: 'Inserts a green badge', content: '<span class="inline-flex items-center px-2 py-1 rounded text-xs font-bold bg-green-100 text-green-800">Done</span>' },
							{ title: 'Status Badge (Pending)', description: 'Inserts a yellow badge', content: '<span class="inline-flex items-center px-2 py-1 rounded text-xs font-bold bg-yellow-100 text-yellow-800">Pending</span>' }
						],
						setup: function(editor) {
							editor.ui.registry.addButton('kblink', {
								icon: 'link',
								tooltip: 'Link Internal KB Page',
								onAction: function (_) {
									document.getElementById('kb-link-modal').showModal();
								}
							});
						}
					});
				} else {
					document.querySelectorAll('.prose a').forEach(a => {
						const href = a.getAttribute('href');
						if (href && (href.startsWith('/') || href.includes(window.location.host))) {
							a.removeAttribute('target');
						}
					});
				}
			});
		</script>

		if isEditMode {
			<div id="is-edit-mode" class="hidden"></div>
		}

		<div class="h-screen w-full bg-white flex overflow-hidden font-sans relative">
			<div id="kb-sidebar" class="bg-gray-50 border-r border-gray-200 flex flex-col shrink-0 relative z-20 shadow-sm transition-all duration-300 w-64 opacity-100">
				<div class="p-4 border-b border-gray-200 flex items-center justify-between bg-white sticky top-0 z-10 w-full shrink-0">
					<h2 class="font-bold text-gray-800 text-sm tracking-wide flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-blue-600"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>
						Projects
					</h2>
					<button type="button" onclick="document.getElementById('new-project-modal').showModal()" class="bg-gray-100 text-gray-600 hover:bg-blue-600 hover:text-white p-1 rounded transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
					</button>
				</div>
				<div id="projects-list" class="flex-1 overflow-y-auto overflow-x-hidden hide-scrollbar p-2 pb-10 w-full flex flex-col gap-0.5">
					for _, proj := range projects {
						<div class="project-container w-full" data-project-id={ proj.ID }>
							<div class="group flex items-center justify-between px-2 py-1.5 rounded-md hover:bg-gray-200 cursor-pointer text-gray-800 project-drag-handle">
								<span class="font-black text-xs uppercase tracking-wider">{ proj.Name }</span>
								<div class="flex items-center opacity-0 group-hover:opacity-100 transition-opacity gap-1">
									<button type="button" onclick={ openNewPageModalScript(proj.ID, "") } class="text-gray-400 hover:text-blue-600 transition-colors p-1">
										<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
									</button>
								</div>
							</div>
							if pages, exists := pagesByProject[proj.ID]; exists {
								if activePage != nil {
									@renderPageTree(pages, "", activePage.ID, proj.ID)
								} else {
									@renderPageTree(pages, "", "", proj.ID)
								}
							} else {
								<div class="text-[10px] text-gray-400 px-2 mt-1 italic sortable-list min-h-[25px] pb-2 w-full" data-parent-id="" data-project-id={ proj.ID }>Drag pages here</div>
							}
						</div>
					}
					if len(projects) == 0 {
						<div class="text-xs text-center text-gray-400 mt-10 w-full">No projects exist.</div>
					}
				</div>
			</div>

			<button type="button" onclick="window.toggleKBSidebar()" id="kb-sidebar-toggle-btn" class="absolute left-64 -ml-3.5 top-5 bg-white border border-gray-200 rounded-full p-1.5 shadow hover:text-blue-600 z-[100] text-gray-400 transition-all duration-300">
				<svg id="kb-sidebar-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
				</svg>
			</button>

			<div class="flex-1 flex bg-white overflow-hidden relative pl-4">
				if activePage != nil {
					<div class="flex-1 overflow-y-auto hide-scrollbar flex justify-center bg-white px-8 md:px-12 py-10 relative">
						if isEditMode {
							<form id="save-form" action={ templ.SafeURL("/kb/page/" + activePage.ID + "/save") } method="POST" class="w-full flex flex-col h-full animate-fade-in relative max-w-screen-2xl mx-auto">
								<input type="text" name="title" value={ activePage.Title } class="text-4xl font-black text-gray-900 border-0 focus:ring-0 p-0 bg-transparent w-full" placeholder="Document Title..."/>
								<hr class="w-full border-gray-200 mt-4 mb-6"/>
								<textarea id="kb-editor-container" name="content" class="w-full border border-gray-200 rounded-b-lg p-4 min-h-[400px] text-base text-gray-900 font-sans focus:outline-none hidden">
									{ activePage.Content }
								</textarea>
							</form>
						} else {
							<div class="w-full flex flex-col h-full animate-fade-in relative max-w-screen-2xl mx-auto">
								<div class="absolute top-0 right-0 flex items-center gap-2">
									<a href={ templ.SafeURL("/kb/page/" + activePage.ID + "/edit") } class="bg-white border border-gray-200 text-gray-600 hover:text-blue-600 hover:border-blue-600 px-4 py-1.5 rounded text-xs font-bold shadow-sm transition-all flex items-center gap-1.5">
										<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" /></svg>
										Edit Page
									</a>
									<form action={ templ.SafeURL("/kb/page/" + activePage.ID + "/delete") } method="POST" class="m-0">
										<button type="submit" onclick="return confirm('Are you sure you want to delete this page?')" class="bg-white border border-gray-200 text-red-500 hover:bg-red-50 hover:border-red-500 px-3 py-1.5 rounded text-xs font-bold shadow-sm transition-all flex items-center gap-1.5">
											<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
										</button>
									</form>
								</div>
								<div class="mb-4">
									<h1 class="text-4xl font-black text-gray-900 pr-40">{ activePage.Title }</h1>
									<div class="mt-4 flex items-center gap-2 text-xs text-gray-400">
										<span>Last edited by <strong>{ activePage.UpdatedBy }</strong> on { time.Unix(activePage.UpdatedAt, 0).Format("Jan 02, 2006") }</span>
									</div>
								</div>
								<hr class="w-full border-gray-200 mb-6"/>
								<div class="prose prose-blue max-w-none w-full pb-20">
									@templ.Raw(activePage.Content)
								</div>
							</div>
						}
					</div>

					if isEditMode {
						<div class="w-80 bg-gray-50 border-l border-gray-200 shrink-0 flex flex-col hide-scrollbar shadow-inner overflow-y-auto">
							<div class="p-4 border-b border-gray-200 bg-white sticky top-0 flex items-center justify-between z-10 shrink-0 shadow-sm">
								<span class="text-sm font-bold text-gray-800">Edit Mode</span>
								<div class="flex gap-2">
									<a href={ templ.SafeURL("/kb/page/" + activePage.ID) } class="bg-gray-100 hover:bg-gray-200 text-gray-600 px-3 py-1.5 rounded text-xs font-bold transition-all">Cancel</a>
									<button form="save-form" type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-1.5 rounded text-xs font-bold shadow transition-all">Publish</button>
								</div>
							</div>

							<details class="group border-b border-gray-200">
								<summary class="flex justify-between items-center font-bold cursor-pointer list-none px-4 py-3 text-xs uppercase tracking-widest text-gray-500 hover:bg-gray-100 transition-colors">
									Page Actions
									<span class="transition group-open:rotate-180">
										<svg fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="16"><path d="M6 9l6 6 6-6"></path></svg>
									</span>
								</summary>
								<div class="text-neutral-600 px-4 pb-4 bg-gray-50 flex flex-col gap-2">
									<button type="button" onclick="tinymce.activeEditor.execCommand('mcePreview');" class="w-full flex items-center gap-2 text-xs font-semibold text-gray-600 hover:text-green-600 hover:bg-green-50 transition-colors bg-white border border-gray-200 rounded px-3 py-2 text-left shadow-sm">
										<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
										Preview Page
									</button>
									<button type="button" onclick={ promptRenameScript(activePage.ID, activePage.Title) } class="w-full flex items-center gap-2 text-xs font-semibold text-gray-600 hover:text-blue-600 hover:bg-blue-50 transition-colors bg-white border border-gray-200 rounded px-3 py-2 text-left shadow-sm">
										<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" /></svg>
										Rename Page
									</button>
									<form action={ templ.SafeURL("/kb/page/" + activePage.ID + "/delete") } method="POST" class="m-0 w-full">
										<button type="submit" class="w-full flex items-center gap-2 text-xs font-semibold text-red-600 hover:bg-red-50 transition-colors bg-white border border-red-200 rounded px-3 py-2 text-left shadow-sm" onclick="return confirm('Are you sure you want to delete this page?')">
											<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
											Delete Page
										</button>
									</form>
								</div>
							</details>

							<details class="group border-b border-gray-200" open>
								<summary class="flex justify-between items-center font-bold cursor-pointer list-none px-4 py-3 text-xs uppercase tracking-widest text-gray-500 hover:bg-gray-100 transition-colors">
									Change History
									<span class="transition group-open:rotate-180">
										<svg fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="16"><path d="M6 9l6 6 6-6"></path></svg>
									</span>
								</summary>
								<div class="px-4 pb-4 bg-gray-50 flex flex-col gap-5">
									<div class="flex flex-col gap-1">
										<span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Last Edited</span>
										<span class="text-xs font-semibold text-gray-800">{ activePage.UpdatedBy }</span>
										<span class="text-[10px] text-gray-500">{ time.Unix(activePage.UpdatedAt, 0).Format("Jan 02, 2006 15:04") }</span>
									</div>
									<div>
										<div class="max-h-64 overflow-y-auto hide-scrollbar pr-2">
											<div class="flex flex-col gap-4 relative border-l-2 border-gray-200 ml-2 pl-4 py-1">
												for i, h := range history {
													<div class="relative">
														<div class="absolute -left-[21.5px] top-1 w-2.5 h-2.5 rounded-full bg-blue-500 ring-4 ring-gray-50"></div>
														<div class="text-[11px] font-bold text-gray-700">{ h.UpdatedBy }</div>
														<div class="text-[9px] text-gray-500">{ time.Unix(h.UpdatedAt, 0).Format("Jan 02, 15:04") }</div>
														if i == 0 {
															<div class="text-[9px] font-bold text-blue-600 mt-1 bg-blue-50 inline-block px-1.5 py-0.5 rounded border border-blue-100">Latest</div>
														}
													</div>
												}
												if len(history) == 0 {
													<div class="text-xs text-gray-400 italic -ml-2">No previous edits.</div>
												}
											</div>
										</div>
									</div>
								</div>
							</details>
						</div>
					}

					<dialog id="rename-modal" class="backdrop:bg-black/40 p-6 rounded-xl shadow-2xl w-full max-w-sm bg-white border border-gray-200 m-auto z-[9999]">
						<h3 class="text-lg font-bold text-gray-800 mb-4">Rename Page</h3>
						<form id="rename-form" action="" method="POST" class="flex flex-col gap-4">
							<input type="hidden" id="rename-page-id"/>
							<input type="text" name="title" id="rename-page-title" required class="w-full text-sm p-2 rounded-md border-gray-300 focus:border-blue-500 focus:ring-blue-500 bg-gray-50"/>
							<div class="flex justify-end gap-2 mt-2 pt-4 border-t border-gray-100">
								<button type="button" onclick="document.getElementById('rename-modal').close()" class="px-4 py-2 text-xs font-bold text-gray-500 hover:bg-gray-100 rounded-md transition-colors">Cancel</button>
								<button type="submit" class="px-4 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-md shadow-sm transition-colors">Rename</button>
							</div>
						</form>
					</dialog>
				} else {
					<div class="flex-1 flex flex-col items-center justify-center text-gray-400 bg-gray-50/50">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-24 h-24 mb-4 opacity-20 text-blue-500"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" /></svg>
						<h2 class="text-xl font-bold text-gray-600 mb-2">Knowledge Base</h2>
						<p class="text-sm">Select a page from the sidebar or create a new one.</p>
					</div>
				}
			</div>
		</div>

		<dialog id="new-project-modal" class="backdrop:bg-black/40 p-6 rounded-xl shadow-2xl w-full max-w-sm bg-white border border-gray-200 m-auto z-[9999]">
			<h3 class="text-lg font-bold text-gray-800 mb-4">Create New Project</h3>
			<form action="/kb/project/create" method="POST" class="flex flex-col gap-4">
				<div>
					<label class="block text-xs font-bold text-gray-600 mb-1">Project Name</label>
					<input type="text" name="name" required class="w-full text-sm p-2 rounded-md border-gray-300 focus:border-blue-500 focus:ring-blue-500 bg-gray-50" placeholder="e.g. Platform Engineering"/>
				</div>
				<div class="flex justify-end gap-2 mt-2 pt-4 border-t border-gray-100">
					<button type="button" onclick="document.getElementById('new-project-modal').close()" class="px-4 py-2 text-xs font-bold text-gray-500 hover:bg-gray-100 rounded-md transition-colors">Cancel</button>
					<button type="submit" class="px-4 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-md shadow-sm transition-colors">Create Project</button>
				</div>
			</form>
		</dialog>

		<dialog id="new-page-modal" class="backdrop:bg-black/40 p-6 rounded-xl shadow-2xl w-full max-w-sm bg-white border border-gray-200 m-auto z-[9999]">
			<h3 class="text-lg font-bold text-gray-800 mb-4">Create New Page</h3>
			<form action="/kb/page/create" method="POST" class="flex flex-col gap-4">
				<input type="hidden" name="project_id" id="new-page-project" value=""/>
				<input type="hidden" name="parent_id" id="new-page-parent" value=""/>
				<div>
					<label class="block text-xs font-bold text-gray-600 mb-1">Page Title</label>
					<input type="text" name="title" required class="w-full text-sm p-2 rounded-md border-gray-300 focus:border-blue-500 focus:ring-blue-500 bg-gray-50" placeholder="e.g. Q3 Architecture Review"/>
				</div>
				<div class="flex justify-end gap-2 mt-2 pt-4 border-t border-gray-100">
					<button type="button" onclick="document.getElementById('new-page-modal').close()" class="px-4 py-2 text-xs font-bold text-gray-500 hover:bg-gray-100 rounded-md transition-colors">Cancel</button>
					<button type="submit" class="px-4 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-md shadow-sm transition-colors">Create Page</button>
				</div>
			</form>
		</dialog>

		<dialog id="kb-link-modal" class="backdrop:bg-black/40 p-6 rounded-xl shadow-2xl w-full max-w-sm bg-white border border-gray-200 m-auto z-[9999]">
			<h3 class="text-lg font-bold text-gray-800 mb-4">Link to Internal Page</h3>
			<div class="flex flex-col gap-4">
				<select id="kb-link-select" class="w-full text-sm p-2.5 rounded-md border-gray-300 focus:border-blue-500 bg-gray-50 shadow-sm">
					<option value="">Select a page to link...</option>
					for _, proj := range projects {
						<optgroup label={ proj.Name }>
							for _, p := range pagesByProject[proj.ID] {
								<option value={ "/kb/page/" + p.ID }>{ p.Title }</option>
							}
						</optgroup>
					}
				</select>
				<div class="flex justify-end gap-2 mt-2 pt-4 border-t border-gray-100">
					<button type="button" onclick="document.getElementById('kb-link-modal').close()" class="px-4 py-2 text-xs font-bold text-gray-500 hover:bg-gray-100 rounded-md transition-colors">Cancel</button>
					<button type="button" onclick="window.insertKBLink()" class="px-4 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-md shadow-sm transition-colors">Insert Link</button>
				</div>
			</div>
		</dialog>

	}
}