
package monitoring

import (
	"controlroom/app/backend/ui/layout"
	"fmt"
)

templ monitoringPage(data MonitoringDashboardData) {
	@layout.Html("Monitoring Dashboard") {
		<div class="h-screen w-full bg-[#030712] text-slate-100 flex flex-col p-4 md:p-8 overflow-hidden font-sans">
			<div id="monitoring-content" class="flex-1 overflow-y-auto hide-scrollbar pb-10">
				@thirdpartyTab(data)
			</div>
		</div>
	}
}

templ thirdpartyTab(data MonitoringDashboardData) {
	<div class="flex flex-col gap-6 animate-fade-in h-full relative">
		<script>
			if (window.parent && window.parent.document) {
				const menuBtn = window.parent.document.querySelector('#ujuzi-menu-btn div');
				if (menuBtn) { menuBtn.innerText = 'MENU - MONITORING'; }
			}
		</script>

		<div class="bg-slate-900/90 backdrop-blur-xl p-4 rounded-2xl shadow-[0_0_25px_rgba(0,0,0,0.6)] border border-slate-800 flex flex-col gap-4 shrink-0 relative z-40 mt-2">
			<form 
				id="tp-monitoring-form"
				hx-get="/monitoring/thirdparty/list" 
				hx-target="#tp-list-container"
				hx-trigger="submit, load, every 60s"
				hx-indicator=".htmx-indicator"
				class="flex flex-wrap gap-4 items-center w-full"
			>
				<div class="flex items-center gap-2 pr-4">
					<input type="date" name="start_date" value={ data.StartDate } class="text-sm rounded-lg border-slate-700 bg-slate-950 text-slate-200 focus:ring-emerald-500 focus:border-emerald-500 py-1.5 px-3" />
					<span class="text-xs font-semibold text-slate-500">TO</span>
					<input type="date" name="end_date" value={ data.EndDate } class="text-sm rounded-lg border-slate-700 bg-slate-950 text-slate-200 focus:ring-emerald-500 focus:border-emerald-500 py-1.5 px-3" />
				</div>
				<button type="submit" class="ml-auto bg-emerald-600 hover:bg-emerald-500 text-white px-5 py-2 rounded-lg text-xs font-bold uppercase tracking-wider transition-all shadow-[0_0_15px_rgba(16,185,129,0.3)] border border-emerald-400/30">
					Apply Filters
				</button>
			</form>
		</div>

		<div id="tp-list-container" class="flex flex-col gap-6 w-full pb-10">
			<div class="flex flex-wrap gap-4 items-center">
				<div class="animate-pulse h-14 bg-slate-900/80 rounded-xl w-64 border border-slate-800"></div>
				<div class="animate-pulse h-14 bg-slate-900/80 rounded-xl w-64 border border-slate-800"></div>
				<div class="animate-pulse h-14 bg-slate-900/80 rounded-xl w-64 border border-slate-800"></div>
			</div>
		</div>
	</div>
}

templ thirdpartyList(summaries []JobSummary, startStr string, endStr string) {
	<div class="flex flex-wrap gap-4 items-start w-full">
		for _, summary := range summaries {
			<button 
				hx-get={ "/monitoring/thirdparty/detail?job=" + summary.JobName + "&start_date=" + startStr + "&end_date=" + endStr }
				hx-target="#monitoring-content"
				hx-swap="innerHTML"
				class={ "group flex items-center gap-3 relative overflow-hidden w-64 rounded-xl bg-slate-900/60 backdrop-blur-xl border shadow-xl transition-all duration-300 cursor-pointer py-3 px-4 text-left hover:-translate-y-0.5", templ.KV("border-red-500/40 hover:border-red-500 hover:shadow-[0_0_20px_rgba(239,68,68,0.25)]", summary.Status == "FAILED" || summary.Status == "ERROR"), templ.KV("border-emerald-500/40 hover:border-emerald-400 hover:shadow-[0_0_20px_rgba(16,185,129,0.25)]", summary.Status != "FAILED" && summary.Status != "ERROR") }
			>
				if summary.Status == "FAILED" || summary.Status == "ERROR" {
					<div class="w-2.5 h-2.5 rounded-full bg-red-500 shadow-[0_0_12px_rgba(239,68,68,1)] animate-pulse shrink-0"></div>
				} else {
					<div class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,1)] animate-pulse shrink-0"></div>
				}

				<div class="flex flex-col flex-1 min-w-0 z-10">
					<span class="font-black tracking-widest uppercase text-[11px] text-slate-100 truncate">{ summary.JobName }</span>
					<span class="text-[10px] font-medium text-slate-400 tracking-wide mt-0.5 truncate">{ summary.LastRunTime.Format("Jan 02, 2006 15:04:05") }</span>
				</div>
			</button>
		}
		if len(summaries) == 0 {
			<div class="text-slate-400 font-medium w-full text-center py-12 bg-slate-900/60 backdrop-blur-xl rounded-2xl border border-slate-800 shadow-xl">No load functions found in BigQuery logs for this period.</div>
		}
	</div>

	if len(summaries) > 0 {
		<div class="bg-slate-900/80 backdrop-blur-xl rounded-2xl border border-slate-800 shadow-[0_0_30px_rgba(0,0,0,0.6)] overflow-hidden w-full mt-4 flex flex-col min-h-0 flex-1">
			<div class="px-5 py-4 border-b border-slate-800 bg-slate-950/60 flex justify-between items-center shrink-0">
				<h2 class="text-xs font-bold text-slate-300 uppercase tracking-widest flex items-center gap-2">
					<span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
					Jobs Metrics Aggregation
				</h2>
			</div>
			<div class="overflow-y-auto hide-scrollbar flex-1 pb-4">
				<table class="min-w-full divide-y divide-slate-800">
					<thead class="bg-slate-950/90 sticky top-0 z-10 backdrop-blur-md">
						<tr>
							<th scope="col" class="px-6 py-3.5 text-left text-[10px] font-bold text-slate-400 uppercase tracking-widest">Name</th>
							<th scope="col" class="px-6 py-3.5 text-left text-[10px] font-bold text-slate-400 uppercase tracking-widest">Last Run Time</th>
							<th scope="col" class="px-6 py-3.5 text-right text-[10px] font-bold text-slate-400 uppercase tracking-widest">Total Bytes</th>
							<th scope="col" class="px-6 py-3.5 text-right text-[10px] font-bold text-slate-400 uppercase tracking-widest">Total Rows</th>
							<th scope="col" class="px-6 py-3.5 text-right text-[10px] font-bold text-slate-400 uppercase tracking-widest">Total Cost</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-800/60">
						for _, s := range summaries {
							<tr class="hover:bg-slate-800/40 transition-colors">
								<td class="px-6 py-3.5 whitespace-nowrap text-xs font-bold text-slate-200">
									<div class="flex items-center gap-2.5">
										if s.Status == "FAILED" || s.Status == "ERROR" {
											<div class="w-2 h-2 rounded-full bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.9)] shrink-0"></div>
										} else {
											<div class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.9)] shrink-0"></div>
										}
										{ s.JobName }
									</div>
								</td>
								<td class="px-6 py-3.5 whitespace-nowrap text-xs text-slate-400 font-mono">{ s.LastRunTime.Format("Jan 02, 2006 15:04:05") }</td>
								<td class="px-6 py-3.5 whitespace-nowrap text-right text-xs text-slate-300 font-mono font-medium">{ formatBytes(float64(s.TotalBytes)) }</td>
								<td class="px-6 py-3.5 whitespace-nowrap text-right text-xs text-slate-300 font-mono font-medium">{ fmt.Sprintf("%d", s.TotalRows) }</td>
								<td class="px-6 py-3.5 whitespace-nowrap text-right text-xs font-black text-emerald-400 font-mono">{ fmt.Sprintf("$%.2f", s.TotalCost) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

templ thirdpartyDetail(jobName string, data MonitoringDashboardData, logs []LogEntry, latest LogEntry, parsedMetrics ParsedMetrics) {
	<div class="flex flex-col gap-6 animate-fade-in h-full relative">
		<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-slate-900/90 backdrop-blur-xl p-4 rounded-2xl shadow-[0_0_25px_rgba(0,0,0,0.6)] border border-slate-800 shrink-0 mt-2">
			<div class="flex items-center gap-4">
				<button hx-get="/monitoring/thirdparty" hx-target="#monitoring-content" class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider transition-colors flex items-center gap-2 border border-slate-700/50">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
					Back
				</button>
				<h2 class="text-xl font-black text-white uppercase tracking-widest">{ jobName }</h2>
			</div>
			<div class="flex items-center gap-4">
				<form 
					id="tp-detail-form"
					hx-get="/monitoring/thirdparty/detail" 
					hx-target="#monitoring-content"
					class="flex items-center gap-2 m-0"
				>
					<input type="hidden" name="job" value={ jobName } />
					<input type="date" name="start_date" value={ data.StartDate } class="text-sm rounded-lg border-slate-700 bg-slate-950 text-slate-200 focus:ring-emerald-500 focus:border-emerald-500 py-1.5 px-3" />
					<span class="text-xs font-semibold text-slate-500">TO</span>
					<input type="date" name="end_date" value={ data.EndDate } class="text-sm rounded-lg border-slate-700 bg-slate-950 text-slate-200 focus:ring-emerald-500 focus:border-emerald-500 py-1.5 px-3" />
					<button type="submit" class="bg-slate-800 text-white px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider hover:bg-slate-700 transition-all shadow-sm border border-slate-700">
						Filter
					</button>
				</form>
				<button hx-post={ "/monitoring/thirdparty/trigger?job=" + jobName } hx-swap="none" onclick="alert('Job triggered successfully.')" class="bg-emerald-600 hover:bg-emerald-500 text-white px-5 py-2 rounded-lg text-xs font-bold uppercase tracking-wider transition-all shadow-[0_0_15px_rgba(16,185,129,0.3)] border border-emerald-400/30 flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z" /></svg>
					Trigger Job
				</button>
			</div>
		</div>

		if len(logs) > 0 {
			<div class="grid grid-cols-1 md:grid-cols-4 gap-4 shrink-0">
				<div class="bg-slate-900/70 backdrop-blur-xl rounded-2xl border border-slate-800 p-5 flex flex-col justify-center shadow-xl">
					<div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1">Last Run Status</div>
					<div class="flex items-center gap-2 mt-1">
						if latest.Status == "FAILED" || latest.Status == "ERROR" {
							<div class="w-3 h-3 rounded-full bg-red-500 shadow-[0_0_10px_rgba(239,68,68,1)] animate-pulse"></div>
							<div class="text-xl font-black text-red-500">{ latest.Status }</div>
						} else {
							<div class="w-3 h-3 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,1)] animate-pulse"></div>
							<div class="text-xl font-black text-emerald-400">{ latest.Status }</div>
						}
					</div>
				</div>
				<div class="bg-slate-900/70 backdrop-blur-xl rounded-2xl border border-slate-800 p-5 flex flex-col justify-center shadow-xl">
					<div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1">Duration</div>
					<div class="text-xl font-black text-slate-100 mt-1 font-mono">{ fmt.Sprintf("%.2fs", latest.DurationSeconds) }</div>
					<div class="text-[10px] font-medium text-slate-500 mt-1 font-mono">{ latest.StartTime.Format("Jan 02 15:04:05") } - { latest.EndTime.Format("15:04:05") }</div>
				</div>
				<div class="bg-slate-900/70 backdrop-blur-xl rounded-2xl border border-slate-800 p-5 flex flex-col justify-center shadow-xl">
					<div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1">Total Bytes</div>
					<div class="text-xl font-black text-slate-100 mt-1 font-mono">{ formatBytes(float64(latest.TotalBytes)) }</div>
				</div>
				<div class="bg-slate-900/70 backdrop-blur-xl rounded-2xl border border-slate-800 p-5 flex flex-col justify-center shadow-xl">
					<div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1">Total Rows</div>
					<div class="text-xl font-black text-slate-100 mt-1 font-mono">{ fmt.Sprintf("%d", latest.TotalRows) }</div>
				</div>
			</div>

			if latest.Status == "FAILED" || latest.Status == "ERROR" {
				<div class="bg-red-950/30 rounded-2xl border border-red-900/50 shadow-xl p-5 shrink-0">
					<h3 class="text-sm font-bold text-red-400 uppercase tracking-wider mb-2">Error Message</h3>
					<div class="text-sm text-red-300 font-mono bg-red-950/60 p-3 rounded-lg mb-4 border border-red-900/40">{ latest.ErrorMessage }</div>
					<h3 class="text-sm font-bold text-red-400 uppercase tracking-wider mb-2">Stack Trace</h3>
					<div class="text-xs text-red-300 font-mono bg-red-950/60 p-3 rounded-lg overflow-x-auto whitespace-pre-wrap border border-red-900/40">{ latest.StackTrace }</div>
				</div>
			}

			if len(parsedMetrics) > 0 {
				<div class="bg-slate-900/80 backdrop-blur-xl rounded-2xl border border-slate-800 shadow-[0_0_30px_rgba(0,0,0,0.6)] overflow-hidden shrink-0 relative z-30">
					<div class="px-5 py-3 border-b border-slate-800 bg-slate-950/60">
						<h2 class="text-xs font-bold text-slate-300 uppercase tracking-widest">Extracted Metrics JSON</h2>
					</div>
					<div class="overflow-x-visible w-full">
						<table class="min-w-full divide-y divide-slate-800">
							<thead class="bg-slate-950/80">
								<tr>
									<th scope="col" class="px-6 py-3 text-left text-xs font-bold text-slate-400 uppercase tracking-wider">Table Element</th>
									<th scope="col" class="px-6 py-3 text-right text-xs font-bold text-slate-400 uppercase tracking-wider">Rows</th>
									<th scope="col" class="px-6 py-3 text-right text-xs font-bold text-slate-400 uppercase tracking-wider">Bytes</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-800/60">
								for k, v := range parsedMetrics {
									<tr class="hover:bg-slate-800/40 transition-colors">
										<td class="px-6 py-3 whitespace-nowrap text-sm font-bold text-slate-200">{ k }</td>
										<td class="px-6 py-3 whitespace-nowrap text-right text-sm text-slate-300 font-medium font-mono">{ fmt.Sprintf("%d", v.Rows) }</td>
										<td class="px-6 py-3 whitespace-nowrap text-right text-sm font-black text-emerald-400 font-mono">{ formatBytes(float64(v.Bytes)) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}

			<div class="bg-slate-900/80 backdrop-blur-xl rounded-2xl border border-slate-800 shadow-[0_0_30px_rgba(0,0,0,0.6)] overflow-hidden flex-1 relative z-30 min-h-[300px] flex flex-col">
				<div class="px-5 py-3 border-b border-slate-800 bg-slate-950/60 shrink-0">
					<h2 class="text-xs font-bold text-slate-300 uppercase tracking-widest">Historical Runs (Selected Period)</h2>
				</div>
				<div class="overflow-y-auto flex-1 hide-scrollbar pb-4">
					<table class="min-w-full divide-y divide-slate-800">
						<thead class="bg-slate-950/90 sticky top-0 z-10 backdrop-blur-md">
							<tr>
								<th scope="col" class="px-6 py-3 text-left text-[10px] font-bold text-slate-400 uppercase tracking-widest">Start Time</th>
								<th scope="col" class="px-6 py-3 text-left text-[10px] font-bold text-slate-400 uppercase tracking-widest">Status</th>
								<th scope="col" class="px-6 py-3 text-right text-[10px] font-bold text-slate-400 uppercase tracking-widest">Duration</th>
								<th scope="col" class="px-6 py-3 text-right text-[10px] font-bold text-slate-400 uppercase tracking-widest">Rows</th>
								<th scope="col" class="px-6 py-3 text-right text-[10px] font-bold text-slate-400 uppercase tracking-widest">Bytes</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-800/60">
							for _, lg := range logs {
								<tr class="hover:bg-slate-800/40 transition-colors">
									<td class="px-6 py-3 whitespace-nowrap text-xs font-bold text-slate-200 font-mono">{ lg.StartTime.Format("Jan 02, 2006 15:04:05") }</td>
									<td class="px-6 py-3 whitespace-nowrap text-xs">
										if lg.Status == "FAILED" || lg.Status == "ERROR" {
											<span class="bg-red-950/60 text-red-400 px-2 py-0.5 rounded-md font-bold border border-red-900/50">{ lg.Status }</span>
										} else {
											<span class="bg-emerald-950/60 text-emerald-400 px-2 py-0.5 rounded-md font-bold border border-emerald-900/50">{ lg.Status }</span>
										}
									</td>
									<td class="px-6 py-3 whitespace-nowrap text-right text-xs text-slate-300 font-medium font-mono">{ fmt.Sprintf("%.2fs", lg.DurationSeconds) }</td>
									<td class="px-6 py-3 whitespace-nowrap text-right text-xs text-slate-300 font-medium font-mono">{ fmt.Sprintf("%d", lg.TotalRows) }</td>
									<td class="px-6 py-3 whitespace-nowrap text-right text-xs text-slate-100 font-black font-mono">{ formatBytes(float64(lg.TotalBytes)) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		} else {
			<div class="bg-slate-900/80 backdrop-blur-xl p-8 rounded-2xl shadow-xl border border-slate-800 text-center text-slate-400 font-medium shrink-0">
				No logs found for this job in the selected date range.
			</div>
		}
	</div>
}