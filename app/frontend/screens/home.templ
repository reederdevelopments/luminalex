package base

import "ujuzi_reloaded/app/backend/auth"
import "ujuzi_reloaded/app/backend/ui/layout"
import "strings"
import "strconv"
import "sort"

func getFlagUrl(code string) string {
	code = strings.ToLower(code)
	if code == "" { return "https://flagcdn.com/w40/za.png" }
	return "https://flagcdn.com/w40/" + code + ".png"
}

func getCountryName(code string) string {
	code = strings.ToLower(code)
	names := map[string]string{
		"za": "South Africa", "ke": "Kenya", "ug": "Uganda", "tz": "Tanzania", "zm": "Zambia",
	}
	if name, ok := names[code]; ok { return name }
	return strings.ToUpper(code)
}

func getHighestGroup(userGroups []string, allGroups []auth.Group) string {
	if len(userGroups) == 0 {
		return "UNASSIGNED"
	}
	
	var assigned []auth.Group
	for _, ug := range userGroups {
		for _, g := range allGroups {
			if g.ID == ug {
				assigned = append(assigned, g)
			}
		}
	}
	
	if len(assigned) == 0 {
		return "UNASSIGNED"
	}
	
	// Sort so the lowest level number (highest actual rank) is first
	sort.Slice(assigned, func(i, j int) bool {
		li, _ := strconv.Atoi(strings.TrimSpace(assigned[i].Level))
		lj, _ := strconv.Atoi(strings.TrimSpace(assigned[j].Level))
		return li < lj 
	})
	
	return strings.ToUpper(assigned[0].Name)
}

func hasAdminGroup(userGroups []string, allGroups []auth.Group) bool {
	for _, ug := range userGroups {
		for _, g := range allGroups {
			// Substring match catches "Super Admin", "Admin", "Administrator", etc.
			if g.ID == ug && strings.Contains(strings.ToLower(g.Name), "admin") {
				return true
			}
		}
	}
	return false
}

func getUserDashboardsByArea(user auth.User, allGroups []auth.Group, allDashboards []auth.Dashboard) map[string][]auth.Dashboard {
	dashMap := make(map[string]bool)
	for _, ug := range user.Groups {
		for _, g := range allGroups {
			if g.ID == ug {
				for _, did := range g.Dashboards {
					dashMap[did] = true
				}
			}
		}
	}

	areaMap := make(map[string][]auth.Dashboard)
	for _, d := range allDashboards {
		if dashMap[d.ID] {
			areaMap[d.Area] = append(areaMap[d.Area], d)
		}
	}
	return areaMap
}

type SearchItem struct {
	Name   string          `json:"name"`
	Url    string          `json:"url"`
	Code   string          `json:"code"`
	Type   string          `json:"type"`
	IsTool bool            `json:"isTool"`
	Params auth.DashParams `json:"params,omitempty"`
}

func buildSearchData(user auth.User, allGroups []auth.Group, allDashboards []auth.Dashboard) []SearchItem {
	items := []SearchItem{}

	if hasAdminGroup(user.Groups, allGroups) {
		items = append(items, SearchItem{Name: "User Management", Url: "/admin/management", Type: "Admin", IsTool: false})
		items = append(items, SearchItem{Name: "Dashboard Management", Url: "/admin/dashboards", Type: "Admin", IsTool: false})
	}

	for _, areaDashes := range getUserDashboardsByArea(user, allGroups, allDashboards) {
		for _, d := range areaDashes {
			items = append(items, SearchItem{Name: d.Name, Url: d.ReportURL, Type: "Dashboard", IsTool: false, Params: d.Parameters})
			for _, p := range d.Pages {
				items = append(items, SearchItem{Name: d.Name + " - " + p.Name, Url: d.ReportURL, Code: p.Code, Type: "Page", IsTool: false, Params: d.Parameters})
			}
		}
	}

	for _, t := range user.Tools {
		items = append(items, SearchItem{Name: t, Url: t, Type: "Tool", IsTool: true})
	}

	return items
}

type TopApp struct {
	Name string
	Url  string
}

func getTopApps(user auth.User) []TopApp {
	type kv struct {
		Key   string
		Value int
	}
	var sorted []kv
	for k, v := range user.DashboardClicks {
		sorted = append(sorted, kv{Key: k, Value: v})
	}
	sort.Slice(sorted, func(i, j int) bool {
		return sorted[i].Value > sorted[j].Value // Descending sort
	})
	
	var tops []TopApp
	for _, item := range sorted {
		if len(tops) >= 5 {
			break
		}
		parts := strings.Split(item.Key, "|#|")
		if len(parts) == 2 {
			tops = append(tops, TopApp{Name: parts[0], Url: parts[1]})
		}
	}
	
	// Default fallbacks if the user hasn't clicked 5 things yet
	defaults := []TopApp{
		{Name: "Shake The Tree", Url: "https://datastudio.google.com/embed/reporting/d179f56a-8312-48b7-a396-21758314bbe9/page/p_596g9ngm3d"},
		{Name: "Productivity", Url: "https://datastudio.google.com/embed/reporting/7aee9b68-0f61-4021-8fce-581db0ca8fca/page/p_q65qczy03d"},
		{Name: "HR Dashboard", Url: "https://datastudio.google.com/embed/reporting/dcdf8216-b7a4-4cde-8cfa-83faa8831c4e/page/p_ti0xww5atd"},
		{Name: "Pesh", Url: "https://datastudio.google.com/embed/reporting/63ea16a3-5fac-4e8b-81e0-3e7930159cdb/page/p_rit7qlqbyd"},
		{Name: "Payments", Url: "https://datastudio.google.com/embed/reporting/14b32b85-977f-4be0-b88c-af4e3a24fa75/page/p_uzcx5zroud"},
	}
	
	for len(tops) < 5 {
		added := false
		for _, d := range defaults {
			exists := false
			for _, t := range tops {
				if t.Name == d.Name {
					exists = true
					break
				}
			}
			if !exists {
				tops = append(tops, d)
				added = true
				break
			}
		}
		if !added { break }
	}
	
	return tops
}

templ homePage(user auth.User, allGroups []auth.Group, allDashboards []auth.Dashboard) {
	@layout.HtmlFullPage("Ujuzi Platform - NextGen") {
		<link rel="stylesheet" href="/assets/styles/main_ui.css"/>

		@templ.JSONScript("search-db", buildSearchData(user, allGroups, allDashboards))

		<div id="main-view-container" class="absolute inset-2 md:inset-4 border border-gray-200/60 rounded-xl shadow-2xl bg-white overflow-hidden flex z-10">
			<div id="loader-overlay" class="absolute inset-0 bg-white/80 backdrop-blur-sm z-[500] hidden items-center justify-center">
				<span class="loader"></span>
			</div>
			<iframe src="https://datastudio.google.com/embed/reporting/d179f56a-8312-48b7-a396-21758314bbe9/page/p_596g9ngm3d" id="main-view" title="Ujuzi Content Frame" class="w-full h-full border-none block"></iframe>
			<div id="native-tool-view" class="w-full h-full hidden items-center justify-center text-5xl font-black text-hl tracking-widest uppercase bg-gray-50">
				<span id="tool-title">TOOL 1</span>
			</div>
		</div>

		<div class="screen-edge-tab fixed top-6 left-0 bg-white/95 backdrop-blur-md border border-l-0 border-gray-200 px-5 py-3 rounded-r-xl cursor-pointer z-[1000] flex flex-row-reverse items-center gap-4 shadow-lg hover:translate-x-1 hover:shadow-xl group" onclick="setSidebarState('active')">
			<div class="flex flex-col text-left">
				<span class="text-xl font-black tracking-widest text-green-x-dark group-hover:text-hl transition-colors">UJUZI</span>
				<span class="text-[10px] uppercase tracking-wider text-gray-500 font-bold">{ user.Name }</span>
			</div>
			<div class="text-gray-400 group-hover:text-hl transition-colors">&#9654;</div>
		</div>

		<nav id="platform-menu" class="fixed top-0 left-0 w-full md:w-[18vw] h-full bg-green-x-dark border-r border-green-x-dark shadow-2xl z-[999] flex flex-col pt-4">
			
			<div class="absolute -right-6 top-8 w-6 h-12 bg-green-x-dark text-green-x-light hover:text-white hover:bg-green-x-dark flex items-center justify-center cursor-pointer rounded-r-md shadow-md border border-l-0 border-green-x-dark transition-colors" onclick="setSidebarState('closed')">
				<span class="text-[10px]">&#9664;</span>
			</div>

			<div class="flex-1 overflow-y-auto flex flex-col hide-scrollbar">
				
				<div class="flex justify-between items-center px-6 pb-4 border-b border-green-x-light/30">
					<div class="flex flex-col">
						<div class="text-2xl font-black tracking-widest text-white drop-shadow-sm">UJUZI</div>
						<div class="text-[10px] font-bold uppercase tracking-wider text-green-x-light mt-1">{ user.Name }</div>
					</div>
					
					<div class="relative flex items-center">
						<button id="flag-btn" class="flex items-center justify-center w-8 h-8 rounded-full border-2 border-green-x-light shadow-sm overflow-hidden focus:outline-none hover:border-white transition-colors cursor-pointer">
							<img id="current-flag" src={ getFlagUrl(user.DefaultCountry) } alt="Current Country Flag" class="w-full h-full object-cover"/>
						</button>

						<div id="country-dropdown" class="absolute right-0 top-10 mt-2 w-48 bg-white rounded-xl shadow-xl hidden z-50 overflow-hidden border border-gray-100">
							<div class="px-4 py-2 text-[10px] font-bold text-gray-400 uppercase tracking-widest bg-gray-50 border-b border-gray-100">Select Region</div>
							if len(user.Countries) > 0 {
								for _, code := range user.Countries {
									<div class="country-option flex items-center gap-3 px-4 py-3 hover:bg-green-x-light/10 cursor-pointer text-gray-700 text-xs font-bold tracking-wide transition-colors" data-country={ code } data-flag={ getFlagUrl(code) }>
										<img src={ getFlagUrl(code) } alt={ code } class="w-5 h-5 rounded-full object-cover border border-gray-200 shadow-sm"/>
										<span>{ getCountryName(code) }</span>
									</div>
								}
							} else {
								<div class="px-4 py-3 text-xs text-gray-400 italic">No regions assigned</div>
							}
						</div>
					</div>
				</div>

				<div class="px-6 py-2 text-[10px] uppercase tracking-widest font-bold text-green-x-light bg-black/10 border-b border-green-x-light/30">
					{ getHighestGroup(user.Groups, allGroups) }
				</div>

				<div class="px-5 pt-5 pb-1 relative">
					<input type="text" id="menu-search-input" class="w-full bg-black/20 border border-green-x-light/20 text-white px-4 py-2 rounded-lg outline-none text-xs font-medium tracking-wide transition-all focus:bg-black/40 focus:border-green-x-light focus:ring-4 focus:ring-hl/10 placeholder-green-x-light/50 shadow-inner" placeholder="Search system..." autocomplete="off"/>
					<div id="menu-search-results" class="absolute top-full left-5 right-5 mt-1 bg-white border border-gray-200 rounded-lg max-h-48 overflow-y-auto z-[1000] hidden shadow-xl text-gray-800"></div>
				</div>

				<div class="flex flex-wrap justify-center gap-3 p-6 border-b border-green-x-light/10">
					for _, app := range getTopApps(user) {
						<button class="app-btn w-[30%] aspect-[2/1] rounded-xl bg-green-x-light text-[9px] font-bold text-white shadow-sm flex items-center justify-center text-center p-1 transition-all duration-300 hover:-translate-y-1 hover:bg-white hover:text-green-x-dark hover:shadow-md" 
							data-name={ app.Name }
							data-url={ app.Url }
							onclick="window.handleAppBtnClick(event, this)">
							{ strings.ToUpper(app.Name) }
						</button>
					}
				</div>

				<div class="flex flex-col pb-6">
					for area, areaDashes := range getUserDashboardsByArea(user, allGroups, allDashboards) {
						<div class="mt-4 px-6">
							<div class="flex items-center justify-between text-[10px] font-bold text-green-x-light uppercase tracking-widest cursor-pointer group" onclick="window.toggleMenu(event, this)">
								<span>{ area }</span>
								<span class="group-hover:text-white transition-colors text-[8px]">▼</span>
							</div>
							<div class="menu-dropdown-content hidden flex-col gap-3 mt-3">
								for _, d := range areaDashes {
									<div class="flex flex-col">
										<div class="flex items-center justify-between group/dash py-1.5">
											<span class="text-xs text-white/90 cursor-pointer hover:text-hl transition-colors truncate pr-2" 
												data-url={ d.ReportURL } 
												data-p-country={ d.Parameters.CountryCode }
												data-p-branch={ d.Parameters.Branch }
												data-p-consultant={ d.Parameters.Consultant }
												data-p-cycle={ d.Parameters.Cycle }
												data-p-prev={ d.Parameters.PrevCycle }
												data-p-date={ d.Parameters.Date }
												data-p-period={ d.Parameters.Period }
												onclick="window.handleDashboardClick(event, this)">{ d.Name }</span>
											
											if len(d.Pages) > 0 {
												<span class="text-green-x-light/50 hover:text-white cursor-pointer text-[10px] transition-colors px-2 py-1"
													onclick="window.togglePages(event, this)">▼</span>
											}
										</div>
										if len(d.Pages) > 0 {
											<div class="hidden flex-col gap-2 pl-3 pb-2 border-l border-green-x-light/20 ml-2 mt-1">
												for _, p := range d.Pages {
													<div class="w-full block text-[10px] uppercase tracking-wide font-bold text-gray-400 hover:text-hl cursor-pointer transition-colors" 
														data-url={ d.ReportURL } 
														data-code={ p.Code }
														data-p-country={ d.Parameters.CountryCode }
														data-p-branch={ d.Parameters.Branch }
														data-p-consultant={ d.Parameters.Consultant }
														data-p-cycle={ d.Parameters.Cycle }
														data-p-prev={ d.Parameters.PrevCycle }
														data-p-date={ d.Parameters.Date }
														data-p-period={ d.Parameters.Period }
														onclick="window.handleDashboardClick(event, this, this.getAttribute('data-code'))">{ p.Name }</div>
												}
											</div>
										}
									</div>
								}
							</div>
						</div>
					}

					if len(user.Tools) > 0 {
						<div class="mt-6 px-6 pt-4 border-t border-green-x-light/10">
							<div class="flex items-center justify-between text-[10px] font-bold text-green-x-light uppercase tracking-widest cursor-pointer group" onclick="window.toggleMenu(event, this)">
								<span>TOOLS</span>
								<span class="group-hover:text-white transition-colors text-[8px]">▼</span>
							</div>
							<div class="menu-dropdown-content hidden flex-col gap-3 mt-3">
								for _, t := range user.Tools {
									<div class="w-full block text-xs text-white/90 cursor-pointer hover:text-hl transition-colors truncate pr-2 py-1" 
										data-tool={ t } 
										onclick="window.handleToolClick(event, this)">{ t }</div>
								}
							</div>
						</div>
					}
				</div>
			</div>

			<div class="mt-auto w-full bg-green-x-dark border-t border-green-x-light/30">
				
				if hasAdminGroup(user.Groups, allGroups) {
					<div class="px-5 py-3 border-b border-green-x-light/10">
						<div class="text-[10px] font-bold text-green-x-light uppercase tracking-widest mb-2 pl-1">Admin</div>
						<a class="flex items-center gap-3 px-4 py-2.5 text-xs font-bold text-white tracking-wide rounded-lg hover:bg-green-x-light/20 transition-all cursor-pointer" onclick="changeIframeUrl('/admin/management')">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-green-x-light">
								<path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
							</svg>
							USER MANAGEMENT
						</a>
						<a class="flex items-center gap-3 px-4 py-2.5 text-xs font-bold text-white tracking-wide rounded-lg hover:bg-green-x-light/20 transition-all cursor-pointer mt-1" onclick="changeIframeUrl('/admin/dashboards')">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-green-x-light">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
							</svg>
							DASHBOARD MANAGEMENT
						</a>
					</div>
				}

                <div class="px-5 py-4">
					<a href="/logout" class="flex w-full items-center justify-center gap-2 rounded-lg bg-red-x-light px-4 py-2.5 text-xs font-bold tracking-wide text-white shadow hover:bg-red-x-dark transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
							<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
						</svg>
						SIGN OUT
					</a>
				</div>
				<div class="text-center text-[9px] text-green-x-light/60 font-mono tracking-widest pb-3">
					v 1.0.0 // SYS
				</div>
			</div>
		</nav>

		<div id="user-env" class="hidden" 
			data-name={ strings.TrimSpace(user.FirstName + " " + user.LastName) } 
			data-country={ user.DefaultCountry } 
			data-country-name={ getCountryName(user.DefaultCountry) }>
		</div>

		<script src="/assets/scripts/main_ui.js"></script>
	}
}