package dataform

import (
	"fmt"
	"strings"
	"time"
	"ujuzi_reloaded/app/backend/ui/layout"
)

templ dataformPage() {
	@layout.Html("Dataform Batches") {
		<div class="h-screen w-full bg-gray-50 flex flex-col font-sans overflow-hidden">
			<div class="flex-1 flex overflow-hidden">
				<div class="w-1/2 border-r border-gray-200 bg-white p-8 overflow-y-auto">
					<h2 class="text-xl font-black tracking-widest text-green-x-dark uppercase mb-6 border-b border-gray-100 pb-4">Execute Batch</h2>
					<form hx-post="/tools/api/dataform/batch/run" hx-target="#batch-status-container" class="flex flex-col gap-6">
						<div class="grid grid-cols-2 gap-4">
							<div>
								<label class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-1">Workspace</label>
								<input type="text" name="workspace" required placeholder="active-channels-and-units" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:border-hl outline-none"/>
							</div>
							<div>
								<label class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-1">Target Tag</label>
								<input type="text" name="target_tag" required placeholder="country-dashboard" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:border-hl outline-none"/>
							</div>
						</div>
						
						<h3 class="text-xs font-bold tracking-widest text-gray-400 uppercase mt-2 border-b border-gray-100 pb-2">Target Countries & Cycles</h3>
						<div class="flex flex-col gap-4">
							for _, cc := range []string{"za", "ke", "ug", "tz", "zm"} {
								<div class="flex items-center gap-4 p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">
									<label class="flex items-center gap-3 cursor-pointer w-24">
										<input type="checkbox" name={ fmt.Sprintf("enable_%s", cc) } value="true" class="rounded border-gray-300 text-hl focus:ring-hl/20" />
										<span class="text-sm font-bold text-gray-700">{ strings.ToUpper(cc) }</span>
									</label>
									<div class="flex items-center gap-2 flex-1">
										<input type="text" name={ fmt.Sprintf("start_%s", cc) } placeholder="Start (e.g. 202401)" class="w-full border border-gray-200 rounded-md px-3 py-1.5 text-xs focus:border-hl outline-none font-mono"/>
										<span class="text-gray-400">-</span>
										<input type="text" name={ fmt.Sprintf("end_%s", cc) } placeholder="End (e.g. 202412)" class="w-full border border-gray-200 rounded-md px-3 py-1.5 text-xs focus:border-hl outline-none font-mono"/>
									</div>
								</div>
							}
						</div>

						<div class="mt-4 flex justify-end">
							<button type="submit" class="bg-gray-900 hover:bg-gray-700 text-white font-bold text-xs uppercase tracking-widest px-8 py-3 rounded-lg transition-colors shadow-sm">Submit Batch</button>
						</div>
					</form>
				</div>
				<div class="w-1/2 bg-gray-50 p-8 overflow-y-auto" id="batch-status-container" hx-get="/tools/api/dataform/batch/status" hx-trigger="load">
				</div>
			</div>
		</div>
	}
}

templ batchStatusPanel(b *LiveBatch, history []BatchHistoryRow) {
	<div class="bg-white border border-gray-200 rounded-xl p-8 shadow-sm h-full flex flex-col"
		if b != nil && (b.Status == "RUNNING" || b.Status == "CANCELING") {
			hx-get="/tools/api/dataform/batch/status"
			hx-trigger="every 5s"
			hx-swap="outerHTML"
		}
	>
		if b != nil && (b.Status == "RUNNING" || b.Status == "CANCELING" || time.Since(b.FinishedAt) < 2*time.Minute) {
			<div class="flex items-center justify-between mb-6 border-b border-gray-100 pb-4">
				<div>
					<h2 class="text-xl font-black tracking-widest text-gray-900 uppercase flex items-center gap-3">
						Batch Progress
						<span class={ statusBadgeClass(b.Status) }>{ b.Status }</span>
					</h2>
					<p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-2">
						Workspace: { b.Workspace } | Tag: { b.TargetTag }
					</p>
				</div>
				if b.Status == "RUNNING" {
					<button hx-post="/tools/api/dataform/batch/cancel" hx-target="#batch-status-container" class="bg-red-50 text-red-600 hover:bg-red-100 font-bold text-xs uppercase tracking-widest px-4 py-2 rounded-lg transition-colors border border-red-200">
						Cancel
					</button>
				}
			</div>

			<div class="flex flex-col gap-3 flex-1 overflow-y-auto">
				for _, c := range b.Countries {
					<details class="group rounded-lg border border-gray-200 bg-white shadow-sm" open?={ c.Status == "RUNNING" }>
						<summary class="flex cursor-pointer items-center justify-between px-5 py-4 select-none hover:bg-gray-50 transition-colors">
							<div class="flex items-center gap-4">
								<span class="text-sm font-black uppercase text-gray-900">{ c.Code }</span>
								<span class={ statusBadgeClass(c.Status) }>{ c.Status }</span>
							</div>
							if c.Status != "SKIPPED" && c.Status != "AWAITING" {
								<span class="text-xs font-bold text-gray-400">{ cyclesFraction(c) } Cycles</span>
							}
						</summary>
						
						if len(c.Cycles) > 0 {
							<div class="border-t border-gray-100 bg-gray-50/50">
								<table class="min-w-full text-sm">
									<thead class="bg-gray-100/50">
										<tr>
											<th class="px-5 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Cycle</th>
											<th class="px-5 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Status</th>
											<th class="px-5 py-2 text-right text-[10px] font-bold text-gray-500 uppercase tracking-widest">Link</th>
										</tr>
									</thead>
									<tbody class="divide-y divide-gray-100 bg-white">
										for _, cy := range c.Cycles {
											<tr class="hover:bg-gray-50">
												<td class="px-5 py-3 font-mono text-xs font-bold text-gray-800">{ cy.Cycle }</td>
												<td class="px-5 py-3">
													<span class={ statusBadgeClass(cy.Status) }>{ cy.Status }</span>
												</td>
												<td class="px-5 py-3 text-right">
													if cy.ConsoleLink != "" {
														<a href={ templ.URL(cy.ConsoleLink) } target="_blank" class="text-hl hover:text-green-x-dark font-bold text-xs underline">View in GCP</a>
													} else {
														<span class="text-gray-300 text-xs">—</span>
													}
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						}
					</details>
				}
			</div>
		} else {
			<h2 class="text-xl font-black tracking-widest text-green-x-dark uppercase mb-6 border-b border-gray-100 pb-4">Batch History</h2>
			<div class="flex flex-col gap-3">
				if len(history) == 0 {
					<div class="p-8 text-center text-sm font-bold text-gray-400">No completed batches found.</div>
				}
				for _, row := range history {
					<div class="flex justify-between items-center p-4 border border-gray-100 rounded-lg bg-gray-50 hover:bg-white transition-colors cursor-pointer">
						<div class="flex flex-col">
							<span class="text-sm font-bold text-gray-800">{ row.Workspace }</span>
							<span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-1">{ row.TargetTag } | { row.StartedAt.Format("2006-01-02 15:04") }</span>
						</div>
						<span class={ statusBadgeClass(row.Status) }>{ row.Status }</span>
					</div>
				}
			</div>
		}
	</div>
}

func statusBadgeClass(status string) string {
	switch status {
	case "COMPLETED", "SUCCEEDED":
		return "inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-green-800 border border-green-200"
	case "FAILED":
		return "inline-flex items-center rounded-full bg-red-100 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-red-800 border border-red-200"
	case "RUNNING", "CANCELING":
		return "inline-flex items-center rounded-full bg-blue-100 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-blue-800 border border-blue-200"
	case "CANCELLED":
		return "inline-flex items-center rounded-full bg-yellow-100 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-yellow-800 border border-yellow-200"
	default:
		return "inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-gray-800 border border-gray-200"
	}
}

func cyclesFraction(c LiveCountry) string {
	total := len(c.Cycles)
	done := 0
	for _, cy := range c.Cycles {
		if cy.Status == "SUCCEEDED" || cy.Status == "FAILED" {
			done++
		}
	}
	return fmt.Sprintf("%d/%d", done, total)
}