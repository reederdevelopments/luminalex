package user_management

import "ujuzi_reloaded/app/backend/auth"
import "ujuzi_reloaded/app/backend/ui/layout"

templ adminManagementPage(users []auth.User, groups []auth.Group, dashboards []auth.Dashboard, unibosGroups []string) {
	@layout.Html("User Management") {
		<div class="h-screen w-full bg-gray-50 flex flex-col font-sans">
			
			<div class="w-full bg-white border-b border-gray-200 flex px-6 pt-4 gap-8">
				<button id="tab-btn-users" class="pb-3 text-sm font-bold tracking-widest uppercase border-b-2 border-hl text-hl transition-colors cursor-pointer" onclick="switchTab('users')">Users</button>
				<button id="tab-btn-groups" class="pb-3 text-sm font-bold tracking-widest uppercase border-b-2 border-transparent text-gray-400 hover:text-gray-600 transition-colors cursor-pointer" onclick="switchTab('groups')">Groups</button>
			</div>

			<div id="tab-users" class="flex-1 flex overflow-hidden" style="display: flex;">
				<div class="w-1/2 border-r border-gray-200 bg-white flex flex-col">
					<div class="p-4 border-b border-gray-100 flex items-center gap-4">
						<input type="text" id="admin-user-search" placeholder="Search users by name or email..." class="flex-1 bg-gray-50 border border-gray-200 rounded-lg px-4 py-2 text-sm outline-none focus:border-hl focus:ring-2 focus:ring-hl/20 transition-all"/>
						<button hx-post="/admin/api/sync/users" hx-target="#user-sync-feedback" class="bg-green-x-dark hover:bg-hl text-white font-bold text-xs uppercase tracking-widest px-4 py-2 rounded-lg transition-colors whitespace-nowrap shadow-sm">Sync Users</button>
					</div>
					<div id="user-sync-feedback" class="px-4"></div>
					<div class="flex-1 overflow-y-auto" id="user-list-container">
						for _, u := range users {
							<div class="p-4 border-b border-gray-50 hover:bg-gray-50 cursor-pointer flex items-center gap-4 transition-colors" 
								hx-get={ "/admin/api/user/" + u.ID } hx-target="#user-details-panel">
								if u.Thumbnail != "" {
									<img src={ u.Thumbnail } class="w-10 h-10 rounded-full object-cover"/>
								} else {
									<div class="w-10 h-10 rounded-full bg-green-x-light/20 flex items-center justify-center text-green-x-dark font-bold">{ string(u.FirstName[0]) }</div>
								}
								<div>
									<div class="font-bold text-gray-800 text-sm">{ u.FirstName } { u.LastName }</div>
									<div class="text-xs text-gray-500">{ u.Email }</div>
								</div>
							</div>
						}
					</div>
				</div>
				<div class="w-1/2 bg-gray-50 p-8 overflow-y-auto" id="user-details-panel">
					<div class="text-gray-400 text-sm mt-10 text-center font-medium">Select a user to view details</div>
				</div>
			</div>

			<div id="tab-groups" class="flex-1 flex overflow-hidden" style="display: none;">
				<div class="w-1/2 border-r border-gray-200 bg-white flex flex-col">
					<div class="p-4 border-b border-gray-100 flex items-center gap-4">
						<input type="text" id="admin-group-search" placeholder="Search groups by name..." class="flex-1 bg-gray-50 border border-gray-200 rounded-lg px-4 py-2 text-sm outline-none focus:border-hl focus:ring-2 focus:ring-hl/20 transition-all"/>
						<button hx-post="/admin/api/sync/usergroups" hx-target="#group-sync-feedback" class="bg-green-x-dark hover:bg-hl text-white font-bold text-xs uppercase tracking-widest px-4 py-2 rounded-lg transition-colors whitespace-nowrap shadow-sm">Sync Groups</button>
					</div>
					<div id="group-sync-feedback" class="px-4"></div>
					<div class="p-4 border-b border-gray-100 flex gap-2 bg-gray-50/50">
						<form hx-post="/admin/api/group" class="flex w-full gap-2 items-center">
							<input type="text" name="name" placeholder="New Group Name" required class="flex-1 bg-white border border-gray-200 rounded-lg px-3 py-2 text-sm outline-none focus:border-hl"/>
							<input type="number" name="level" placeholder="Lvl" required class="w-16 bg-white border border-gray-200 rounded-lg px-2 py-2 text-sm outline-none focus:border-hl"/>
							<button type="submit" class="bg-hl text-white px-3 py-2 rounded-lg text-xs font-bold uppercase tracking-widest hover:bg-green-x-dark">Add</button>
						</form>
					</div>
					<div class="flex-1 overflow-y-auto" id="group-list-container">
						for _, g := range groups {
							<div class="p-4 border-b border-gray-50 hover:bg-gray-50 cursor-pointer flex justify-between items-center transition-colors" 
								hx-get={ "/admin/api/group/" + g.ID } hx-target="#group-details-panel">
								<span class="font-bold text-gray-800 text-sm">{ g.Name }</span>
								<span class="bg-gray-100 text-gray-500 text-xs font-bold px-3 py-1 rounded-full border border-gray-200">Lvl { g.Level }</span>
							</div>
						}
					</div>
				</div>
				<div class="w-1/2 bg-gray-50 p-8 overflow-y-auto" id="group-details-panel">
					<div class="text-gray-400 text-sm mt-10 text-center font-medium">Select a group to edit details</div>
				</div>
			</div>
		</div>

		<script>
			window.switchTab = function(tab) {
				localStorage.setItem('adminActiveTab', tab); // Persist tab
				document.getElementById('tab-users').style.display = tab === 'users' ? 'flex' : 'none';
				document.getElementById('tab-groups').style.display = tab === 'groups' ? 'flex' : 'none';
				
				const btnUsers = document.getElementById('tab-btn-users');
				const btnGroups = document.getElementById('tab-btn-groups');
				
				if(tab === 'users') {
					btnUsers.className = "pb-3 text-sm font-bold tracking-widest uppercase border-b-2 border-hl text-hl transition-colors cursor-pointer";
					btnGroups.className = "pb-3 text-sm font-bold tracking-widest uppercase border-b-2 border-transparent text-gray-400 hover:text-gray-600 transition-colors cursor-pointer";
				} else {
					btnGroups.className = "pb-3 text-sm font-bold tracking-widest uppercase border-b-2 border-hl text-hl transition-colors cursor-pointer";
					btnUsers.className = "pb-3 text-sm font-bold tracking-widest uppercase border-b-2 border-transparent text-gray-400 hover:text-gray-600 transition-colors cursor-pointer";
				}
			}

			// Restore tab on load
			document.addEventListener('DOMContentLoaded', () => {
				const activeTab = localStorage.getItem('adminActiveTab') || 'users';
				window.switchTab(activeTab);
			});

			window.moveDashboards = function(dir) {
				const unassigned = document.getElementById('unassigned-dashboards');
				const assigned = document.getElementById('assigned-dashboards');
				
				if (dir === 'right') {
					Array.from(unassigned.selectedOptions).forEach(opt => assigned.appendChild(opt));
				} else {
					Array.from(assigned.selectedOptions).forEach(opt => unassigned.appendChild(opt));
				}
			}

			window.moveUnibosGroups = function(dir) {
				const unassigned = document.getElementById('unassigned-unibos');
				const assigned = document.getElementById('assigned-unibos');
				
				if (dir === 'right') {
					Array.from(unassigned.selectedOptions).forEach(opt => assigned.appendChild(opt));
				} else {
					Array.from(assigned.selectedOptions).forEach(opt => unassigned.appendChild(opt));
				}
			}

			document.body.addEventListener('htmx:configRequest', function(evt) {
				if(evt.detail.path.includes('/admin/api/group/')) {
					const assignedDashes = document.getElementById('assigned-dashboards');
					if(assignedDashes) {
						const vals = Array.from(assignedDashes.options).map(opt => opt.value);
						evt.detail.parameters['dashboards'] = vals; 
					}
					const assignedUnibos = document.getElementById('assigned-unibos');
					if(assignedUnibos) {
						const vals = Array.from(assignedUnibos.options).map(opt => opt.value);
						evt.detail.parameters['unibosGroups'] = vals; 
					}
				}
			});

			document.getElementById('admin-user-search').addEventListener('input', function(e) {
				const query = e.target.value.toLowerCase();
				const rows = document.getElementById('user-list-container').children;
				Array.from(rows).forEach(row => {
					row.style.display = row.innerText.toLowerCase().includes(query) ? 'flex' : 'none';
				});
			});

			document.getElementById('admin-group-search').addEventListener('input', function(e) {
				const query = e.target.value.toLowerCase();
				const rows = document.getElementById('group-list-container').children;
				Array.from(rows).forEach(row => {
					row.style.display = row.innerText.toLowerCase().includes(query) ? 'flex' : 'none';
				});
			});
		</script>
	}
}

templ userDetailsPanel(u auth.User, allGroups []auth.Group) {
	<div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
		<div class="flex items-center gap-6 mb-8 border-b border-gray-100 pb-6">
			if u.Thumbnail != "" {
				<img src={ u.Thumbnail } class="w-16 h-16 rounded-full object-cover shadow-sm"/>
			} else {
				<div class="w-16 h-16 rounded-full bg-green-x-light/20 flex items-center justify-center text-green-x-dark font-black text-2xl">{ string(u.FirstName[0]) }</div>
			}
			<div>
				<h2 class="text-2xl font-black text-gray-800 tracking-tight">{ u.FirstName } { u.LastName }</h2>
				<p class="text-sm text-gray-500 font-medium">{ u.Email }</p>
			</div>
		</div>

		<form hx-post={ "/admin/api/user/" + u.ID + "/groups" } class="flex flex-col gap-6">
			<div>
				<h3 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-3">Group Assignments</h3>
				<div class="border border-gray-200 rounded-lg p-3 bg-gray-50 max-h-48 overflow-y-auto grid grid-cols-2 gap-2">
					for _, g := range allGroups {
						<label class="flex items-center gap-2 p-2 hover:bg-gray-100 rounded cursor-pointer transition-colors">
							<input type="checkbox" name="groups" value={ g.ID } class="rounded border-gray-300 text-hl focus:ring-hl/20" checked?={ containsString(u.Groups, g.ID) } />
							<span class="text-xs font-bold text-gray-700">{ g.Name } <span class="font-normal text-gray-400 ml-1">(Lvl: { g.Level })</span></span>
						</label>
					}
				</div>
			</div>

			<div>
				<h3 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-3">Tool Assignments</h3>
				<div class="border border-gray-200 rounded-lg p-3 bg-gray-50 grid grid-cols-2 gap-2">
					for _, tool := range []string{"Campaigns", "Unifi Words", "Credit Policy", "Targets", "Dataform"} {
						<label class="flex items-center gap-2 p-2 hover:bg-gray-100 rounded cursor-pointer transition-colors">
							<input type="checkbox" name="tools" value={ tool } class="rounded border-gray-300 text-hl focus:ring-hl/20" checked?={ containsString(u.Tools, tool) } />
							<span class="text-xs font-bold text-gray-700">{ tool }</span>
						</label>
					}
				</div>
			</div>

			<div class="mt-2 flex justify-end">
				<button type="submit" class="bg-hl hover:bg-green-x-dark text-white font-bold text-xs uppercase tracking-widest px-6 py-2.5 rounded-lg transition-colors">Save Assignments</button>
			</div>
		</form>
	</div>
}

templ groupDetailsPanel(g auth.Group, allDashboards []auth.Dashboard, unibosGroups []string) {
	<div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm relative">
		<button hx-delete={ "/admin/api/group/" + g.ID } hx-confirm="Are you sure you want to delete this group?" class="absolute top-6 right-6 text-gray-400 hover:text-red-500 transition-colors">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
		</button>

		<form hx-post={ "/admin/api/group/" + g.ID } class="flex flex-col gap-6">
			<div>
				<h3 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-3">Group Details</h3>
				<div class="flex gap-4">
					<div class="flex-1">
						<label class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-1">Name</label>
						<input type="text" name="name" value={ g.Name } required class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:border-hl outline-none"/>
					</div>
					<div class="w-24">
						<label class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-1">Level</label>
						<input type="number" name="level" value={ g.Level } required class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:border-hl outline-none"/>
					</div>
				</div>
			</div>

			<div>
				<h3 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-3">Dashboard Assignments</h3>
				<div class="flex items-center gap-4">
					<div class="flex-1 flex flex-col gap-1">
						<label class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">Unassigned</label>
						<select id="unassigned-dashboards" multiple class="w-full h-48 border border-gray-200 rounded-lg p-2 text-xs font-medium text-gray-700 bg-gray-50 focus:border-hl outline-none">
							for _, d := range allDashboards {
								if !containsString(g.Dashboards, d.ID) {
									<option value={ d.ID } class="p-1.5 hover:bg-green-x-light/10">{ d.Name }</option>
								}
							}
						</select>
					</div>

					<div class="flex flex-col gap-2 pt-5">
						<button type="button" onclick="window.moveDashboards('right')" class="p-2 rounded bg-gray-100 hover:bg-gray-200 text-gray-600 transition-colors">▶</button>
						<button type="button" onclick="window.moveDashboards('left')" class="p-2 rounded bg-gray-100 hover:bg-gray-200 text-gray-600 transition-colors">◀</button>
					</div>

					<div class="flex-1 flex flex-col gap-1">
						<label class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">Assigned</label>
						<select id="assigned-dashboards" name="dashboards" multiple class="w-full h-48 border border-gray-200 rounded-lg p-2 text-xs font-medium text-gray-700 bg-gray-50 focus:border-hl outline-none">
							for _, d := range allDashboards {
								if containsString(g.Dashboards, d.ID) {
									<option value={ d.ID } class="p-1.5 hover:bg-green-x-light/10">{ d.Name }</option>
								}
							}
						</select>
					</div>
				</div>
			</div>

			<div>
				<h3 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-3">Unibos Mapping</h3>
				<div class="flex items-center gap-4">
					<div class="flex-1 flex flex-col gap-1">
						<label class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">Unassigned Unibos Groups</label>
						<select id="unassigned-unibos" multiple class="w-full h-48 border border-gray-200 rounded-lg p-2 text-xs font-medium text-gray-700 bg-gray-50 focus:border-hl outline-none">
							if len(unibosGroups) == 0 {
								<option disabled class="text-gray-400 italic">No Groups Found...</option>
							}
							for _, groupName := range unibosGroups {
								if !containsString(g.UnibosGroups, groupName) {
									<option value={ groupName } class="p-1.5 hover:bg-green-x-light/10">{ groupName }</option>
								}
							}
						</select>
					</div>

					<div class="flex flex-col gap-2 pt-5">
						<button type="button" onclick="window.moveUnibosGroups('right')" class="p-2 rounded bg-gray-100 hover:bg-gray-200 text-gray-600 transition-colors">▶</button>
						<button type="button" onclick="window.moveUnibosGroups('left')" class="p-2 rounded bg-gray-100 hover:bg-gray-200 text-gray-600 transition-colors">◀</button>
					</div>

					<div class="flex-1 flex flex-col gap-1">
						<label class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">Mapped Unibos Groups</label>
						<select id="assigned-unibos" name="unibosGroups" multiple class="w-full h-48 border border-gray-200 rounded-lg p-2 text-xs font-medium text-gray-700 bg-gray-50 focus:border-hl outline-none">
							for _, groupName := range unibosGroups {
								if containsString(g.UnibosGroups, groupName) {
									<option value={ groupName } class="p-1.5 hover:bg-green-x-light/10">{ groupName }</option>
								}
							}
						</select>
					</div>
				</div>
			</div>

			<div>
				<h3 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-3">Tool Assignments</h3>
				<div class="border border-gray-200 rounded-lg p-3 bg-gray-50 grid grid-cols-2 gap-2">
					for _, tool := range []string{"Campaigns", "Unifi Words", "Credit Policy", "Targets", "Dataform"} {
						<label class="flex items-center gap-2 p-2 hover:bg-gray-100 rounded cursor-pointer transition-colors">
							<input type="checkbox" name="tools" value={ tool } class="rounded border-gray-300 text-hl focus:ring-hl/20" checked?={ containsString(g.Tools, tool) } />
							<span class="text-xs font-bold text-gray-700">{ tool }</span>
						</label>
					}
				</div>
			</div>

			<div class="mt-2 flex justify-end">
				<button type="submit" class="bg-hl hover:bg-green-x-dark text-white font-bold text-xs uppercase tracking-widest px-6 py-2.5 rounded-lg transition-colors">Save Group</button>
			</div>
		</form>
	</div>
}

func containsString(slice []string, val string) bool {
	for _, item := range slice {
		if item == val { return true }
	}
	return false
}