package base

import "fmt"
import "controlroom/app/backend/ui/layout"

templ dashboardView(data DashboardData) {
	@layout.Html("Dashboard") {
		<div class="relative w-full h-full bg-white overflow-hidden flex flex-col font-sans animate-fade-in">
			
			<div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none z-0 overflow-hidden">
				<h1 class="text-[12vw] font-black leading-none tracking-tighter text-gray-200 m-0 p-0 whitespace-nowrap opacity-50">CONTROLROOM</h1>
			</div>

			<div class="relative z-10 flex flex-wrap gap-8 items-start justify-start w-full p-8 md:p-12">
				
				<a href="/costing" class="group bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] border border-gray-100 flex flex-col w-[340px] overflow-hidden hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
					<div class="bg-green-x-light px-5 py-3.5 flex items-center gap-2.5 text-white">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
						</svg>
						<span class="font-medium text-sm tracking-wide">Total Operational Cost</span>
					</div>
					<div class="p-6 flex flex-col items-center">
						<div class="text-[2.5rem] font-black text-gray-900 mb-6 tracking-tight leading-none">{ data.CurrentSpend }</div>
						
						<div class="w-full h-16 relative">
							<svg viewBox="0 0 100 30" preserveAspectRatio="none" class="w-full h-full overflow-visible">
								<defs>
									<linearGradient id="gradCost" x1="0%" y1="0%" x2="0%" y2="100%">
										<stop offset="0%" stop-color="#3b82f6" stop-opacity="0.15" />
										<stop offset="100%" stop-color="#3b82f6" stop-opacity="0" />
									</linearGradient>
								</defs>
								<path d={ data.CostPathStorage } fill="none" stroke="#f59e0b" stroke-width="1.2" stroke-linecap="round"/>
								<path d={ data.CostPathCompute } fill="none" stroke="#ec4899" stroke-width="1.2" stroke-linecap="round"/>
								<path d={ data.CostPathData } fill="none" stroke="#3b82f6" stroke-width="1.5" stroke-linecap="round"/>
								<path d={ data.CostPathFill } fill="url(#gradCost)" />
							</svg>
						</div>
						
						<div class="w-full flex justify-between px-1 text-[9px] text-gray-400 font-medium mt-2">
							for _, label := range data.DayLabels {
								<span>{ label }</span>
							}
						</div>

						<div class="text-[11px] text-gray-500 mt-5 font-medium">
							vs last week: 
							if data.SpendDeltaPositive {
								<span class="text-green-500">{ data.SpendDeltaPct } ({ data.SpendDeltaVal })</span>
							} else {
								<span class="text-red-500">{ data.SpendDeltaPct } ({ data.SpendDeltaVal })</span>
							}
						</div>
					</div>
				</a>

				<a href="/kb" class="group bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] border border-gray-100 flex flex-col w-[340px] overflow-hidden hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
					<div class="bg-green-x-light px-5 py-3.5 flex items-center gap-2.5 text-white">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5a3.375 3.375 0 00-3.375-3.375H9.75" />
						</svg>
						<span class="font-medium text-sm tracking-wide">Total Documents & Pages</span>
					</div>
					<div class="p-6 flex flex-col items-center">
						<div class="text-[2.5rem] font-black text-gray-900 mb-6 tracking-tight leading-none">{ fmt.Sprintf("%d", data.TotalKBPages) }</div>
						
						<div class="w-full h-16 relative flex items-end justify-between px-2">
							<div class="flex items-end gap-1 h-full">
								<div class="w-2.5 bg-[#06b6d4] rounded-t-sm transition-all" style={ fmt.Sprintf("height: %d%%;", data.KBCreatedHeights[0]) }></div>
								<div class="w-2.5 bg-[#ec4899] rounded-t-sm transition-all" style={ fmt.Sprintf("height: %d%%;", data.KBUpdatedHeights[0]) }></div>
							</div>
							<div class="flex items-end gap-1 h-full">
								<div class="w-2.5 bg-[#eab308] rounded-t-sm transition-all" style={ fmt.Sprintf("height: %d%%;", data.KBCreatedHeights[1]) }></div>
								<div class="w-2.5 bg-[#8b5cf6] rounded-t-sm transition-all" style={ fmt.Sprintf("height: %d%%;", data.KBUpdatedHeights[1]) }></div>
							</div>
							<div class="flex items-end gap-1 h-full">
								<div class="w-2.5 bg-[#4ab8a1] rounded-t-sm transition-all" style={ fmt.Sprintf("height: %d%%;", data.KBCreatedHeights[2]) }></div>
								<div class="w-2.5 bg-[#f59e0b] rounded-t-sm transition-all" style={ fmt.Sprintf("height: %d%%;", data.KBUpdatedHeights[2]) }></div>
							</div>
							<div class="flex items-end gap-1 h-full">
								<div class="w-2.5 bg-[#3b82f6] rounded-t-sm transition-all" style={ fmt.Sprintf("height: %d%%;", data.KBCreatedHeights[3]) }></div>
								<div class="w-2.5 bg-[#ec4899] rounded-t-sm transition-all" style={ fmt.Sprintf("height: %d%%;", data.KBUpdatedHeights[3]) }></div>
							</div>
							<div class="flex items-end gap-1 h-full">
								<div class="w-2.5 bg-[#eab308] rounded-t-sm transition-all" style={ fmt.Sprintf("height: %d%%;", data.KBCreatedHeights[4]) }></div>
								<div class="w-2.5 bg-[#06b6d4] rounded-t-sm transition-all" style={ fmt.Sprintf("height: %d%%;", data.KBUpdatedHeights[4]) }></div>
							</div>
							<div class="flex items-end gap-1 h-full">
								<div class="w-2.5 bg-[#8b5cf6] rounded-t-sm transition-all" style={ fmt.Sprintf("height: %d%%;", data.KBCreatedHeights[5]) }></div>
								<div class="w-2.5 bg-[#4ab8a1] rounded-t-sm transition-all" style={ fmt.Sprintf("height: %d%%;", data.KBUpdatedHeights[5]) }></div>
							</div>
							<div class="flex items-end gap-1 h-full">
								<div class="w-2.5 bg-[#f59e0b] rounded-t-sm transition-all" style={ fmt.Sprintf("height: %d%%;", data.KBCreatedHeights[6]) }></div>
								<div class="w-2.5 bg-[#3b82f6] rounded-t-sm transition-all" style={ fmt.Sprintf("height: %d%%;", data.KBUpdatedHeights[6]) }></div>
							</div>
						</div>

						<div class="w-full flex justify-between px-1 text-[9px] text-gray-400 font-medium mt-2">
							for _, label := range data.DayLabels {
								<span>{ label }</span>
							}
						</div>

						<div class="text-[11px] text-gray-500 mt-5 font-medium">
							vs last week: 
							if data.KBDeltaPositive {
								<span class="text-green-500">{ data.KBDeltaPct } (+{ fmt.Sprintf("%d", data.KBDeltaVal) } pages)</span>
							} else {
								<span class="text-red-500">{ data.KBDeltaPct } ({ fmt.Sprintf("%d", data.KBDeltaVal) } pages)</span>
							}
						</div>
					</div>
				</a>

			</div>
		</div>
	}
}