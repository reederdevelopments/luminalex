
package base

import "controlroom/app/backend/auth"
import "controlroom/app/backend/ui/layout"

templ homePage(user auth.User) {
	@layout.HtmlFullPage("Control Room") {
		<script src="https://unpkg.com/htmx.org@1.9.12" crossorigin="anonymous"></script>
		<link rel="stylesheet" href="/assets/styles/main_ui.css"/>

		<script type="text/javascript">
			window.setSidebarState = function(state) {
				document.body.setAttribute('data-sidebar', state);
			};
		</script>

		<div id="ujuzi-menu-btn" class="fixed top-0 left-0 z-[1000] transition-all duration-300" onclick="window.setSidebarState('active')">
			<div class="bg-red-x-light text-white px-6 py-2 rounded-br-md text-[10px] font-bold uppercase tracking-widest cursor-pointer shadow-md transition-colors hover:bg-red-x-dark leading-tight">
				Menu
			</div>
		</div>

		<div id="main-view-container" class="absolute inset-2 md:inset-4 border border-gray-200/60 rounded-xl shadow-2xl bg-white overflow-hidden flex z-10">
			<iframe src="/dashboard" id="main-view" name="main-view" title="Content Frame" class="w-full h-full border-none block bg-transparent"></iframe>
		</div>

		<nav id="platform-menu" class="fixed top-0 left-0 w-full md:w-[18vw] h-full bg-green-x-dark border-r border-green-x-dark shadow-2xl z-[999] flex flex-col pt-4">
			
			<div class="absolute right-6 top-8 text-green-x-light hover:text-white cursor-pointer transition-colors z-[10000] flex items-center justify-center pointer-events-auto" onclick="window.setSidebarState('closed')">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
			</div>

			<div class="flex-1 overflow-y-auto flex flex-col hide-scrollbar">
				<div class="flex flex-col px-6 pb-4 pt-4 border-b border-green-x-light/30 relative z-[1000]">
					<div class="text-2xl font-black tracking-widest text-white drop-shadow-sm">CONTROLROOM</div>
					<div class="text-[10px] font-bold uppercase tracking-wider text-green-x-light mt-1 mb-4">{ user.Name }</div>
					
					<div class="relative w-full group">
						<div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
							<svg class="w-4 h-4 text-green-x-light group-focus-within:text-white transition-colors" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
							</svg>
						</div>
						<input 
							type="search" 
							name="q"
							hx-get="/search" 
							hx-trigger="input changed delay:300ms, search" 
							hx-target="#search-results"
							hx-swap="innerHTML"
							class="block w-full p-2.5 pl-10 text-xs text-white bg-green-x-dark/50 border border-green-x-light/40 rounded-lg focus:ring-green-x-light focus:border-green-x-light placeholder-green-x-light/70 outline-none transition-all" 
							placeholder="Search across app..." 
							autocomplete="off"
						/>
						<div id="search-results" class="absolute top-full left-0 w-full mt-2 z-[1000]"></div>
					</div>
				</div>

				<div class="flex flex-col py-4 gap-2 px-4 relative z-40">
					<a href="/dashboard" target="main-view" onclick="if(window.innerWidth < 768) window.setSidebarState('closed')" class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-green-x-light/20 transition-colors cursor-pointer group">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-green-x-light group-hover:text-white transition-colors"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>
						<span class="text-sm font-semibold tracking-wide">Home</span>
					</a>

					<a href="/kb" target="main-view" onclick="if(window.innerWidth < 768) window.setSidebarState('closed')" class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-green-x-light/20 transition-colors cursor-pointer group">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-green-x-light group-hover:text-white transition-colors"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" /></svg>
						<span class="text-sm font-semibold tracking-wide">Knowledge Base</span>
					</a>

					<a href="/costing" target="main-view" onclick="if(window.innerWidth < 768) window.setSidebarState('closed')" class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-green-x-light/20 transition-colors cursor-pointer group">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-green-x-light group-hover:text-white transition-colors"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
						<span class="text-sm font-semibold tracking-wide">Costing</span>
					</a>

					<details class="group">
						<summary class="flex items-center justify-between px-4 py-3 rounded-lg text-white hover:bg-green-x-light/20 transition-colors cursor-pointer list-none">
							<div class="flex items-center gap-3">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-green-x-light group-hover:text-white transition-colors"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
								<span class="text-sm font-semibold tracking-wide">Monitoring</span>
							</div>
							<span class="transition group-open:rotate-180">
								<svg fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="16"><path d="M6 9l6 6 6-6"></path></svg>
							</span>
						</summary>
						<div class="flex flex-col gap-1 pl-11 pr-4 pb-2 mt-1">
							<a href="/monitoring/thirdparty" target="main-view" onclick="if(window.innerWidth < 768) window.setSidebarState('closed')" class="px-3 py-2 rounded-md text-green-x-light hover:text-white hover:bg-green-x-light/20 transition-colors cursor-pointer text-xs font-semibold tracking-wide">
								Third Party
							</a>
						</div>
					</details>
				</div>
			</div>

			<div class="mt-auto w-full bg-green-x-dark border-t border-green-x-light/30">
                <div class="px-5 py-4">
					<a href="/logout" class="flex w-full items-center justify-center gap-2 rounded-lg bg-red-x-light px-4 py-2.5 text-xs font-bold tracking-wide text-white shadow hover:bg-red-x-dark transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" /></svg>
						SIGN OUT
					</a>
				</div>
			</div>
		</nav>
	}
}

templ searchDropdown(results []SearchResult, query string) {
	if query != "" {
		<div class="bg-white rounded-lg shadow-2xl border border-gray-200 overflow-hidden w-full">
			if len(results) > 0 {
				<ul class="divide-y divide-gray-100 max-h-64 overflow-y-auto">
					for _, res := range results {
						<li>
							<a href={ templ.SafeURL(res.URL) } target="main-view" onclick="if(window.innerWidth < 768) window.setSidebarState('closed'); document.getElementById('search-results').innerHTML=''" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition-colors">
								<span class="text-lg">{ res.Icon }</span>
								<div class="flex flex-col">
									<span class="text-xs font-bold text-gray-800">{ res.Title }</span>
									<span class="text-[9px] font-semibold text-gray-400 uppercase tracking-widest">{ res.Type }</span>
								</div>
							</a>
						</li>
					}
				</ul>
			} else {
				<div class="p-4 text-xs font-medium text-gray-500 text-center bg-gray-50">No results found for "{ query }"</div>
			}
		</div>
	}
}