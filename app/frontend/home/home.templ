package base

import "controlroom/app/backend/auth"
import "controlroom/app/backend/ui/layout"

templ homePage(user auth.User) {
	@layout.HtmlFullPage("Control Room") {
		<link rel="stylesheet" href="/assets/styles/main_ui.css"/>

		<div id="ujuzi-menu-btn" class="fixed top-0 left-0 z-[1000] transition-all duration-300" onclick="setSidebarState('active')">
			<div class="bg-red-600 text-white px-6 py-2 rounded-br-md text-[10px] font-bold uppercase tracking-widest cursor-pointer shadow-md transition-colors hover:bg-red-700 leading-tight">
				Menu
			</div>
		</div>

		<div id="main-view-container" class="absolute inset-2 md:inset-4 border border-gray-200/60 rounded-xl shadow-2xl bg-white overflow-hidden flex z-10">
			<iframe src="/costing" id="main-view" name="main-view" title="Content Frame" class="w-full h-full border-none block bg-transparent"></iframe>
		</div>

		<nav id="platform-menu" class="fixed top-0 left-0 w-full md:w-[18vw] h-full bg-green-x-dark border-r border-green-x-dark shadow-2xl z-[999] flex flex-col pt-4">
			
			<div class="absolute right-6 top-8 text-green-x-light hover:text-white cursor-pointer transition-colors z-50 flex items-center justify-center" onclick="setSidebarState('closed')">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</div>

			<div class="flex-1 overflow-y-auto flex flex-col hide-scrollbar">
				<div class="flex justify-between items-center px-6 pb-4 pt-4 border-b border-green-x-light/30 relative">
					<div class="flex flex-col">
						<div class="text-2xl font-black tracking-widest text-white drop-shadow-sm">CONTROLROOM</div>
						<div class="text-[10px] font-bold uppercase tracking-wider text-green-x-light mt-1">{ user.Name }</div>
					</div>
				</div>

				<div class="flex flex-col py-4 gap-2 px-4">
					<a href="/costing" target="main-view" onclick="if(window.innerWidth < 768) setSidebarState('closed')" class="flex items-center gap-3 px-4 py-3 rounded-lg text-white hover:bg-green-x-light/20 transition-colors cursor-pointer group">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-green-x-light group-hover:text-white transition-colors">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
						<span class="text-sm font-semibold tracking-wide">Costing</span>
					</a>
				</div>
			</div>

			<div class="mt-auto w-full bg-green-x-dark border-t border-green-x-light/30">
                <div class="px-5 py-4">
					<a href="/logout" class="flex w-full items-center justify-center gap-2 rounded-lg bg-red-x-light px-4 py-2.5 text-xs font-bold tracking-wide text-white shadow hover:bg-red-x-dark transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
							<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
						</svg>
						SIGN OUT
					</a>
				</div>
				<div class="text-center text-[9px] text-green-x-light/60 font-mono tracking-widest pb-3">
					v 1.0.0 // SYS
				</div>
			</div>
		</nav>
		<script src="/assets/scripts/main_ui.js"></script>
	}
}