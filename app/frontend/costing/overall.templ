package costing

import "strings"

templ overallTab(data CostingDashboardData) {
	<div class="flex flex-col gap-4 animate-fade-in h-full relative">
		<script>
			if (window.parent && window.parent.document) {
				const menuBtn = window.parent.document.querySelector('#ujuzi-menu-btn div');
				if (menuBtn) { menuBtn.innerText = 'MENU - OVERALL GCP SPEND'; }
			}
		</script>

		<div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex flex-col gap-4 shrink-0 relative z-40">
			<div class="flex flex-wrap items-center gap-2 border-b border-gray-100 pb-2">
				<span class="text-xs font-bold text-gray-400 uppercase tracking-widest mr-2">Quick Select:</span>
				<button type="button" onclick="setOVDateRange('today')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Today</button>
				<button type="button" onclick="setOVDateRange('yesterday')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Yesterday</button>
				<button type="button" onclick="setOVDateRange('current_week')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Current Week</button>
				<button type="button" onclick="setOVDateRange('last_week')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Last Week</button>
				<button type="button" onclick="setOVDateRange('current_month')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Current Month</button>
				<button type="button" onclick="setOVDateRange('last_month')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Last Month</button>
				<button type="button" onclick="setOVDateRange('last_30')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Last 30 Days</button>
				<button type="button" onclick="setOVDateRange('last_90')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Last 90 Days</button>
				<button type="button" onclick="setOVDateRange('ytd')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Year to Date</button>
			</div>

			<form 
				id="ov-costing-form"
				hx-get="/costing/overall/metrics" 
				hx-target="#ov-metrics-container"
				hx-trigger="submit, load"
				hx-indicator=".htmx-indicator"
				class="flex flex-wrap gap-4 items-center w-full"
			>
				<div class="flex items-center gap-2 pr-4 border-r border-gray-200">
					<input type="date" id="ov_start_date" name="start_date" value={ data.StartDate } class="text-sm rounded-md border-gray-300 focus:ring-green-x-light focus:border-green-x-light py-1.5" />
					<span class="text-xs font-semibold text-gray-400">TO</span>
					<input type="date" id="ov_end_date" name="end_date" value={ data.EndDate } class="text-sm rounded-md border-gray-300 focus:ring-green-x-light focus:border-green-x-light py-1.5" />
				</div>

				<select name="grouping" class="text-sm rounded-md border-gray-300 focus:ring-green-x-light focus:border-green-x-light py-1.5 ml-4">
					<option value="daily" selected>Daily Graph View</option>
					<option value="monthly">Monthly Graph View</option>
					<option value="yearly">Yearly Graph View</option>
				</select>
				
				<button type="submit" class="ml-auto bg-green-x-dark text-white px-5 py-2 rounded-md text-xs font-bold uppercase tracking-wider hover:bg-green-x-light transition-all shadow-sm">
					Apply Filters
				</button>
			</form>
		</div>

		<div id="ov-metrics-container" class="flex flex-col gap-6 h-full relative z-30"></div>

		<script>
			function setOVDateRange(type) {
				const startInput = document.getElementById('ov_start_date');
				const endInput = document.getElementById('ov_end_date');
				const today = new Date();
				let start = new Date(today);
				let end = new Date(today);

				switch(type) {
					case 'today': break;
					case 'yesterday':
						start.setDate(today.getDate() - 1);
						end.setDate(today.getDate() - 1);
						break;
					case 'current_week':
						const day1 = start.getDay();
						start.setDate(start.getDate() - day1 + (day1 === 0 ? -6 : 1));
						break;
					case 'last_week':
						const day2 = start.getDay();
						start.setDate(start.getDate() - day2 + (day2 === 0 ? -6 : 1) - 7);
						end = new Date(start);
						end.setDate(start.getDate() + 6);
						break;
					case 'current_month':
						start = new Date(today.getFullYear(), today.getMonth(), 1); 
						break;
					case 'last_month':
						start = new Date(today.getFullYear(), today.getMonth() - 1, 1); 
						end = new Date(today.getFullYear(), today.getMonth(), 0); 
						break;
					case 'last_30':
						start.setDate(today.getDate() - 30); break;
					case 'last_90':
						start.setDate(today.getDate() - 90); break;
					case 'ytd':
						start = new Date(today.getFullYear(), 0, 1); break;
				}

				const fmt = d => {
					const offset = d.getTimezoneOffset();
					return new Date(d.getTime() - (offset*60*1000)).toISOString().split('T')[0];
				};

				if (start && end) {
					startInput.value = fmt(start);
					endInput.value = fmt(end);
					document.getElementById('ov-costing-form').dispatchEvent(new Event('submit', { cancelable: true }));
				}
			}
		</script>
	</div>
}

templ overallMetrics(tableData OverallTableData, chartDataJSON string) {
	<div class="grid grid-cols-1 md:grid-cols-4 gap-4 shrink-0">
		<div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4 relative overflow-hidden flex flex-col justify-center">
			<div class="absolute -right-4 -bottom-4 opacity-5">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-32 h-32 text-gray-900"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
			</div>
			<div class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1 relative z-10">Grand Total GCP Spend</div>
			<div class="text-3xl font-black text-gray-900 relative z-10">{ tableData.KPIs.TotalCost }</div>
			<div class={ "text-[11px] font-bold mt-1 relative z-10", templ.KV("text-red-500", strings.Contains(tableData.KPIs.TotalDelta, "▲")), templ.KV("text-green-500", strings.Contains(tableData.KPIs.TotalDelta, "▼")), templ.KV("text-gray-400", tableData.KPIs.TotalDelta == "0%" || tableData.KPIs.TotalDelta == "-") }>
				{ tableData.KPIs.TotalDelta } <span class="text-gray-400 font-medium ml-1">vs prev. period</span>
			</div>
		</div>

		<div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4 relative overflow-hidden flex flex-col justify-center">
			<div class="absolute -right-4 -bottom-4 opacity-5">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-32 h-32 text-gray-900"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z" /><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z" /></svg>
			</div>
			<div class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1 relative z-10">Data Analytics (BigQuery)</div>
			<div class="text-2xl font-black text-gray-800 relative z-10">{ tableData.KPIs.DataCost }</div>
			<div class={ "text-[11px] font-bold mt-1 relative z-10", templ.KV("text-red-500", strings.Contains(tableData.KPIs.DataDelta, "▲")), templ.KV("text-green-500", strings.Contains(tableData.KPIs.DataDelta, "▼")), templ.KV("text-gray-400", tableData.KPIs.DataDelta == "0%" || tableData.KPIs.DataDelta == "-") }>
				{ tableData.KPIs.DataDelta } <span class="text-gray-400 font-medium ml-1">vs prev. period</span>
			</div>
		</div>

		<div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4 relative overflow-hidden flex flex-col justify-center">
			<div class="absolute -right-4 -bottom-4 opacity-5">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-32 h-32 text-gray-900"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008z" /></svg>
			</div>
			<div class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1 relative z-10">Compute (Run & Func)</div>
			<div class="text-2xl font-black text-gray-800 relative z-10">{ tableData.KPIs.ComputeCost }</div>
			<div class={ "text-[11px] font-bold mt-1 relative z-10", templ.KV("text-red-500", strings.Contains(tableData.KPIs.ComputeDelta, "▲")), templ.KV("text-green-500", strings.Contains(tableData.KPIs.ComputeDelta, "▼")), templ.KV("text-gray-400", tableData.KPIs.ComputeDelta == "0%" || tableData.KPIs.ComputeDelta == "-") }>
				{ tableData.KPIs.ComputeDelta } <span class="text-gray-400 font-medium ml-1">vs prev. period</span>
			</div>
		</div>

		<div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4 relative overflow-hidden flex flex-col justify-center">
			<div class="absolute -right-4 -bottom-4 opacity-5">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-32 h-32 text-gray-900"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" /></svg>
			</div>
			<div class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1 relative z-10">Storage & DBs</div>
			<div class="text-2xl font-black text-gray-800 relative z-10">{ tableData.KPIs.StorageCost }</div>
			<div class={ "text-[11px] font-bold mt-1 relative z-10", templ.KV("text-red-500", strings.Contains(tableData.KPIs.StorageDelta, "▲")), templ.KV("text-green-500", strings.Contains(tableData.KPIs.StorageDelta, "▼")), templ.KV("text-gray-400", tableData.KPIs.StorageDelta == "0%" || tableData.KPIs.StorageDelta == "-") }>
				{ tableData.KPIs.StorageDelta } <span class="text-gray-400 font-medium ml-1">vs prev. period</span>
			</div>
		</div>
	</div>

	<div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm shrink-0 flex flex-col min-h-[300px] relative z-20">
		<div class="flex justify-between items-center mb-3">
			<h3 class="text-sm font-bold text-gray-800 uppercase tracking-wide">Macro-Cost Category Trend</h3>
		</div>
		<div class="relative w-full flex-1 min-h-0"><canvas id="ovCostChart"></canvas></div>

		@templ.JSONScript("ov-chart-data", chartDataJSON)

		<script>
			(function initOVCart() {
				if (window.ovCostChartInstance) { window.ovCostChartInstance.destroy(); }
				const canvas = document.getElementById('ovCostChart');
				if (!canvas) return;

				let rawDataStr = document.getElementById('ov-chart-data').textContent;
				let rawData = JSON.parse(rawDataStr);
				if (typeof rawData === 'string') { rawData = JSON.parse(rawData); }

				const datesSet = new Set();
				const datasetsMap = {}; 
				const totalsByDate = {}; 

				const colorPalette = {
					'Data Analytics': { border: '#1e4b41', bg: '#286256' },
					'Compute': { border: '#38917e', bg: '#4AB8A1' },
					'Storage & DBs': { border: '#84191b', bg: '#A52022' },
					'Other': { border: '#6b7280', bg: '#9ca3af' } 
				};

				rawData.forEach(d => {
					datesSet.add(d.date);
					let labelName = d.category; 
					if (!datasetsMap[labelName]) {
						datasetsMap[labelName] = {
							type: 'bar', label: labelName, data: {},
							backgroundColor: colorPalette[labelName] ? colorPalette[labelName].bg : '#9ca3af',
							borderWidth: 0, order: 2 
						};
					}
					datasetsMap[labelName].data[d.date] = (datasetsMap[labelName].data[d.date] || 0) + d.cost;
					totalsByDate[d.date] = (totalsByDate[d.date] || 0) + d.cost;
				});

				const sortedDates = Array.from(datesSet).sort();
				const finalDatasets = Object.values(datasetsMap).map(ds => {
					return { ...ds, data: sortedDates.map(date => ds.data[date] || 0) };
				});

				finalDatasets.push({
					type: 'line', label: 'Total Cost Trend',
					data: sortedDates.map(date => totalsByDate[date] || 0),
					borderColor: '#1F2937', borderWidth: 2, borderDash: [5, 5], fill: false, pointRadius: 2, order: 1 
				});

				const ctx = canvas.getContext('2d');
				window.ovCostChartInstance = new Chart(ctx, {
					type: 'bar',
					data: { labels: sortedDates, datasets: finalDatasets },
					options: {
						responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
						plugins: { legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 8, font: {size: 11} } } },
						scales: { x: { stacked: true, grid: { display: false } }, y: { stacked: true, beginAtZero: true, grid: { color: '#f3f4f6', drawBorder: false }, ticks: { callback: function(value) { return '$' + value; } } } }
					}
				});
			})();
		</script>
	</div>

	<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden flex-1 relative z-30 min-h-0 flex flex-col">
		<div class="px-4 py-3 border-b border-gray-200 bg-gray-50 flex justify-between items-center shrink-0">
			<h2 class="text-sm font-bold text-gray-800 uppercase tracking-wide">Breakdown by Project</h2>
		</div>
		<div class="overflow-y-auto flex-1 hide-scrollbar">
			<table class="min-w-full divide-y divide-gray-200">
				<thead class="bg-gray-50 sticky top-0 z-10">
					<tr>
						<th scope="col" class="px-6 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Project ID</th>
						<th scope="col" class="px-6 py-2 text-right text-[10px] font-bold text-gray-500 uppercase tracking-wider">Data Analytics</th>
						<th scope="col" class="px-6 py-2 text-right text-[10px] font-bold text-gray-500 uppercase tracking-wider">Compute</th>
						<th scope="col" class="px-6 py-2 text-right text-[10px] font-bold text-gray-500 uppercase tracking-wider">Storage</th>
						<th scope="col" class="px-6 py-2 text-right text-[10px] font-bold text-gray-500 uppercase tracking-wider">Other</th>
						<th scope="col" class="px-6 py-2 text-right text-[10px] font-black text-gray-800 uppercase tracking-wider bg-gray-100">Project Total</th>
					</tr>
				</thead>
				<tbody class="bg-white divide-y divide-gray-100">
					for _, p := range tableData.Projects {
						<tr class="hover:bg-gray-50 transition-colors">
							<td class="px-6 py-2 whitespace-nowrap text-xs font-bold text-gray-800">{ p.ProjectID }</td>
							<td class="px-6 py-2 whitespace-nowrap text-right text-xs text-gray-500 font-medium">{ p.DataCost }</td>
							<td class="px-6 py-2 whitespace-nowrap text-right text-xs text-gray-500 font-medium">{ p.ComputeCost }</td>
							<td class="px-6 py-2 whitespace-nowrap text-right text-xs text-gray-500 font-medium">{ p.StorageCost }</td>
							<td class="px-6 py-2 whitespace-nowrap text-right text-xs text-gray-400">{ p.OtherCost }</td>
							<td class="px-6 py-2 whitespace-nowrap text-right text-xs font-black text-gray-900 bg-gray-50/50">{ p.TotalCost }</td>
						</tr>
					}
					if len(tableData.Projects) == 0 {
						<tr><td colspan="6" class="px-6 py-6 text-center text-sm text-gray-500">No active project billing found in this timeframe.</td></tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}