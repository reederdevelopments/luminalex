package costing

import (
	"fmt"
)

templ datastudioTab(data CostingDashboardData) {
	<div class="flex flex-col gap-4 animate-fade-in h-full relative">
		<script>
			if (window.parent && window.parent.document) {
				const menuBtn = window.parent.document.querySelector('#ujuzi-menu-btn div');
				if (menuBtn) { menuBtn.innerText = 'MENU - DATASTUDIO COSTING'; }
			}
		</script>

		<dialog id="ds-mapping-modal" class="backdrop:bg-black/40 p-6 rounded-xl shadow-2xl w-full max-w-md bg-white border border-gray-200 m-auto">
			<h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-purple-600">
					<path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
				</svg>
				Dashboard Mapping
			</h3>
			<p class="text-xs text-gray-500 mb-4">Link a Looker Studio UUID to a readable name.</p>
			
			<form hx-post="/costing/datastudio/mapping" hx-on::after-request="location.reload()" class="flex flex-col gap-4">
				<div>
					<label class="block text-xs font-bold text-gray-600 mb-1">Asset ID (UUID)</label>
					<input type="text" name="asset_id" required class="w-full text-sm p-2 rounded-md border-gray-300 focus:border-green-x-light focus:ring-green-x-light bg-gray-50" placeholder="e.g. d179f56a-8312-48b7..."/>
				</div>
				<div>
					<label class="block text-xs font-bold text-gray-600 mb-1">Human Readable Name</label>
					<input type="text" name="asset_name" required class="w-full text-sm p-2 rounded-md border-gray-300 focus:border-green-x-light focus:ring-green-x-light bg-gray-50" placeholder="e.g. Shake The Tree"/>
				</div>
				<div class="flex justify-end gap-2 mt-4 pt-4 border-t border-gray-100">
					<button type="button" onclick="document.getElementById('ds-mapping-modal').close()" class="px-4 py-2 text-xs font-bold text-gray-500 hover:bg-gray-100 rounded-md transition-colors">Cancel</button>
					<button type="submit" class="px-4 py-2 text-xs font-bold text-white bg-green-x-dark hover:bg-green-x-light rounded-md shadow-sm transition-colors">Save Mapping</button>
				</div>
			</form>
		</dialog>

		<div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex flex-col gap-4 shrink-0 relative z-40">
			<div class="flex flex-wrap items-center gap-2 border-b border-gray-100 pb-2">
				<span class="text-xs font-bold text-gray-400 uppercase tracking-widest mr-2">Quick Select:</span>
				<button type="button" onclick="setDSDateRange('today')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Today</button>
				<button type="button" onclick="setDSDateRange('last_30')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Last 30 Days</button>
				<button type="button" onclick="setDSDateRange('last_90')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Last 90 Days</button>
				
				<button type="button" onclick="document.getElementById('ds-mapping-modal').showModal()" class="ml-auto px-4 py-1 text-xs font-bold text-white bg-purple-500 hover:bg-purple-600 rounded-full shadow-sm transition-colors flex items-center gap-1.5">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
					</svg>
					Dashboard Mapping
				</button>
			</div>

			<form 
				id="ds-costing-form"
				hx-get="/costing/datastudio/metrics" 
				hx-target="#ds-metrics-container"
				hx-trigger="submit, load"
				hx-indicator=".htmx-indicator"
				class="flex flex-wrap gap-4 items-center w-full"
			>
				<div class="flex items-center gap-2 pr-4 border-r border-gray-200">
					<input type="date" id="ds_start_date" name="start_date" value={ data.StartDate } class="text-sm rounded-md border-gray-300 focus:ring-green-x-light focus:border-green-x-light py-1.5" />
					<span class="text-xs font-semibold text-gray-400">TO</span>
					<input type="date" id="ds_end_date" name="end_date" value={ data.EndDate } class="text-sm rounded-md border-gray-300 focus:ring-green-x-light focus:border-green-x-light py-1.5" />
				</div>

				<select name="project" class="text-sm rounded-md border-gray-300 focus:ring-green-x-light focus:border-green-x-light py-1.5 max-w-[200px]">
					<option value="" selected>All Projects</option>
					<option value="df-fs-insights">df-fs-insights</option>
					<option value="df-ps-south-africa">df-ps-south-africa</option>
					<option value="df-ps-staging">df-ps-staging</option>
					<option value="df-fs-rt-insights">df-fs-rt-insights</option>
				</select>

				<select name="asset_id" class="text-sm rounded-md border-gray-300 focus:ring-green-x-light focus:border-green-x-light py-1.5 max-w-[250px] ml-4 border-l border-gray-200 pl-4">
					<option value="" selected>All Dashboards</option>
					for _, asset := range data.Labels {
						// FIX: Using the LabelMap dictionary to check for a readable Name
						if mappedName, exists := data.LabelMap[asset]; exists && mappedName != "" {
							<option value={ asset }>{ mappedName }</option>
						} else {
							<option value={ asset }>{ asset }</option>
						}
					}
				</select>
				
				<button type="submit" class="ml-auto bg-green-x-dark text-white px-5 py-2 rounded-md text-xs font-bold uppercase tracking-wider hover:bg-green-x-light transition-all shadow-sm">
					Apply Filters
				</button>
			</form>
		</div>

		<div id="ds-metrics-container" class="flex flex-col gap-6 h-full relative z-30"></div>

		<script>
			function setDSDateRange(type) {
				const startInput = document.getElementById('ds_start_date');
				const endInput = document.getElementById('ds_end_date');
				const today = new Date();
				let start = new Date(today);
				let end = new Date(today);

				switch(type) {
					case 'today': break;
					case 'last_30': start.setDate(today.getDate() - 30); break;
					case 'last_90': start.setDate(today.getDate() - 90); break;
				}

				const fmt = d => {
					const offset = d.getTimezoneOffset();
					return new Date(d.getTime() - (offset*60*1000)).toISOString().split('T')[0];
				};

				if (start && end) {
					startInput.value = fmt(start);
					endInput.value = fmt(end);
					document.getElementById('ds-costing-form').dispatchEvent(new Event('submit', { cancelable: true }));
				}
			}
		</script>
	</div>
}

templ datastudioMetrics(tableData DSTableData, chartDataJSON string, start string, end string, projectFilter string) {
	<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden shrink-0 relative z-30">
		<div class="px-4 py-3 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
			<h2 class="text-sm font-bold text-gray-800 uppercase tracking-wide">Looker Studio Executions <span class="text-gray-400 font-normal lowercase ml-2">(Information Schema)</span></h2>
		</div>
		<div class="overflow-x-visible w-full">
			<table class="min-w-full divide-y divide-gray-200">
				<thead class="bg-gray-50">
					<tr>
						<th scope="col" class="px-6 py-2 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">DataStudio Asset</th>
						<th scope="col" class="px-6 py-2 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Total Runs</th>
						<th scope="col" class="px-6 py-2 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Size</th>
						<th scope="col" class="px-6 py-2 text-right text-xs font-bold text-gray-800 uppercase tracking-wider">Total Cost</th>
					</tr>
				</thead>
				<tbody class="bg-white divide-y divide-gray-200">
					for _, a := range tableData.Assets {
						<tr 
							class="hover:bg-purple-50 transition-colors cursor-pointer group"
							hx-get={ "/costing/datastudio/details?asset_id=" + a.URLSafeID + "&start_date=" + start + "&end_date=" + end + "&project=" + projectFilter } 
							hx-target={ "#ds-details-box-" + a.SafeID }
							hx-swap="innerHTML"
							hx-trigger="click once"
							data-row-target={ "ds-row-" + a.SafeID }
							onclick="toggleRow(this.getAttribute('data-row-target'))"
						>
							<td class="px-6 py-2 whitespace-nowrap text-sm font-bold text-purple-600 group-hover:text-purple-800 flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3 text-gray-400 transition-transform group-data-[open=true]:rotate-90">
									<path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
								</svg>
								<div class="flex flex-col">
									<span>{ a.AssetName }</span>
									if a.AssetName != a.AssetID {
										<span class="text-[10px] text-gray-400 font-medium font-mono leading-tight">{ a.AssetID }</span>
									}
								</div>
							</td>
							<td class="px-6 py-2 whitespace-nowrap text-right text-sm text-gray-500 font-medium">{ fmt.Sprintf("%d", a.TotalRuns) }</td>
							<td class="px-6 py-2 whitespace-nowrap text-right text-sm text-gray-500">{ a.TotalSize }</td>
							<td class="px-6 py-2 whitespace-nowrap text-right text-sm font-black text-gray-900 bg-gray-50/30">{ a.TotalCost }</td>
						</tr>
						
						<tr id={ "ds-row-" + a.SafeID } class="hidden bg-gray-50/40">
							<td colspan="4" class="px-6 py-3 border-b border-gray-200">
								<div id={ "ds-details-box-" + a.SafeID } class="w-full">
									<div class="flex items-center justify-center py-4 gap-2 text-xs text-gray-400 font-medium animate-pulse">
										Fetching queries and credentials...
									</div>
								</div>
							</td>
						</tr>
					}
					if len(tableData.Assets) == 0 {
						<tr><td colspan="4" class="px-6 py-6 text-center text-sm text-gray-500">No DataStudio activity found.</td></tr>
					}
				</tbody>
				<tfoot class="bg-gray-800 text-white">
					<tr>
						<th scope="col" class="px-6 py-2 text-left text-sm font-black uppercase tracking-wider">Grand Total</th>
						<th scope="col" class="px-6 py-2 text-right text-sm font-bold tracking-wider">{ fmt.Sprintf("%d", tableData.GrandRuns) }</th>
						<th scope="col" class="px-6 py-2 text-right text-sm font-bold tracking-wider">{ tableData.GrandSize }</th>
						<th scope="col" class="px-6 py-2 text-right text-sm font-black uppercase tracking-wider">{ tableData.GrandTotal }</th>
					</tr>
				</tfoot>
			</table>
		</div>
	</div>

	<div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex-1 flex flex-col min-h-[280px] relative z-20">
		<div class="flex justify-between items-center mb-3">
			<h3 class="text-sm font-bold text-gray-800 uppercase tracking-wide">DataStudio Cost Trend</h3>
		</div>
		<div class="relative w-full flex-1 min-h-0"><canvas id="dsCostChart"></canvas></div>
		@templ.JSONScript("ds-chart-data", chartDataJSON)
		<script>
			function toggleRow(id) {
				const el = document.getElementById(id);
				if (el) {
					if (el.classList.contains("hidden")) {
						el.classList.remove("hidden");
						el.previousElementSibling.setAttribute("data-open", "true");
					} else {
						el.classList.add("hidden");
						el.previousElementSibling.removeAttribute("data-open");
					}
				}
			}

			(function initDSChart() {
				if (window.dsCostChartInstance) { window.dsCostChartInstance.destroy(); }
				const canvas = document.getElementById('dsCostChart');
				if (!canvas) return;

				let rawDataStr = document.getElementById('ds-chart-data').textContent;
				let rawData = JSON.parse(rawDataStr);
				if (typeof rawData === 'string') { rawData = JSON.parse(rawData); }

				const datesSet = new Set();
				const datasetsMap = {}; 
				const totalsByDate = {}; 
				const colorPalette = ['#7C3AED', '#8B5CF6', '#A78BFA', '#C4B5FD', '#10B981', '#34D399'];
				let colorIdx = 0;

				rawData.forEach(d => {
					datesSet.add(d.date);
					let labelName = d.service; 
					if (!datasetsMap[labelName]) {
						datasetsMap[labelName] = {
							type: 'bar', label: labelName, data: {},
							backgroundColor: colorPalette[colorIdx % colorPalette.length],
							borderWidth: 0, order: 2 
						};
						colorIdx++;
					}
					datasetsMap[labelName].data[d.date] = (datasetsMap[labelName].data[d.date] || 0) + d.cost;
					totalsByDate[d.date] = (totalsByDate[d.date] || 0) + d.cost;
				});

				const sortedDates = Array.from(datesSet).sort();
				const finalDatasets = Object.values(datasetsMap).map(ds => {
					return { ...ds, data: sortedDates.map(date => ds.data[date] || 0) };
				});

				finalDatasets.push({
					type: 'line', label: 'Total Cost Trend',
					data: sortedDates.map(date => totalsByDate[date] || 0),
					borderColor: '#1F2937', borderWidth: 2, borderDash: [5, 5], fill: false, pointRadius: 2, order: 1 
				});

				const ctx = canvas.getContext('2d');
				window.dsCostChartInstance = new Chart(ctx, {
					type: 'bar',
					data: { labels: sortedDates, datasets: finalDatasets },
					options: {
						responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
						plugins: { legend: { position: 'right', labels: { usePointStyle: true, boxWidth: 8, font: {size: 10} } } },
						scales: { x: { stacked: true, grid: { display: false } }, y: { stacked: true, beginAtZero: true, grid: { color: '#f3f4f6', drawBorder: false }, ticks: { callback: function(value) { return '$' + value; } } } }
					}
				});
			})();
		</script>
	</div>
}

templ datastudioDetailsRow(data DSDetailsData) {
	<div class="overflow-x-auto w-full rounded-lg border border-gray-200 shadow-sm bg-white p-2 my-1 animate-fade-in">
		<table class="min-w-full divide-y divide-gray-100">
			<thead class="bg-gray-50/80">
				<tr>
					<th scope="col" class="px-4 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider w-1/3">Data Source Used</th>
					<th scope="col" class="px-4 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Query Type</th>
					<th scope="col" class="px-4 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Credentials Loaded</th>
					<th scope="col" class="px-4 py-2 text-right text-[10px] font-bold text-gray-500 uppercase tracking-wider">Runs</th>
					<th scope="col" class="px-4 py-2 text-right text-[10px] font-bold text-gray-500 uppercase tracking-wider">Avg Runtime</th>
					<th scope="col" class="px-4 py-2 text-right text-[10px] font-bold text-gray-500 uppercase tracking-wider border-r border-gray-100 pr-3">Size</th>
					<th scope="col" class="px-4 py-2 text-right text-[10px] font-bold text-gray-700 uppercase tracking-wider bg-gray-100/50">Total Cost</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-gray-200">
				for _, item := range data.Details {
					<tr class="hover:bg-gray-50/50 transition-colors">
						<td class="px-4 py-2 text-xs text-gray-800 font-bold truncate max-w-[250px]" title={ item.ResourceName }>{ item.ResourceName }</td>
						<td class="px-4 py-2 whitespace-nowrap text-[11px] font-bold text-purple-600 bg-purple-50/50 rounded-md inline-block mt-1.5">{ item.QueryType }</td>
						<td class="px-4 py-2 whitespace-nowrap text-xs text-gray-500 font-medium">{ item.Credentials }</td>
						<td class="px-4 py-2 whitespace-nowrap text-xs text-gray-700 font-semibold text-right">{ fmt.Sprintf("%d", item.TotalRuns) }</td>
						<td class="px-4 py-2 whitespace-nowrap text-xs text-gray-700 font-semibold text-right">{ item.AvgRunTime }</td>
						<td class="px-4 py-2 whitespace-nowrap text-xs text-gray-500 font-medium text-right border-r border-gray-100 pr-3">{ item.TotalSize }</td>
						<td class="px-4 py-2 whitespace-nowrap text-xs font-black text-gray-900 text-right bg-gray-50/40">{ item.TotalCost }</td>
					</tr>
				}
				if len(data.Details) == 0 {
					<tr><td colspan="7" class="px-4 py-6 text-center text-xs text-gray-400 italic">No detailed queries found for this timeframe.</td></tr>
				}
			</tbody>
		</table>
	</div>
}