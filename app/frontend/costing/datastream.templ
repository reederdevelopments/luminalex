package costing

import "strings"

templ datastreamTab(data CostingDashboardData) {
	<div class="flex flex-col gap-6 animate-fade-in h-full">
		
		<div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex flex-col gap-4 shrink-0 relative z-40">
			<div class="flex flex-wrap items-center gap-2 border-b border-gray-100 pb-3">
				<span class="text-xs font-bold text-gray-400 uppercase tracking-widest mr-2">Quick Select:</span>
				<button type="button" onclick="setDateRange('current_month')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Current Month</button>
				<button type="button" onclick="setDateRange('last_month')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Last Month</button>
				<button type="button" onclick="setDateRange('last_30')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Last 30 Days</button>
				<button type="button" onclick="setDateRange('last_90')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Last 90 Days</button>
				<button type="button" onclick="setDateRange('ytd')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Year to Date</button>
			</div>

			<form 
				id="costing-form"
				hx-get="/costing/datastream/metrics" 
				hx-target="#ds-metrics"
				hx-trigger="submit, load"
				hx-indicator=".htmx-indicator"
				class="flex flex-wrap gap-4 items-center w-full"
			>
				<div class="flex items-center gap-2 border-r border-gray-200 pr-4">
					<input type="date" id="start_date" name="start_date" value={ data.StartDate } class="text-sm rounded-md border-gray-300 focus:ring-green-x-light focus:border-green-x-light" />
					<span class="text-xs font-semibold text-gray-400">TO</span>
					<input type="date" id="end_date" name="end_date" value={ data.EndDate } class="text-sm rounded-md border-gray-300 focus:ring-green-x-light focus:border-green-x-light" />
				</div>

				<select name="project" class="text-sm rounded-md border-gray-300 focus:ring-green-x-light focus:border-green-x-light">
					<option value="" selected>All Projects</option>
					<option value="df-ps-south-africa">df-ps-south-africa</option>
					<option value="df-ps-zambia">df-ps-zambia</option>
					<option value="df-ps-kenya">df-ps-kenya</option>
					<option value="df-ps-uganda">df-ps-uganda</option>
					<option value="df-ps-tanzania">df-ps-tanzania</option>
				</select>

				<select name="grouping" class="text-sm rounded-md border-gray-300 focus:ring-green-x-light focus:border-green-x-light">
					<option value="daily" selected>Daily Graph View</option>
					<option value="monthly">Monthly Graph View</option>
					<option value="yearly">Yearly Graph View</option>
				</select>
				
				<button type="submit" class="ml-auto bg-green-x-dark text-white px-5 py-2.5 rounded-md text-xs font-bold uppercase tracking-wider hover:bg-green-x-light transition-all shadow-sm">
					Apply Filters
				</button>
			</form>
		</div>

		<div id="ds-metrics" class="flex flex-col gap-6 h-full relative z-30">
			</div>

		<script>
			function setDateRange(type) {
				const startInput = document.getElementById('start_date');
				const endInput = document.getElementById('end_date');
				const today = new Date();
				let start, end;

				switch(type) {
					case 'current_month':
						start = new Date(today.getFullYear(), today.getMonth(), 1);
						end = today;
						break;
					case 'last_month':
						start = new Date(today.getFullYear(), today.getMonth() - 1, 1);
						end = new Date(today.getFullYear(), today.getMonth(), 0);
						break;
					case 'last_30':
						start = new Date();
						start.setDate(today.getDate() - 30);
						end = today;
						break;
					case 'last_90':
						start = new Date();
						start.setDate(today.getDate() - 90);
						end = today;
						break;
					case 'ytd':
						start = new Date(today.getFullYear(), 0, 1);
						end = today;
						break;
				}

				const fmt = d => {
					const offset = d.getTimezoneOffset();
					const adjustedDate = new Date(d.getTime() - (offset*60*1000));
					return adjustedDate.toISOString().split('T')[0];
				};

				if (start && end) {
					startInput.value = fmt(start);
					endInput.value = fmt(end);
					document.getElementById('costing-form').dispatchEvent(new Event('submit', { cancelable: true }));
				}
			}
		</script>
	</div>
}

templ datastreamMetrics(tableData []ProjectCost, totals ProjectCost, chartDataJSON string, start string, end string) {
	<div class="bg-white rounded-xl border border-gray-200 shadow-sm shrink-0 relative z-30">
		<div class="overflow-x-visible w-full">
			<table class="min-w-full divide-y divide-gray-200">
				<thead class="bg-gray-50">
					<tr>
						<th scope="col" class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Project</th>
						<th scope="col" class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Total Net Cost</th>
						<th scope="col" class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Datastream Cost</th>
						<th scope="col" class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Datastream Size</th>
						<th scope="col" class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">GCS Cost</th>
						<th scope="col" class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">GCS Size</th>
						<th scope="col" class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Functions Cost</th>
						<th scope="col" class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Functions Size</th>
					</tr>
				</thead>
				<tbody class="bg-white divide-y divide-gray-200">
					for _, row := range tableData {
						<tr 
							class="hover:bg-green-50 transition-colors cursor-pointer group"
							hx-get={ "/costing/datastream/details?project=" + row.Project + "&start_date=" + start + "&end_date=" + end } 
							hx-target={ "#details-" + row.Project }
							hx-swap="innerHTML"
							data-row-target={ "details-" + row.Project }
							onclick="toggleRow(this.getAttribute('data-row-target'))"
						>
							<td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-green-x-dark group-hover:text-green-x-light flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3 text-gray-400">
									<path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
								</svg>
								{ row.Project }
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-right">
								<div class="text-sm font-black text-gray-900">{ row.Total }</div>
								<div class={ "text-[10px] font-bold mt-0.5", templ.KV("text-red-500", strings.Contains(row.TotalDelta, "▲")), templ.KV("text-green-500", strings.Contains(row.TotalDelta, "▼")), templ.KV("text-gray-400", row.TotalDelta == "0%" || row.TotalDelta == "-") }>{ row.TotalDelta }</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-right">
								<div class="text-sm text-gray-500">{ row.Datastream }</div>
								<div class={ "text-[10px] font-bold mt-0.5", templ.KV("text-red-500", strings.Contains(row.DatastreamDelta, "▲")), templ.KV("text-green-500", strings.Contains(row.DatastreamDelta, "▼")), templ.KV("text-gray-400", row.DatastreamDelta == "0%" || row.DatastreamDelta == "-") }>{ row.DatastreamDelta }</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400 text-right align-top">{ row.DS_Size }</td>
							<td class="px-6 py-4 whitespace-nowrap text-right">
								<div class="text-sm text-gray-500">{ row.GCS }</div>
								<div class={ "text-[10px] font-bold mt-0.5", templ.KV("text-red-500", strings.Contains(row.GCSDelta, "▲")), templ.KV("text-green-500", strings.Contains(row.GCSDelta, "▼")), templ.KV("text-gray-400", row.GCSDelta == "0%" || row.GCSDelta == "-") }>{ row.GCSDelta }</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400 text-right align-top">{ row.GCS_Size }</td>
							<td class="px-6 py-4 whitespace-nowrap text-right">
								<div class="text-sm text-gray-500">{ row.Functions }</div>
								<div class={ "text-[10px] font-bold mt-0.5", templ.KV("text-red-500", strings.Contains(row.FunctionsDelta, "▲")), templ.KV("text-green-500", strings.Contains(row.FunctionsDelta, "▼")), templ.KV("text-gray-400", row.FunctionsDelta == "0%" || row.FunctionsDelta == "-") }>{ row.FunctionsDelta }</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400 text-right align-top">{ row.Func_Size }</td>
						</tr>
						<tr id={ "row-details-" + row.Project } class="hidden bg-gray-50/20">
							<td colspan="8" class="p-0 border-b border-gray-200 relative">
								<div id={ "details-" + row.Project } class="p-6 overflow-visible">
									<div class="animate-pulse flex space-x-4">
										<div class="h-4 bg-gray-200 rounded w-1/4"></div>
									</div>
								</div>
							</td>
						</tr>
					}
					if len(tableData) == 0 {
						<tr>
							<td colspan="8" class="px-6 py-8 text-center text-sm text-gray-500">No data found for this date range.</td>
						</tr>
					}
				</tbody>
				<tfoot class="bg-green-x-dark text-white">
					<tr>
						<th scope="col" class="px-6 py-3 text-left text-sm font-black uppercase tracking-wider">Total</th>
						<th scope="col" class="px-6 py-3 text-right">
							<div class="text-sm font-black uppercase tracking-wider">{ totals.Total }</div>
							<div class={ "text-[10px] font-bold mt-0.5", templ.KV("text-red-300", strings.Contains(totals.TotalDelta, "▲")), templ.KV("text-green-300", strings.Contains(totals.TotalDelta, "▼")) }>{ totals.TotalDelta }</div>
						</th>
						<th scope="col" class="px-6 py-3 text-right">
							<div class="text-xs font-bold tracking-wider">{ totals.Datastream }</div>
							<div class={ "text-[10px] font-bold mt-0.5", templ.KV("text-red-300", strings.Contains(totals.DatastreamDelta, "▲")), templ.KV("text-green-300", strings.Contains(totals.DatastreamDelta, "▼")) }>{ totals.DatastreamDelta }</div>
						</th>
						<th scope="col" class="px-6 py-3 text-right text-xs font-medium tracking-wider text-green-100 align-top">{ totals.DS_Size }</th>
						<th scope="col" class="px-6 py-3 text-right">
							<div class="text-xs font-bold tracking-wider">{ totals.GCS }</div>
							<div class={ "text-[10px] font-bold mt-0.5", templ.KV("text-red-300", strings.Contains(totals.GCSDelta, "▲")), templ.KV("text-green-300", strings.Contains(totals.GCSDelta, "▼")) }>{ totals.GCSDelta }</div>
						</th>
						<th scope="col" class="px-6 py-3 text-right text-xs font-medium tracking-wider text-green-100 align-top">{ totals.GCS_Size }</th>
						<th scope="col" class="px-6 py-3 text-right">
							<div class="text-xs font-bold tracking-wider">{ totals.Functions }</div>
							<div class={ "text-[10px] font-bold mt-0.5", templ.KV("text-red-300", strings.Contains(totals.FunctionsDelta, "▲")), templ.KV("text-green-300", strings.Contains(totals.FunctionsDelta, "▼")) }>{ totals.FunctionsDelta }</div>
						</th>
						<th scope="col" class="px-6 py-3 text-right text-xs font-medium tracking-wider text-green-100 align-top">{ totals.Func_Size }</th>
					</tr>
				</tfoot>
			</table>
		</div>
	</div>

	<div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm flex-1 flex flex-col min-h-[280px] relative z-20">
		<div class="flex justify-between items-center mb-4">
			<h3 class="text-sm font-bold text-gray-800 uppercase tracking-wide">Total Net Cost Trend</h3>
		</div>

		<div class="relative w-full flex-1 min-h-0">
			<canvas id="costChart"></canvas>
		</div>

		@templ.JSONScript("chart-data-payload", chartDataJSON)

		<script>
			function toggleRow(id) {
				const el = document.getElementById("row-" + id);
				if (el.classList.contains("hidden")) {
					el.classList.remove("hidden");
				} else {
					el.classList.add("hidden");
				}
			}

			(function initChart() {
				if (window.costChartInstance) { 
					window.costChartInstance.destroy(); 
				}
				
				const canvas = document.getElementById('costChart');
				if (!canvas) return;

				let rawDataStr = document.getElementById('chart-data-payload').textContent;
				let rawData = JSON.parse(rawDataStr);
				if (typeof rawData === 'string') {
					rawData = JSON.parse(rawData);
				}

				const datesSet = new Set();
				const datasetsMap = {}; 
				const totalsByDate = {}; 

				const colorPalette = {
					'Datastream': { border: '#1e4b41', bg: '#286256' }, 
					'Cloud Storage': { border: '#38917e', bg: '#4AB8A1' }, 
					'Functions': { border: '#84191b', bg: '#A52022' },
					'Other': { border: '#6b7280', bg: '#9ca3af' }
				};

				rawData.forEach(d => {
					datesSet.add(d.date);
					let labelName = d.service;

					if (!datasetsMap[labelName]) {
						datasetsMap[labelName] = {
							type: 'bar',
							label: labelName,
							data: {},
							backgroundColor: colorPalette[labelName] ? colorPalette[labelName].bg : '#9ca3af',
							borderWidth: 0,
							order: 2 
						};
					}
					datasetsMap[labelName].data[d.date] = (datasetsMap[labelName].data[d.date] || 0) + d.cost;
					totalsByDate[d.date] = (totalsByDate[d.date] || 0) + d.cost;
				});

				const sortedDates = Array.from(datesSet).sort();
				
				const finalDatasets = Object.values(datasetsMap).map(ds => {
					const dataArr = sortedDates.map(date => ds.data[date] || 0);
					return { ...ds, data: dataArr };
				});

				finalDatasets.push({
					type: 'line',
					label: 'Total Cost Trend',
					data: sortedDates.map(date => totalsByDate[date] || 0),
					borderColor: '#374151', 
					borderWidth: 2,
					borderDash: [5, 5],
					fill: false,
					pointRadius: 2,
					pointBackgroundColor: '#374151',
					order: 1 
				});

				const ctx = canvas.getContext('2d');
				window.costChartInstance = new Chart(ctx, {
					type: 'bar',
					data: {
						labels: sortedDates,
						datasets: finalDatasets
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						interaction: {
							mode: 'index',
							intersect: false,
						},
						plugins: { 
							legend: { 
								position: 'top',
								labels: { usePointStyle: true, boxWidth: 8 }
							},
							tooltip: {
								callbacks: {
									label: function(context) {
										let label = context.dataset.label || '';
										if (label) { label += ': '; }
										if (context.parsed.y !== null) {
											label += new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(context.parsed.y);
										}
										return label;
									},
									footer: function(tooltipItems) {
										let sum = 0;
										let dataIndex = tooltipItems[0].dataIndex;
										
										tooltipItems.forEach(function(tooltipItem) {
											if (tooltipItem.dataset.type !== 'line') {
												sum += tooltipItem.parsed.y;
											}
										});

										let prevSum = 0;
										if (dataIndex > 0) {
											let prevDate = sortedDates[dataIndex - 1];
											prevSum = totalsByDate[prevDate] || 0;
										}

										let footerStr = 'Total: ' + new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(sum);
										
										if (dataIndex > 0 && prevSum > 0) {
											let delta = ((sum - prevSum) / prevSum) * 100;
											let sign = delta > 0 ? '▲' : (delta < 0 ? '▼' : '');
											footerStr += '\nPrev. Delta: ' + sign + ' ' + Math.abs(delta).toFixed(1) + '%';
										} else if (dataIndex > 0 && prevSum === 0 && sum > 0) {
											footerStr += '\nPrev. Delta: ▲ 100.0%';
										}
										
										return footerStr;
									}
								}
							}
						},
						scales: {
							x: { 
								stacked: true, 
								grid: { display: false }
							},
							y: {
								stacked: true,
								beginAtZero: true,
								grid: { color: '#f3f4f6', drawBorder: false },
								ticks: { 
									callback: function(value) { return '$' + value; } 
								}
							}
						}
					}
				});
			})();
		</script>
	</div>
}

templ projectDetailsRow(data ProjectDetailsData) {
	<div class="animate-fade-in pl-8 border-l-4 border-green-x-light overflow-visible my-4">
		<div class="overflow-x-auto">
			<table class="min-w-full divide-y divide-gray-200 bg-white border border-gray-200 rounded-lg shadow-sm">
				<thead class="bg-gray-100">
					<tr>
						<th scope="col" class="px-4 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Service</th>
						<th scope="col" class="px-4 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Job / Resource Details</th>
						for _, month := range data.MonthHeaders {
							<th scope="col" class="px-4 py-3 text-right text-[10px] font-bold text-gray-500 uppercase tracking-wider">{ month }</th>
						}
						<th scope="col" class="px-4 py-3 text-right text-[10px] font-bold text-gray-800 uppercase tracking-wider bg-gray-200/50">Range Total</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-200">
					for _, item := range data.Details {
						<tr class="hover:bg-gray-50 transition-colors">
							<td class="px-4 py-3 whitespace-nowrap text-xs font-semibold text-gray-600">{ item.Service }</td>
							<td class="px-4 py-3 text-xs text-gray-800 flex items-center gap-2">
								{ item.SKU }
								<div class="cursor-help text-green-x-light hover:text-green-x-dark transition-colors" title={ item.Description }>
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
										<path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
									</svg>
								</div>
							</td>
							
							for _, mData := range item.Months {
								<td class="px-4 py-3 whitespace-nowrap text-right">
									<div class="text-xs font-bold text-gray-900">{ mData.Cost }</div>
									<div class={ "text-[9px] font-bold mt-0.5", templ.KV("text-red-500", strings.Contains(mData.Delta, "▲")), templ.KV("text-green-500", strings.Contains(mData.Delta, "▼")), templ.KV("text-gray-400", mData.Delta == "0%" || mData.Delta == "-") }>{ mData.Delta }</div>
								</td>
							}
							
							<td class="px-4 py-3 whitespace-nowrap text-xs font-black text-gray-900 text-right bg-gray-50/50">{ item.TotalCost }</td>
						</tr>
					}
					if len(data.Details) == 0 {
						<tr>
							<td colspan="10" class="px-4 py-4 text-center text-xs text-gray-500 italic">No detailed SKUs found.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}