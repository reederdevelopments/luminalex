package costing

import "strings"

templ thirdpartyTab(data CostingDashboardData) {
	<div class="flex flex-col gap-4 animate-fade-in h-full">
		
		<script>
			if (window.parent && window.parent.document) {
				const menuBtn = window.parent.document.querySelector('#ujuzi-menu-btn div');
				if (menuBtn) {
					menuBtn.innerText = 'MENU - COSTING 3RD PARTY';
				}
			}
		</script>

		<div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex flex-col gap-4 shrink-0 relative z-40">
			<div class="flex flex-wrap items-center gap-2 border-b border-gray-100 pb-2">
				<span class="text-xs font-bold text-gray-400 uppercase tracking-widest mr-2">Quick Select:</span>
				<button type="button" onclick="setTPDateRange('today')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Today</button>
				<button type="button" onclick="setTPDateRange('yesterday')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Yesterday</button>
				<button type="button" onclick="setTPDateRange('current_week')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Current Week</button>
				<button type="button" onclick="setTPDateRange('last_week')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Last Week</button>
				<button type="button" onclick="setTPDateRange('current_month')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Current Month</button>
				<button type="button" onclick="setTPDateRange('last_month')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Last Month</button>
				<button type="button" onclick="setTPDateRange('last_30')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Last 30 Days</button>
				<button type="button" onclick="setTPDateRange('last_90')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Last 90 Days</button>
				<button type="button" onclick="setTPDateRange('ytd')" class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">Year to Date</button>
			</div>

			<form 
				id="tp-costing-form"
				hx-get="/costing/thirdparty/metrics" 
				hx-target="#tp-metrics"
				hx-trigger="submit, load"
				hx-indicator=".htmx-indicator"
				class="flex flex-wrap gap-4 items-center w-full"
			>
				<div class="flex items-center gap-2 pr-4">
					<input type="date" id="tp_start_date" name="start_date" value={ data.StartDate } class="text-sm rounded-md border-gray-300 focus:ring-green-x-light focus:border-green-x-light py-1.5" />
					<span class="text-xs font-semibold text-gray-400">TO</span>
					<input type="date" id="tp_end_date" name="end_date" value={ data.EndDate } class="text-sm rounded-md border-gray-300 focus:ring-green-x-light focus:border-green-x-light py-1.5" />
				</div>

				<select name="grouping" class="text-sm rounded-md border-gray-300 focus:ring-green-x-light focus:border-green-x-light py-1.5 ml-4 border-l border-gray-200 pl-4">
					<option value="daily" selected>Daily Graph View</option>
					<option value="monthly">Monthly Graph View</option>
					<option value="yearly">Yearly Graph View</option>
				</select>
				
				<button type="submit" class="ml-auto bg-green-x-dark text-white px-5 py-2 rounded-md text-xs font-bold uppercase tracking-wider hover:bg-green-x-light transition-all shadow-sm">
					Apply Filters
				</button>
			</form>
		</div>

		<div id="tp-metrics" class="flex flex-col gap-6 h-full relative z-30">
			</div>

		<script>
			function setTPDateRange(type) {
				const startInput = document.getElementById('tp_start_date');
				const endInput = document.getElementById('tp_end_date');
				const today = new Date();
				let start = new Date(today);
				let end = new Date(today);

				switch(type) {
					case 'today':
						break;
					case 'yesterday':
						start.setDate(today.getDate() - 1);
						end.setDate(today.getDate() - 1);
						break;
					case 'current_week':
						const day1 = start.getDay();
						const diff1 = start.getDate() - day1 + (day1 === 0 ? -6 : 1);
						start.setDate(diff1);
						break;
					case 'last_week':
						const day2 = start.getDay();
						const diff2 = start.getDate() - day2 + (day2 === 0 ? -6 : 1) - 7;
						start.setDate(diff2);
						end = new Date(start);
						end.setDate(start.getDate() + 6);
						break;
					case 'current_month':
						start = new Date(today.getFullYear(), today.getMonth(), 1); 
						break;
					case 'last_month':
						start = new Date(today.getFullYear(), today.getMonth() - 1, 1); 
						end = new Date(today.getFullYear(), today.getMonth(), 0); 
						break;
					case 'last_30':
						start.setDate(today.getDate() - 30); 
						break;
					case 'last_90':
						start.setDate(today.getDate() - 90); 
						break;
					case 'ytd':
						start = new Date(today.getFullYear(), 0, 1); 
						break;
				}

				const fmt = d => {
					const offset = d.getTimezoneOffset();
					const adjustedDate = new Date(d.getTime() - (offset*60*1000));
					return adjustedDate.toISOString().split('T')[0];
				};

				if (start && end) {
					startInput.value = fmt(start);
					endInput.value = fmt(end);
					document.getElementById('tp-costing-form').dispatchEvent(new Event('submit', { cancelable: true }));
				}
			}
		</script>
	</div>
}

templ thirdpartyMetrics(tableData TPTableData, chartDataJSON string) {
	<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden shrink-0 relative z-30">
		<div class="px-4 py-3 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
			<h2 class="text-sm font-bold text-gray-800 uppercase tracking-wide">Cloud Run Jobs Breakdown <span class="text-gray-400 font-normal lowercase ml-2">(df-ps-staging)</span></h2>
		</div>
		<div class="overflow-x-auto w-full">
			<table class="min-w-full divide-y divide-gray-200">
				<thead class="bg-gray-50">
					<tr>
						<th scope="col" class="px-4 py-2 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Service / Job Name</th>
						for _, month := range tableData.MonthHeaders {
							<th scope="col" class="px-4 py-2 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">{ month }</th>
						}
						<th scope="col" class="px-4 py-2 text-right text-xs font-bold text-gray-800 uppercase tracking-wider bg-gray-200/50">Total</th>
					</tr>
				</thead>
				<tbody class="bg-white divide-y divide-gray-200">
					for _, job := range tableData.Jobs {
						<tr class="hover:bg-gray-50 transition-colors">
							<td class="px-4 py-1.5 whitespace-nowrap text-sm font-bold text-gray-800 flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-purple-500">
									<path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
								</svg>
								{ job.JobName }
							</td>
							for _, mData := range job.Months {
								<td class="px-4 py-1.5 whitespace-nowrap text-right">
									<div class="text-sm font-semibold text-gray-700 leading-tight">{ mData.Cost }</div>
									<div class={ "text-[10px] font-bold leading-tight", templ.KV("text-red-500", strings.Contains(mData.Delta, "▲")), templ.KV("text-green-500", strings.Contains(mData.Delta, "▼")), templ.KV("text-gray-400", mData.Delta == "0%" || mData.Delta == "-") }>{ mData.Delta }</div>
								</td>
							}
							<td class="px-4 py-1.5 whitespace-nowrap text-sm font-black text-gray-900 text-right bg-gray-50/50">{ job.TotalCost }</td>
						</tr>
					}
					if len(tableData.Jobs) == 0 {
						<tr>
							<td colspan="10" class="px-4 py-6 text-center text-sm text-gray-500">No data found for this date range.</td>
						</tr>
					}
				</tbody>
				<tfoot class="bg-green-x-dark text-white">
					<tr>
						<th scope="col" class="px-4 py-2 text-left text-sm font-black uppercase tracking-wider">Grand Total</th>
						for _, mTotal := range tableData.MonthTotals {
							<th scope="col" class="px-4 py-2 text-right text-sm font-bold tracking-wider">{ mTotal }</th>
						}
						<th scope="col" class="px-4 py-2 text-right text-sm font-black uppercase tracking-wider">{ tableData.GrandTotal }</th>
					</tr>
				</tfoot>
			</table>
		</div>
	</div>

	<div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex-1 flex flex-col min-h-[280px] relative z-20">
		<div class="flex justify-between items-center mb-3">
			<h3 class="text-sm font-bold text-gray-800 uppercase tracking-wide">Jobs Net Cost Trend</h3>
		</div>

		<div class="relative w-full flex-1 min-h-0">
			<canvas id="tpCostChart"></canvas>
		</div>

		@templ.JSONScript("tp-chart-data", chartDataJSON)

		<script>
			(function initTPChart() {
				if (window.tpCostChartInstance) { 
					window.tpCostChartInstance.destroy(); 
				}
				
				const canvas = document.getElementById('tpCostChart');
				if (!canvas) return;

				let rawDataStr = document.getElementById('tp-chart-data').textContent;
				let rawData = JSON.parse(rawDataStr);
				if (typeof rawData === 'string') { rawData = JSON.parse(rawData); }

				const datesSet = new Set();
				const datasetsMap = {}; 
				const totalsByDate = {}; 

				// Beautiful dynamic color palette generator
				const colorPalette = ['#286256', '#4AB8A1', '#A52022', '#F59E0B', '#3B82F6', '#8B5CF6', '#EC4899', '#10B981', '#6366F1', '#F43F5E'];
				let colorIdx = 0;

				rawData.forEach(d => {
					datesSet.add(d.date);
					let labelName = d.job_name;

					if (!datasetsMap[labelName]) {
						datasetsMap[labelName] = {
							type: 'bar',
							label: labelName,
							data: {},
							backgroundColor: colorPalette[colorIdx % colorPalette.length],
							borderWidth: 0,
							order: 2 
						};
						colorIdx++;
					}
					datasetsMap[labelName].data[d.date] = (datasetsMap[labelName].data[d.date] || 0) + d.cost;
					totalsByDate[d.date] = (totalsByDate[d.date] || 0) + d.cost;
				});

				const sortedDates = Array.from(datesSet).sort();
				
				const finalDatasets = Object.values(datasetsMap).map(ds => {
					const dataArr = sortedDates.map(date => ds.data[date] || 0);
					return { ...ds, data: dataArr };
				});

				finalDatasets.push({
					type: 'line',
					label: 'Total Cost Trend',
					data: sortedDates.map(date => totalsByDate[date] || 0),
					borderColor: '#374151', 
					borderWidth: 2,
					borderDash: [5, 5],
					fill: false,
					pointRadius: 2,
					pointBackgroundColor: '#374151',
					order: 1 
				});

				const ctx = canvas.getContext('2d');
				window.tpCostChartInstance = new Chart(ctx, {
					type: 'bar',
					data: {
						labels: sortedDates,
						datasets: finalDatasets
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						interaction: {
							mode: 'index',
							intersect: false,
						},
						plugins: { 
							legend: { 
								position: 'right', // Move legend to right so it doesn't crowd height
								labels: { usePointStyle: true, boxWidth: 8, font: {size: 10} }
							},
							tooltip: {
								callbacks: {
									label: function(context) {
										let label = context.dataset.label || '';
										if (label) { label += ': '; }
										if (context.parsed.y !== null) {
											label += new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(context.parsed.y);
										}
										return label;
									},
									footer: function(tooltipItems) {
										let sum = 0;
										let dataIndex = tooltipItems[0].dataIndex;
										
										tooltipItems.forEach(function(tooltipItem) {
											if (tooltipItem.dataset.type !== 'line') {
												sum += tooltipItem.parsed.y;
											}
										});

										let prevSum = 0;
										if (dataIndex > 0) {
											let prevDate = sortedDates[dataIndex - 1];
											prevSum = totalsByDate[prevDate] || 0;
										}

										let footerStr = 'Total: ' + new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(sum);
										
										if (dataIndex > 0 && prevSum > 0) {
											let delta = ((sum - prevSum) / prevSum) * 100;
											let sign = delta > 0 ? '▲' : (delta < 0 ? '▼' : '');
											footerStr += '\nPrev. Delta: ' + sign + ' ' + Math.abs(delta).toFixed(1) + '%';
										} else if (dataIndex > 0 && prevSum === 0 && sum > 0) {
											footerStr += '\nPrev. Delta: ▲ 100.0%';
										}
										
										return footerStr;
									}
								}
							}
						},
						scales: {
							x: { stacked: true, grid: { display: false } },
							y: {
								stacked: true,
								beginAtZero: true,
								grid: { color: '#f3f4f6', drawBorder: false },
								ticks: { callback: function(value) { return '$' + value; } }
							}
						}
					}
				});
			})();
		</script>
	</div>
}