
package admin

import (
	"fmt"
	"maoni/app/core/survey"
	"maoni/app/core/ui/icon"
)

templ categoriesModal(categories []survey.Category) {
	<div id="categories-modal" aria-labelledby="modal-title" role="dialog" aria-modal="true">
		<div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
		<div class="fixed inset-0 z-50 w-screen overflow-y-auto">
			<div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
				<div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg">
					@categoriesModalContent(categories)
				</div>
			</div>
		</div>
	</div>
}

templ categoriesModalContent(categories []survey.Category) {
	<div id="categories-modal-content" hx-target="this" hx-swap="outerHTML">
		<div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
			<div class="sm:flex sm:items-start">
				<div class="mt-3 w-full text-center sm:ml-4 sm:mt-0 sm:text-left">
					<h3 class="text-base font-semibold leading-6 text-gray-900" id="modal-title">Manage Categories</h3>
					<div class="mt-4">
						<ul role="list" class="divide-y divide-gray-200">
							if len(categories) == 0 {
								<li class="py-2 text-center text-sm text-gray-500">No categories created yet.</li>
							}
							for _, cat := range categories {
								<li class="flex items-center justify-between py-2">
									<span class="text-sm text-gray-800">{ cat.Name }</span>
									<button
										type="button"
										class="text-red-600 hover:text-red-800"
										hx-delete={ fmt.Sprintf("/admin/config/categories/%s", cat.ID) }
										hx-confirm="Are you sure you want to delete this category?"
									>
										@icon.Trash()
									</button>
								</li>
							}
						</ul>
					</div>
					<form
						class="mt-4 flex gap-2"
						hx-post="/admin/config/categories"
						hx-on:htmx:after-request="this.reset()"
					>
						<input type="text" name="name" placeholder="New category name" required class="block w-full rounded-md border-gray-300 shadow-sm focus:border-green-x-dark focus:ring-green-x-dark sm:text-sm"/>
						<button type="submit" class="rounded-md bg-green-x-light px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-x-dark">Add</button>
					</form>
				</div>
			</div>
		</div>
		<div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
			<button
				type="button"
				class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto"
				onclick="document.getElementById('categories-modal').remove()"
			>
				Close
			</button>
		</div>
	</div>
}
