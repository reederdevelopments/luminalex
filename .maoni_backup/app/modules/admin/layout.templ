
package admin

import "maoni/app/core/auth"

templ adminLayout(user auth.User, pageTitle string, children templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{"Maoni Admin - " + pageTitle}</title>
			<link rel="stylesheet" href="/assets/styles/main.css"/>
			<link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg"/>
			<script src="https://unpkg.com/htmx.org@1.9.12" integrity="sha384-ujb1lZYygJmzgSwoxRggbCHcjc0rB2XoQrxeTUQyRjrOnlCoYta87iKBWq3EsdM2" crossorigin="anonymous"></script>
		</head>
		<body class="h-full">
			<div class="min-h-full">
				<header class="header-background shadow-sm">
					<div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
						<div class="flex items-center justify-between">
							<div class="flex items-center gap-4">
								<a href="/admin" class="flex items-center gap-2 text-white">
									<img src="/assets/img/logo.webp" class="h-8 w-auto"/>
									<span class="text-lg font-semibold leading-6">Maoni Admin</span>
								</a>
							</div>
							<div class="flex items-center gap-4">
								<span class="hidden sm:inline text-sm text-gray-200">Hello, { user.FirstName }</span>
								<a href="/" class="text-sm font-medium text-white hover:text-gray-200">Back to Surveys</a>
								<a href="/logout" class="text-sm font-medium text-gray-200 hover:text-white">Logout</a>
							</div>
						</div>
					</div>
				</header>
				<main class="py-10">
					<div class="mx-auto max-w-7xl sm:px-6 lg:px-8">
						@children
					</div>
				</main>
			</div>
			<!-- This script is for the HTMX-based form, which seems to be the primary implementation -->
			<script src="/assets/scripts/survey_form.js" type="module"></script>
			<!-- This script is for the van.js based form. Only include it on pages that actually use it. -->
			<!-- <script src="/assets/scripts/admin_survey_form.js" type="module"></script> -->
		</body>
	</html>
}
